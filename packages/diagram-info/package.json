{
  "name": "@mermaid-js/diagram-info",
  "version": "13.0.0-alpha.1",
  "description": "Info diagram plugin for Mermaid: prints the version of mermaid, as SVG or text.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mermaid-js/mermaid-v13",
    "directory": "packages/diagram-info"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "mermaid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ascii": {
      "mermaid-source": "./src/ascii.ts",
      "types": "./dist/ascii.d.ts",
      "default": "./dist/ascii.js"
    },
    "./language": {
      "mermaid-source": "./src/language.ts",
      "types": "./dist/language.d.ts",
      "default": "./dist/language.js"
    },
    "./testing": {
      "mermaid-source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@mermaid-js/core": "workspace:*"
  },
  "devDependencies": {
    "@mermaid-js/core": "workspace:^"
  },
  "mermaid": {
    "plugin": "diagram",
    "id": "info",
    "types": [
      "info"
    ],
    "formats": [
      "svg",
      "ascii"
    ],
    "export": "info",
    "ascii": "./dist/ascii.js",
    "language": "./dist/language.js"
  }
}

(** Mindmap syntax (R-PARSE-9, D54): the normative grammar of `mindmap` diagrams.

The hand-written parser in `src/parser/` implements it; `tools/gen-grammar` builds a reference
parser, a sentence generator, highlighters and the syntax reference page from it. mermaid@12
decides what is valid, this file is fixed to match, and the parser must match this file
(DESIGN §4.4).

**Lexer input.** The lexer reads the diagram body as mermaid@12 handed it to its lexer: front
matter and `%%{…}%%` directives removed; CRLF and CR read as LF; `="x"` inside an HTML tag read
as `='x'`; `%%` comment lines removed and leading blanks trimmed; on a line with
`style…:…#…;` (or `classDef…`) the last `;` dropped; `#name;` / `#123;` entities read as
opaque text that no rule takes apart; and a line break appended. Keywords are matched without
regard to case.

A node's parent is the nearest node above it with less indent; the first node is the root, and
a later node with no parent is an error. A `:::class` or `::icon(…)` line decorates the last
node written before it. A blank or comment line counts as a statement where one may start, so a
node right after two of them in a row, or one right after `mindmap`, is an error, as in
mermaid@12. *)

@lexer

@options case-insensitive ;

@modes class icon node nstr nstr2 ;

(** A `%%` comment v12's comment removal left (after text on a line, or a bare `%%`), with the
blanks and line breaks before it: a blank line. *)
SPACELINE                 /\s*%%.*/                        :comment ;
(** `mindmap`: starts a mindmap; the nodes follow, one per line. *)
MINDMAP                   /mindmap\b/                      :keyword ;
(** `:::class …`: the classes of the last node, the rest of the line. *)
-                         /:::/                            push(class) :operator ;
<class> CLASS             /.+/                             pop :variable ;
<class> -                 /\n/                             pop ;
(** `::icon(…)`: the icon of the last node, up to `)`. *)
-                         /::icon\(/                       push(icon) :keyword ;
(** Blanks up to the last line break of their run: a blank line. *)
SPACELINE                 /[\s]+[\n]/ ;
NL                        /[\n]+/ ;
<icon> ICON               /[^\)]+/                         :string ;
<icon> -                  /\)/                             pop :punctuation ;

(** A shape opener: `[` square, `(` rounded (cloud unless closed by `)`), `((` circle, `)`
cloud, `))` bang, `{{` hexagon; `-)` and `(-` give the default shape. *)
NODE_DSTART               /-\)/                            push(node) :punctuation ;
NODE_DSTART               /\(-/                            push(node) :punctuation ;
NODE_DSTART               /\)\)/                           push(node) :punctuation ;
NODE_DSTART               /\)/                             push(node) :punctuation ;
NODE_DSTART               /\(\(/                           push(node) :punctuation ;
NODE_DSTART               /\{\{/                           push(node) :punctuation ;
NODE_DSTART               /\(/                             push(node) :punctuation ;
NODE_DSTART               /\[/                             push(node) :punctuation ;
(** The indent before a node: its width sets the nesting. *)
SPACELIST                 /[\s]+/ ;
(** A node id, which may hold blanks: the text up to a shape opener or the line end. *)
NODE_ID                   /[^\(\[\n\)\{\}]+/               :variable ;
(** The end of the text. *)
EOF                       /$/ ;

(* The tag rule in a string stays linear for the highlighters: a tag name ends at a word
boundary, a tag holds no `<`, and each character of it has one reading (`=` before `"` opens a
value). *)
(** Strings in a shape: `"…"` and markdown strings `` "`…`" ``. The text of either may hold a
tag with `="x"` attributes (`<span style="color:red">`), which the lexer reads as `='x'`
(#837). *)
<node> -                  /["][`]/                       push(nstr2) attach-next :string ;
<nstr2> NODE_DESCR        /(?:<\w+\b(?:[^<>"`=]|=(?!")|="[^<>"`]*")*>|[^`"])+/ :string ;
<nstr2> -                 /[`]["]/                         pop attach-prev :string ;
<node> -                  /["]/                            push(nstr) attach-next :string ;
<nstr> NODE_DESCR         /(?:<\w+\b(?:[^<>"=]|=(?!")|="[^<>"]*")*>|[^"])+/ :string ;
<nstr> -                  /["]/                            pop attach-prev :string ;
(** A shape closer: any of them closes any shape. *)
<node> NODE_DEND          /[\)]\)/                         pop :punctuation ;
<node> NODE_DEND          /[\)]/                           pop :punctuation ;
<node> NODE_DEND          /[\]]/                           pop :punctuation ;
<node> NODE_DEND          /\}\}/                           pop :punctuation ;
<node> NODE_DEND          /\(-/                            pop :punctuation ;
<node> NODE_DEND          /-\)/                            pop :punctuation ;
<node> NODE_DEND          /\(\(/                           pop :punctuation ;
<node> NODE_DEND          /\(/                             pop :punctuation ;
(** A node's text: up to a closer, over line breaks; a `}` takes the rest of its line. *)
<node> NODE_DESCR         /[^\)\]\(\}]+/                   :string ;
<node> NODE_DESCR         /.+(?!\(\()/                     :string ;

@trivia

(** Removed before lexing (see the lexer input); listed for the highlighters. A comment is a
whole line; both take their leading blanks. *)
COMMENT                   /^[^\S\n]*%%(?!\{)[^\n]+/         :comment ;
(** From `%%{` to the first `}%%`, over line breaks (core preprocess). *)
DIRECTIVE                 /[^\S\n]*%%\{[\s\S]*?\}%%/        :meta ;

@grammar

(** A mindmap is `mindmap`, then its statements, each followed by a line break, a blank line
or the end. Blank and comment lines may come before `mindmap`. *)
diagram = [ SPACELINE { SPACELINE | NL } ] MINDMAP [ NL ] statement stop { statement stop } ;
stop = ( NL | EOF | SPACELINE ) { NL | EOF } ;

statement = SPACELIST [ Node | Icon | Class ]
  | SPACELINE
  | Node
  | Icon
  | Class ;

(** A node: an id, a shape with its text, or both (`root`, `id[text]`, `((text))`). Its indent
is the `SPACELIST` before it. *)
Node @Node = NODE_ID [ shape ] | shape ;
shape = NODE_DSTART NODE_DESCR NODE_DEND ;
(** `::icon(…)`: the icon of the last node, on a line of its own. *)
Icon = ICON ;
(** `:::class …`: the classes of the last node, on a line of its own; a later one replaces them. *)
Class = CLASS ;

{
  "name": "@mermaid-js/diagram-mindmap",
  "version": "0.0.0",
  "private": true,
  "description": "Mindmap diagram plugin for Mermaid: lexer, model and layout (parser and renderer to follow).",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    "./testing": {
      "mermaid-source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    ".": {
      "mermaid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@mermaid-js/core": "workspace:*"
  },
  "devDependencies": {
    "@mermaid-js/core": "workspace:^"
  }
}

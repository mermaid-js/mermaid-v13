{
  "tokenPostfix": ".mermaid-packet",
  "defaultToken": "",
  "includeLF": true,
  "start": "frontMatterStart",
  "tokenizer": {
    "spanTrivia1": [
      [
        "\\}%%",
        {
          "token": "annotation",
          "next": "@pop"
        }
      ],
      [
        "(?:(?!\\}%%)[\\s\\S])+",
        {
          "token": "annotation"
        }
      ]
    ],
    "spanRule7": [
      [
        "\\}",
        {
          "token": "keyword",
          "next": "@pop"
        }
      ],
      [
        "(?:(?!\\})[\\s\\S])+",
        {
          "token": "keyword"
        }
      ]
    ],
    "root": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{",
        {
          "token": "annotation",
          "next": "@spanTrivia1"
        }
      ],
      [
        "packet-beta",
        {
          "token": "keyword"
        }
      ],
      [
        "packet(?:(?=%%)|(?!\\S))",
        {
          "token": "keyword"
        }
      ],
      [
        "---[\\t ]*\\r?\\n(?:[\\S\\s]*?\\r?\\n)?---(?:\\r?\\n|(?!\\S))",
        {
          "token": "annotation"
        }
      ],
      [
        "-",
        {
          "token": "delimiter"
        }
      ],
      [
        "\\+",
        {
          "token": "delimiter"
        }
      ],
      [
        ":",
        {
          "token": "delimiter"
        }
      ],
      [
        "[\\t ]*accDescr[\\t ]*:(?:[^\\n\\r]*?(?=%%)|[^\\n\\r]*)",
        {
          "token": "keyword"
        }
      ],
      [
        "[\\t ]*accDescr\\s*\\{",
        {
          "token": "keyword",
          "next": "@spanRule7"
        }
      ],
      [
        "[\\t ]*accTitle[\\t ]*:(?:[^\\n\\r]*?(?=%%)|[^\\n\\r]*)",
        {
          "token": "keyword"
        }
      ],
      [
        "[\\t ]*title(?:[\\t ][^\\n\\r]*?(?=%%)|[\\t ][^\\n\\r]*|)",
        {
          "token": "keyword"
        }
      ],
      [
        "0|[1-9][0-9]*(?!\\.)",
        {
          "token": "number"
        }
      ],
      [
        "\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'",
        {
          "token": "string"
        }
      ],
      [
        "\\r?\\n",
        {
          "token": ""
        }
      ],
      [
        "[\\t ]+",
        {
          "token": ""
        }
      ],
      [
        "[\\t ]*%%\\{[\\S\\s]*?\\}%%(?:\\r?\\n|(?!\\S))",
        {
          "token": "annotation"
        }
      ],
      [
        "[\\t ]*%%[^\\n\\r]*",
        {
          "token": "comment"
        }
      ]
    ],
    "frontMatterStart": [
      [
        "^[^\\S\\n]*---[^\\S\\n]*(?:\\n|$)",
        {
          "token": "annotation",
          "switchTo": "@frontMatter"
        }
      ],
      [
        "[^\\S\\n]*(?:\\n|$)",
        {
          "token": ""
        }
      ],
      [
        "",
        {
          "token": "",
          "switchTo": "@root"
        }
      ]
    ],
    "frontMatter": [
      [
        "^[^\\S\\n]*---[^\\S\\n]*(?:\\n|$)",
        {
          "token": "annotation",
          "switchTo": "@root"
        }
      ],
      [
        "[^\\S\\n]*#.*",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*(?:- )?[^\\s#:'\"-][^:#\\n]*(?=:(?:\\s|$))",
        {
          "token": "variable"
        }
      ],
      [
        "[^#]+",
        {
          "token": ""
        }
      ]
    ]
  }
}

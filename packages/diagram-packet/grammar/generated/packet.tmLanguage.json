{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "mermaid-packet",
  "scopeName": "source.mermaid-packet",
  "fileTypes": [
    "mmd",
    "mermaid"
  ],
  "patterns": [
    {
      "include": "#front-matter-start"
    },
    {
      "include": "#mode-INITIAL"
    }
  ],
  "repository": {
    "trivia-0": {
      "match": "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
      "name": "comment.line.mermaid-packet"
    },
    "trivia-1": {
      "begin": "[^\\S\\n]*%%\\{",
      "end": "\\}%%",
      "name": "meta.embedded.mermaid-packet"
    },
    "rule-0": {
      "match": "packet-beta",
      "name": "keyword.control.mermaid-packet"
    },
    "rule-1": {
      "match": "packet(?:(?=%%)|(?!\\S))",
      "name": "keyword.control.mermaid-packet"
    },
    "rule-2": {
      "match": "---[\\t ]*\\r?\\n(?:[\\S\\s]*?\\r?\\n)?---(?:\\r?\\n|(?!\\S))",
      "name": "meta.embedded.mermaid-packet"
    },
    "rule-3": {
      "match": "-",
      "name": "punctuation.definition.mermaid-packet"
    },
    "rule-4": {
      "match": "\\+",
      "name": "punctuation.definition.mermaid-packet"
    },
    "rule-5": {
      "match": ":",
      "name": "punctuation.definition.mermaid-packet"
    },
    "rule-6": {
      "match": "[\\t ]*accDescr[\\t ]*:(?:[^\\n\\r]*?(?=%%)|[^\\n\\r]*)",
      "name": "keyword.control.mermaid-packet"
    },
    "rule-7": {
      "begin": "[\\t ]*accDescr\\s*\\{",
      "end": "\\}",
      "name": "keyword.control.mermaid-packet"
    },
    "rule-8": {
      "match": "[\\t ]*accTitle[\\t ]*:(?:[^\\n\\r]*?(?=%%)|[^\\n\\r]*)",
      "name": "keyword.control.mermaid-packet"
    },
    "rule-9": {
      "match": "[\\t ]*title(?:[\\t ][^\\n\\r]*?(?=%%)|[\\t ][^\\n\\r]*|)",
      "name": "keyword.control.mermaid-packet"
    },
    "rule-10": {
      "match": "0|[1-9][0-9]*(?!\\.)",
      "name": "constant.numeric.mermaid-packet"
    },
    "rule-11": {
      "match": "\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'",
      "name": "string.quoted.mermaid-packet"
    },
    "rule-12": {
      "match": "\\r?\\n"
    },
    "rule-13": {
      "match": "[\\t ]+"
    },
    "rule-14": {
      "match": "[\\t ]*%%\\{[\\S\\s]*?\\}%%(?:\\r?\\n|(?!\\S))",
      "name": "meta.embedded.mermaid-packet"
    },
    "rule-15": {
      "match": "[\\t ]*%%[^\\n\\r]*",
      "name": "comment.line.mermaid-packet"
    },
    "mode-INITIAL": {
      "patterns": [
        {
          "include": "#trivia-0"
        },
        {
          "include": "#trivia-1"
        },
        {
          "include": "#rule-0"
        },
        {
          "include": "#rule-1"
        },
        {
          "include": "#rule-2"
        },
        {
          "include": "#rule-3"
        },
        {
          "include": "#rule-4"
        },
        {
          "include": "#rule-5"
        },
        {
          "include": "#rule-6"
        },
        {
          "include": "#rule-7"
        },
        {
          "include": "#rule-8"
        },
        {
          "include": "#rule-9"
        },
        {
          "include": "#rule-10"
        },
        {
          "include": "#rule-11"
        },
        {
          "include": "#rule-12"
        },
        {
          "include": "#rule-13"
        },
        {
          "include": "#rule-14"
        },
        {
          "include": "#rule-15"
        }
      ]
    },
    "front-matter-start": {
      "begin": "\\A(?=[^\\S\\n]*(?:---[^\\S\\n]*)?$)",
      "end": "(?=\\S)",
      "applyEndPatternLast": 1,
      "patterns": [
        {
          "include": "#front-matter"
        }
      ]
    },
    "front-matter": {
      "begin": "^[^\\S\\n]*---[^\\S\\n]*$",
      "beginCaptures": {
        "0": {
          "name": "meta.embedded.mermaid-packet"
        }
      },
      "end": "(?!)",
      "patterns": [
        {
          "include": "#front-matter-body"
        },
        {
          "match": "#.*",
          "name": "comment.line.mermaid-packet"
        },
        {
          "match": "^[^\\S\\n]*(?:- )?[^\\s#:'\"-][^:#\\n]*(?=:(?:\\s|$))",
          "name": "variable.other.mermaid-packet"
        }
      ]
    },
    "front-matter-body": {
      "begin": "^[^\\S\\n]*---[^\\S\\n]*$",
      "beginCaptures": {
        "0": {
          "name": "meta.embedded.mermaid-packet"
        }
      },
      "end": "(?!)",
      "patterns": [
        {
          "include": "#mode-INITIAL"
        }
      ]
    }
  }
}

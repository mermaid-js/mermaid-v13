(** Block diagram syntax (R-PARSE-9, D54): the normative grammar of `block-beta` and `block`
diagrams.

The hand-written parser in `src/parser/` implements it; `tools/gen-grammar` builds a reference
parser, a sentence generator, highlighters and the syntax reference page from it. mermaid@12
decides what is valid, this file is fixed to match, and the parser must match this file
(DESIGN §4.4).

**Lexer input.** The lexer reads the diagram body as mermaid@12 handed it to its lexer: front
matter and `%%{…}%%` directives removed; CRLF and CR read as LF; `="x"` inside an HTML tag read
as `='x'`; `%%` comment lines removed and leading blanks trimmed; on a line with
`style…:…#…;` (or `classDef…`) the last `;` dropped; `#name;` / `#123;` entities read as
opaque text that no rule takes apart; and a line break appended. Keywords are case-sensitive.

**Line breaks mean nothing.** Blanks and line breaks only separate tokens, so statements need
no separator: `columns 2 a b` on one line is a `columns` statement and two blocks. An id takes
any character but blanks, `( ) [ ] { } < > - : =`, so `;`, `,`, `.`, `|`, `%`, `#`, quotes and
Unicode are id characters, and an inline `%%` is not a comment. Labels are always quoted.

A block written again merges into the first (its position and span stay). A composite
`block:id … end` or `block … end` holds at least one statement. A span `:n` goes only after the
first block of a statement or a composite header. *)

@lexer

@modes string md_string NODE BLOCK_ARROW ARROW_DIR LLABEL CLASSDEF CLASSDEFID CLASS CLASS_STYLE
  STYLE_STMNT STYLE_DEFINITION acc_title acc_descr acc_descr_multiline ;

(** `block-beta` or `block`: starts a block diagram; inside one, `block … end` is a composite
without an id. *)
BLOCK_DIAGRAM_KEY            /block-beta\b/                  :keyword ;
(** `block:id … end`: a composite, a block holding blocks on its own column grid. The id may
take a label and a span, as in `block:g["Group"]:2`. *)
id-block                     /block:/                        :keyword ;
BLOCK_DIAGRAM_KEY            /block\b/                       :keyword ;
(** Blanks and line breaks separate tokens. *)
-                            /[\s]+/ ;
(** `columns n` or `columns auto`: how many columns the level's grid has; the last one wins. *)
COLUMNS                      /columns\s+auto\b/              :keyword ;
COLUMNS                      /columns\s+[\d]+/               :keyword ;
(** A markdown string, which block diagrams do not take. *)
-                            /["][`]/                        push(md_string) :string ;
<md_string> MD_STR           /[^`"]+/                        :string ;
<md_string> -                /[`]["]/                        pop :string ;
(** A quoted text: a label, in a shape or an edge. *)
-                            /["]/                           push(string) :string ;
<string> -                   /["]/                           pop :string ;
<string> STR                 /[^"]*/                         :string ;
(** `space` or `space:n`: n empty cells of the grid. *)
SPACE_BLOCK                  /space[:]\d+/                   :keyword ;
SPACE_BLOCK                  /space\b/                       :keyword ;
(** Reserved; no statement starts with it. *)
DEFAULT                      /default\b/                     :keyword ;
(** Reserved; block diagrams have no `linkStyle`. *)
LINKSTYLE                    /linkStyle\b/                   :keyword ;
(** Reserved. *)
INTERPOLATE                  /interpolate\b/                 :keyword ;

(** `classDef name styles`: a class of CSS styles, as `classDef hot fill:#f96,stroke:#333`. *)
classDef                     /classDef\s+/                   push(CLASSDEF) :keyword ;
<CLASSDEF> DEFAULT_CLASSDEF_ID /DEFAULT\s+/                  pop push(CLASSDEFID) :variable ;
<CLASSDEF> CLASSDEF_ID       /\w+\s+/                        pop push(CLASSDEFID) :variable ;
<CLASSDEFID> CLASSDEF_STYLEOPTS /[^\n]*/                     pop :string ;
(** `class a, b name`: gives the blocks a class. *)
class                        /class\s+/                      push(CLASS) :keyword ;
<CLASS> CLASSENTITY_IDS      /\w+(?:,\s*\w+)*/               pop push(CLASS_STYLE) :variable ;
<CLASS_STYLE> STYLECLASS     /[^\n]*/                        pop :variable ;
(** `style a, b styles`: CSS styles for the blocks, applied after every statement. *)
style                        /style\s+/                      push(STYLE_STMNT) :keyword ;
<STYLE_STMNT> STYLE_ENTITY_IDS /\w+(?:,\s*\w+)*/             pop push(STYLE_DEFINITION) :variable ;
<STYLE_DEFINITION> STYLE_DEFINITION_DATA /[^\n]*/            pop :string ;
(** Block diagrams have no `accTitle`; no statement takes it. *)
acc_title                    /accTitle\s*:\s*/               push(acc_title) :keyword ;
<acc_title> acc_title_value  /[^\n]*/                        pop :string ;
(** Block diagrams have no `accDescr`; no statement takes it. *)
acc_descr                    /accDescr\s*:\s*/               push(acc_descr) :keyword ;
<acc_descr> acc_descr_value  /[^\n]*/                        pop :string ;
-                            /accDescr\s*\{\s*/              push(acc_descr_multiline) :keyword ;
<acc_descr_multiline> -      /[\}]/                          pop :keyword ;
<acc_descr_multiline> acc_descr_multiline_value /[^\}]*/     :string ;
(** `end`: closes the innermost composite. *)
end                          /end\b\s*/                      :keyword ;

(** A shape closer; any closer closes any opener, and a pair v12 knows sets the shape. *)
<NODE> NODE_DEND             /\(\(\(/                        pop :punctuation ;
<NODE> NODE_DEND             /\)\)\)/                        pop :punctuation ;
<NODE> NODE_DEND             /[\)]\)/                        pop :punctuation ;
<NODE> NODE_DEND             /\}\}/                          pop :punctuation ;
<NODE> NODE_DEND             /\}/                            pop :punctuation ;
<NODE> NODE_DEND             /\(-/                           pop :punctuation ;
<NODE> NODE_DEND             /-\)/                           pop :punctuation ;
<NODE> NODE_DEND             /\(\(/                          pop :punctuation ;
<NODE> NODE_DEND             /\]\]/                          pop :punctuation ;
<NODE> NODE_DEND             /\(/                            pop :punctuation ;
<NODE> NODE_DEND             /\]\)/                          pop :punctuation ;
<NODE> NODE_DEND             /\\\]/                          pop :punctuation ;
<NODE> NODE_DEND             /\/\]/                          pop :punctuation ;
<NODE> NODE_DEND             /\)\]/                          pop :punctuation ;
<NODE> NODE_DEND             /[\)]/                          pop :punctuation ;
<NODE> NODE_DEND             /\]>/                           pop :punctuation ;
<NODE> NODE_DEND             /[\]]/                          pop :punctuation ;

(** A shape opener, right after a block id: `[` square, `(` round, `((` circle, `(((` double
circle, `([` stadium, `[[` subroutine, `[(` cylinder, `{` diamond, `{{` hexagon, `>` odd,
`[/` and `[\` lean and trapezoid shapes. *)
(* jison's `)))` after `))` and its second `[\` can never match; they are left out. *)
NODE_DSTART                  /-\)/                           push(NODE) :punctuation ;
NODE_DSTART                  /\(-/                           push(NODE) :punctuation ;
NODE_DSTART                  /\)\)/                          push(NODE) :punctuation ;
NODE_DSTART                  /\)/                            push(NODE) :punctuation ;
NODE_DSTART                  /\(\(\(/                        push(NODE) :punctuation ;
NODE_DSTART                  /\(\(/                          push(NODE) :punctuation ;
NODE_DSTART                  /\{\{/                          push(NODE) :punctuation ;
NODE_DSTART                  /\{/                            push(NODE) :punctuation ;
NODE_DSTART                  />/                             push(NODE) :punctuation ;
NODE_DSTART                  /\(\[/                          push(NODE) :punctuation ;
NODE_DSTART                  /\(/                            push(NODE) :punctuation ;
NODE_DSTART                  /\[\[/                          push(NODE) :punctuation ;
NODE_DSTART                  /\[\|/                          push(NODE) :punctuation ;
NODE_DSTART                  /\[\(/                          push(NODE) :punctuation ;
NODE_DSTART                  /\[\\/                          push(NODE) :punctuation ;
NODE_DSTART                  /\[\//                          push(NODE) :punctuation ;
NODE_DSTART                  /\[/                            push(NODE) :punctuation ;

(** `<["text"]>(right, up)`: a block arrow, pointing in the listed directions. *)
BLOCK_ARROW_START            /<\[/                           push(BLOCK_ARROW) :punctuation ;

(** A block id. *)
NODE_ID                      /[^\(\[\n\-\)\{\}\s\<\>:=]+/    :variable ;
(** The end of the text. *)
EOF                          /$/ ;

<BLOCK_ARROW> -              /["][`]/                        push(md_string) :string ;
<NODE> -                     /["][`]/                        push(md_string) :string ;
<NODE> -                     /["]/                           push(string) :string ;
<BLOCK_ARROW> -              /["]/                           push(string) :string ;
(* `]>(` leaves the block arrow for its directions (jison pushes, then pops twice at `)`; one
swap and one pop read the same and the highlighters follow them). *)
<BLOCK_ARROW> -              /\]>\s*\(/                      pop push(ARROW_DIR) :punctuation ;
(** A block arrow's direction: `right`, `left`, `up`, `down`, `x` (both sides) or `y` (top and
bottom), separated by commas. *)
<ARROW_DIR> DIR              /,?\s*right\s*/                 :keyword ;
<ARROW_DIR> DIR              /,?\s*left\s*/                  :keyword ;
<ARROW_DIR> DIR              /,?\s*x\s*/                     :keyword ;
<ARROW_DIR> DIR              /,?\s*y\s*/                     :keyword ;
<ARROW_DIR> DIR              /,?\s*up\s*/                    :keyword ;
<ARROW_DIR> DIR              /,?\s*down\s*/                  :keyword ;
<ARROW_DIR> BLOCK_ARROW_END  /\)\s*/                         pop :punctuation ;

(** An edge: `-->`, `---`, `--x`, `--o`, `<-->`, `==>` (thick), `-.->` (dotted) and their
kin, with any number of dashes or equals signs. *)
(* jison's `~~~` rule can never match: the id rule takes `~` first. *)
LINK                         /\s*[xo<]?--+[-xo>]\s*/         :operator ;
LINK                         /\s*[xo<]?==+[=xo>]\s*/         :operator ;
LINK                         /\s*[xo<]?-?\.+-[xo>]?\s*/      :operator ;
(** The start of a labelled edge, as `a -- "text" --> b`. *)
START_LINK                   /\s*[xo<]?--\s*/                push(LLABEL) :operator ;
START_LINK                   /\s*[xo<]?==\s*/                push(LLABEL) :operator ;
START_LINK                   /\s*[xo<]?-\.\s*/               push(LLABEL) :operator ;
<LLABEL> -                   /["][`]/                        push(md_string) :string ;
<LLABEL> LINK_LABEL          /["]/                           push(string) :string ;
<LLABEL> LINK                /\s*[xo<]?--+[-xo>]\s*/         pop :operator ;
<LLABEL> LINK                /\s*[xo<]?==+[=xo>]\s*/         pop :operator ;
<LLABEL> LINK                /\s*[xo<]?-?\.+-[xo>]?\s*/      pop :operator ;
(** `:n` after a block: it spans n columns. *)
SIZE                         /:\d+/                          :number ;

@trivia

(** Removed before lexing (see the lexer input); listed for the highlighters. A comment is a
whole line; both take their leading blanks. *)
COMMENT                      /^[^\S\n]*%%(?!\{)[^\n]+/       :comment ;
(** From `%%{` to the first `}%%`, over line breaks (core preprocess). *)
DIRECTIVE                    /[^\S\n]*%%\{[\s\S]*?\}%%/      :meta ;

@grammar

(** A block diagram is `block-beta` or `block`, then at least one statement. *)
diagram = BLOCK_DIAGRAM_KEY statement { statement } EOF ;

statement = nodeStatement | Columns | Space | Composite | ClassDef | Class | Style ;

(** Blocks joined by edges: `a`, `a["text"]:2`, `a --> b -- "label" --> c`. *)
nodeStatement = Sized { Edge Block } ;
Sized @Block = node [ SIZE ] ;
Block @Block = node ;
node = NODE_ID [ shape ] ;
shape = NODE_DSTART STR NODE_DEND | BLOCK_ARROW_START STR DIR { DIR } BLOCK_ARROW_END ;
Edge @Edge = link ;
link = LINK | START_LINK LINK_LABEL STR LINK ;

Columns @Columns = COLUMNS ;
Space @Space = SPACE_BLOCK ;
(** `block:id … end` (the header may take a label, a span and edges) or `block … end`. *)
Composite @Composite = id-block node [ SIZE ] { HeaderEdge HeaderBlock } statement { statement } end
  | BLOCK_DIAGRAM_KEY statement { statement } end ;
(* The rest of a header chain, `block:a --> b`: the composite is `a`, and the edge and `b` stand
at the level around it. *)
HeaderEdge @HeaderEdge = link ;
HeaderBlock @HeaderBlock = node ;

ClassDef @ClassDef = classDef CLASSDEF_ID CLASSDEF_STYLEOPTS ;
Class @Class = class CLASSENTITY_IDS STYLECLASS ;
Style @Style = style STYLE_ENTITY_IDS STYLE_DEFINITION_DATA ;

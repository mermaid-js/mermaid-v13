{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "mermaid-pie",
  "scopeName": "source.mermaid-pie",
  "fileTypes": [
    "mmd",
    "mermaid"
  ],
  "patterns": [
    {
      "include": "#front-matter-start"
    },
    {
      "include": "#mode-INITIAL"
    }
  ],
  "repository": {
    "trivia-0": {
      "match": "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
      "name": "comment.line.mermaid-pie"
    },
    "trivia-1": {
      "begin": "[^\\S\\n]*%%\\{",
      "end": "\\}%%",
      "name": "meta.embedded.mermaid-pie"
    },
    "rule-0": {
      "match": "showData(?:(?=%%)|(?!\\S))",
      "name": "keyword.control.mermaid-pie"
    },
    "rule-1": {
      "match": "pie(?:(?=%%)|(?!\\S))",
      "name": "keyword.control.mermaid-pie"
    },
    "rule-2": {
      "match": ":",
      "name": "punctuation.definition.mermaid-pie"
    },
    "rule-3": {
      "match": "-?[0-9]+\\.[0-9]+(?!\\.)|-?(?:0|[1-9][0-9]*)(?!\\.)",
      "name": "constant.numeric.mermaid-pie"
    },
    "rule-4": {
      "match": "[\\t ]*accDescr[\\t ]*:(?:[^\\n\\r]*?(?=%%)|[^\\n\\r]*)",
      "name": "keyword.control.mermaid-pie"
    },
    "rule-5": {
      "begin": "[\\t ]*accDescr\\s*\\{",
      "end": "\\}",
      "name": "keyword.control.mermaid-pie"
    },
    "rule-6": {
      "match": "[\\t ]*accTitle[\\t ]*:(?:[^\\n\\r]*?(?=%%)|[^\\n\\r]*)",
      "name": "keyword.control.mermaid-pie"
    },
    "rule-7": {
      "match": "[\\t ]*title(?:[\\t ][^\\n\\r]*?(?=%%)|[\\t ][^\\n\\r]*|)",
      "name": "keyword.control.mermaid-pie"
    },
    "rule-8": {
      "match": "\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'",
      "name": "string.quoted.mermaid-pie"
    },
    "rule-9": {
      "match": "\\r?\\n"
    },
    "rule-10": {
      "match": "[\\t ]+"
    },
    "rule-11": {
      "match": "---[\\t ]*\\r?\\n(?:[\\S\\s]*?\\r?\\n)?---(?:\\r?\\n|(?!\\S))",
      "name": "meta.embedded.mermaid-pie"
    },
    "rule-12": {
      "match": "[\\t ]*%%\\{[\\S\\s]*?\\}%%(?:\\r?\\n|(?!\\S))",
      "name": "meta.embedded.mermaid-pie"
    },
    "rule-13": {
      "match": "[\\t ]*%%[^\\n\\r]*",
      "name": "comment.line.mermaid-pie"
    },
    "mode-INITIAL": {
      "patterns": [
        {
          "include": "#trivia-0"
        },
        {
          "include": "#trivia-1"
        },
        {
          "include": "#rule-0"
        },
        {
          "include": "#rule-1"
        },
        {
          "include": "#rule-2"
        },
        {
          "include": "#rule-3"
        },
        {
          "include": "#rule-4"
        },
        {
          "include": "#rule-5"
        },
        {
          "include": "#rule-6"
        },
        {
          "include": "#rule-7"
        },
        {
          "include": "#rule-8"
        },
        {
          "include": "#rule-9"
        },
        {
          "include": "#rule-10"
        },
        {
          "include": "#rule-11"
        },
        {
          "include": "#rule-12"
        },
        {
          "include": "#rule-13"
        }
      ]
    },
    "front-matter-start": {
      "begin": "\\A(?=[^\\S\\n]*(?:---[^\\S\\n]*)?$)",
      "end": "(?=\\S)",
      "applyEndPatternLast": 1,
      "patterns": [
        {
          "include": "#front-matter"
        }
      ]
    },
    "front-matter": {
      "begin": "^[^\\S\\n]*---[^\\S\\n]*$",
      "beginCaptures": {
        "0": {
          "name": "meta.embedded.mermaid-pie"
        }
      },
      "end": "(?!)",
      "patterns": [
        {
          "include": "#front-matter-body"
        },
        {
          "match": "#.*",
          "name": "comment.line.mermaid-pie"
        },
        {
          "match": "^[^\\S\\n]*(?:- )?[^\\s#:'\"-][^:#\\n]*(?=:(?:\\s|$))",
          "name": "variable.other.mermaid-pie"
        }
      ]
    },
    "front-matter-body": {
      "begin": "^[^\\S\\n]*---[^\\S\\n]*$",
      "beginCaptures": {
        "0": {
          "name": "meta.embedded.mermaid-pie"
        }
      },
      "end": "(?!)",
      "patterns": [
        {
          "include": "#mode-INITIAL"
        }
      ]
    }
  }
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "mermaid-quadrant",
  "scopeName": "source.mermaid-quadrant",
  "fileTypes": [
    "mmd",
    "mermaid"
  ],
  "patterns": [
    {
      "include": "#front-matter-start"
    },
    {
      "include": "#mode-INITIAL"
    }
  ],
  "repository": {
    "trivia-0": {
      "match": "(?i)^[^\\S\\n]*%%(?!\\{)[^\\n]+",
      "name": "comment.line.mermaid-quadrant"
    },
    "trivia-1": {
      "begin": "(?i)[^\\S\\n]*%%\\{",
      "end": "(?i)\\}%%",
      "name": "meta.embedded.mermaid-quadrant"
    },
    "rule-0": {
      "match": "(?i)%%(?!\\{)[^\\n]*",
      "name": "comment.line.mermaid-quadrant"
    },
    "rule-1": {
      "match": "(?i)[^}]%%[^\\n]*",
      "name": "comment.line.mermaid-quadrant"
    },
    "rule-2": {
      "match": "(?i)[\\n\\r]+"
    },
    "rule-3": {
      "match": "(?i)%%[^\\n]*",
      "name": "comment.line.mermaid-quadrant"
    },
    "rule-4": {
      "begin": "(?i)title\\b",
      "end": "((?i)[^\\n]*)",
      "patterns": [
        {
          "include": "#mode-title"
        }
      ],
      "beginCaptures": {
        "0": {
          "name": "keyword.control.mermaid-quadrant"
        }
      },
      "endCaptures": {
        "1": {
          "name": "string.quoted.mermaid-quadrant"
        }
      }
    },
    "rule-6": {
      "begin": "(?i)accTitle\\s*:\\s*",
      "end": "((?i)[^\\n]*)",
      "patterns": [
        {
          "include": "#mode-acc_title"
        }

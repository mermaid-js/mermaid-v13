          "include": "#mode-class_name"
        }
      ],
      "beginCaptures": {
        "0": {
          "name": "keyword.operator.mermaid-quadrant"
        }
      },
      "endCaptures": {
        "1": {
          "name": "variable.other.mermaid-quadrant"
        }
      }
    },
    "rule-29": {
      "begin": "(?i)\\s*:\\s*\\[\\s*",
      "end": "((?i)\\s*\\][ ]*)",
      "patterns": [
        {
          "include": "#mode-point_start"
        }
      ],
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.mermaid-quadrant"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.mermaid-quadrant"
        }
      }
    },
    "rule-34": {
      "match": "(?i)[ ]*quadrantChart[ ]*",
      "name": "keyword.control.mermaid-quadrant"
    },
    "rule-35": {
      "match": "(?i)[A-Za-z]+"
    },
    "rule-36": {
      "match": "(?i)[^\\x00-\\x7F]+"
    },
    "rule-37": {
      "match": "(?i):"
    },
    "rule-38": {
      "match": "(?i)\\+"
    },
    "rule-39": {
      "match": "(?i),"
    },
    "rule-40": {
      "match": "(?i)="
    },
    "rule-41": {
      "match": "(?i)\\*"
    },
    "rule-42": {
      "match": "(?i)#"
    },
    "rule-43": {
      "match": "(?i)_"
    },
    "rule-44": {
      "match": "(?i)\\."
    },
    "rule-45": {
      "match": "(?i)&"
    },
    "rule-46": {
      "match": "(?i)-"
    },
    "rule-47": {
      "match": "(?i)[0-9]+"
    },
    "rule-48": {
      "match": "(?i)\\s"
    },
    "rule-49": {
      "match": "(?i);"
    },
    "rule-50": {
      "match": "(?i)[!\"#$%&'*+,\\-.`?\\\\_\\/]"

    "phase-point_x": {
      "begin": "\\G(?!(?!(?i)^[^\\S\\n]*%%(?!\\{)[^\\n]+|(?i)[^\\S\\n]*%%\\{)(?=(?i)\\s*,\\s*))",
      "end": "(?!(?i)^[^\\S\\n]*%%(?!\\{)[^\\n]+|(?i)[^\\S\\n]*%%\\{)(?=(?i)\\s*,\\s*)",
      "patterns": [
        {
          "include": "#mode-point_x"
        }
      ]
    },
    "switch-32": {
      "begin": "(?i)\\s*,\\s*",
      "end": "(?!(?i)^[^\\S\\n]*%%(?!\\{)[^\\n]+|(?i)[^\\S\\n]*%%\\{)((?i)1|0(?:.\\d+)?)",
      "patterns": [
        {
          "include": "#mode-point_y"
        }
      ],
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.mermaid-quadrant"
        }
      },
      "endCaptures": {
        "1": {
          "name": "constant.numeric.mermaid-quadrant"
        }
      }
    },
    "rule-30": {
      "begin": "(?i)1|0(?:.\\d+)?",
      "end": "(?!\\G)",
      "applyEndPatternLast": 1,
      "patterns": [
        {
          "include": "#phase-point_x"
        },
        {
          "include": "#switch-32"
        }

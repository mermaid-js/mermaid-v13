          "token": "keyword",
          "next": "@title"
        }
      ],
      [
        "accTitle\\s*:\\s*",
        {
          "token": "keyword",
          "next": "@acc_title"
        }
      ],
      [
        "accDescr\\s*:\\s*",
        {
          "token": "keyword",
          "next": "@acc_descr"
        }
      ],
      [
        "accDescr\\s*\\{\\s*",

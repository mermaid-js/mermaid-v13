          "token": ""
        }
      ],
      [
        "\\*",
        {
          "token": ""
        }
      ],
      [
        "#",
        {
          "token": ""
        }
      ],
      [
        "_",
        {
          "token": ""
        }
      ],
      [
        "\\.",
        {
          "token": ""
        }
      ],
      [
        "&",
        {
          "token": ""
        }
      ],
      [
        "-",
        {
          "token": ""
        }
      ],
      [
        "[0-9]+",
        {
          "token": ""
        }
      ],
      [
        "\\s",
        {
          "token": ""
        }
      ],
      [
        ";",
        {
          "token": ""
        }
      ],
      [
        "[!\"#$%&'*+,\\-.`?\\\\_\\/]",
        {
          "token": ""
        }
      ]
    ],
    "title": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{",
        {
          "token": "annotation",
          "next": "@spanTrivia1"
        }
      ],
      [
        "[^\\n]*",
        {
          "token": "string",
          "next": "@pop"
        }
      ]
    ],
    "acc_title": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{",
        {
          "token": "annotation",
          "next": "@spanTrivia1"
        }
      ],
      [
        "[^\\n]*",
        {
          "token": "string",
          "next": "@pop"
        }
      ]
    ],
    "acc_descr": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{",
        {
          "token": "annotation",
          "next": "@spanTrivia1"
        }
      ],
      [
        "[^\\n]*",
        {
          "token": "string",
          "next": "@pop"
        }
      ]
    ],
    "acc_descr_multiline": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{",
        {
          "token": "annotation",
          "next": "@spanTrivia1"
        }
      ],
      [
        "\\}",
        {
          "token": "keyword",
          "next": "@pop"
        }
      ],
      [
        "[^}]+",
        {
          "token": "string"
        }
      ]
    ],
    "md_string": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{",
        {
          "token": "annotation",
          "next": "@spanTrivia1"
        }
      ],
      [
        "[^`\"]+",
        {
          "token": "string"
        }
      ],
      [
        "`\"",
        {
          "token": "string",
          "next": "@pop"
        }
      ]
    ],
    "string": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{",
        {
          "token": "annotation",
          "next": "@spanTrivia1"
        }
      ],
      [
        "\"",
        {
          "token": "string",
          "next": "@pop"
        }
      ],
      [
        "[^\"]+",
        {
          "token": "string"
        }
      ]
    ],
    "class_name": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{",
        {
          "token": "annotation",
          "next": "@spanTrivia1"
        }
      ],
      [
        "\\w+",
        {
          "token": "variable",
          "next": "@pop"
        }
      ]
    ],
    "point_start": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{",
        {
          "token": "annotation",
          "next": "@spanTrivia1"
        }
      ],
      [
        "1|0(?:.\\d+)?",
        {
          "token": "number",
          "next": "@point_x"
        }
      ],
      [
        "\\s*\\][ ]*",
        {
          "token": "delimiter",
          "next": "@pop"
        }
      ]
    ],
    "point_x": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{",
        {
          "token": "annotation",
          "next": "@spanTrivia1"
        }
      ],
      [
        "\\s*,\\s*",
        {
          "token": "delimiter",
          "switchTo": "@point_y"
        }
      ]
    ],
    "point_y": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{",
        {
          "token": "annotation",
          "next": "@spanTrivia1"
        }
      ],
      [
        "1|0(?:.\\d+)?",
        {
          "token": "number",
          "next": "@pop"
        }
      ]
    ],
    "frontMatterStart": [
      [
        "^[^\\S\\n]*---[^\\S\\n]*(?:\\n|$)",
        {
          "token": "annotation",
          "switchTo": "@frontMatter"
        }
      ],
      [
        "[^\\S\\n]*(?:\\n|$)",
        {
          "token": ""
        }
      ],
      [
        "",
        {
          "token": "",
          "switchTo": "@root"
        }
      ]
    ],
    "frontMatter": [
      [
        "^[^\\S\\n]*---[^\\S\\n]*(?:\\n|$)",
        {
          "token": "annotation",
          "switchTo": "@root"
        }
      ],
      [
        "[^\\S\\n]*#.*",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*(?:- )?[^\\s#:'\"-][^:#\\n]*(?=:(?:\\s|$))",
        {
          "token": "variable"
        }
      ],
      [
        "[^#]+",
        {
          "token": ""
        }
      ]
    ]
  }
}

      ],
      [
        "\"",
        {
          "token": "string",
          "next": "@string"
        }
      ],
      [
        ":::",
        {
          "token": "operator",
          "next": "@class_name"
        }
      ],
      [
        "\\s*:\\s*\\[\\s*",
        {
          "token": "delimiter",
          "next": "@point_start"
        }
      ],
      [
        "[ ]*quadrantChart[ ]*",
        {
          "token": "keyword"
        }
      ],
      [
        "[A-Za-z]+",
        {
          "token": ""
        }
      ],
      [
        "[^\\x00-\\x7F]+",
        {
          "token": ""
        }
      ],
      [
        ":",

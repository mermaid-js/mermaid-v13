(** Quadrant chart syntax (R-PARSE-9, D54): the normative grammar of `quadrantChart` diagrams.

The hand-written parser in `src/parser/` implements it; `tools/gen-grammar` builds a reference
parser, a sentence generator, highlighters and the syntax reference page from it. mermaid@12
decides what is valid, this file is fixed to match, and the parser must match this file
(DESIGN §4.4).

**Lexer input.** The lexer reads the diagram body as mermaid@12 handed it to its lexer: front
matter and `%%{…}%%` directives removed; CRLF and CR read as LF; `="x"` inside an HTML tag read
as `='x'`; `%%` comment lines removed and leading blanks trimmed; on a line with
`style…:…#…;` (or `classDef…`) the last `;` dropped; `#name;` / `#123;` entities read as
opaque text (letters outside ASCII); and a line break appended. Keywords are matched without
regard to case.

Statements end at a line break, `;` or the end of the text. Text is a run of letters, digits,
blanks and most punctuation, or a quoted string; it never holds `:`, and outside quotes
`( ) < > [ ] { } @ ^ ~ |` are errors. Labels are trimmed. *)

@lexer

@options case-insensitive ;

@modes title acc_title acc_descr acc_descr_multiline md_string string class_name point_start
  point_x point_y ;

(** A `%%` comment after other text on a line, to the end of the line; it takes the character
before it. *)
-                         /%%(?!\{)[^\n]*/                 :comment ;
-                         /[^}]%%[^\n]*/                   :comment ;
(** Line breaks, `;` and the end of the text end a statement. *)
NEWLINE                   /[\n\r]+/ ;
-                         /%%[^\n]*/                       :comment ;

(** `title <text>`: the chart title, the rest of the line. *)
title                     /title\b/                        push(title) :keyword ;
<title> title_value       /[^\n]*/                         pop :string ;
(** `accTitle: …` and `accDescr: …` take the rest of the line; `accDescr { … }` runs to `}`. *)
acc_title                 /accTitle\s*:\s*/                push(acc_title) :keyword ;
<acc_title> acc_title_value /[^\n]*/                       pop :string ;
acc_descr                 /accDescr\s*:\s*/                push(acc_descr) :keyword ;
<acc_descr> acc_descr_value /[^\n]*/                       pop :string ;
-                         /accDescr\s*\{\s*/               push(acc_descr_multiline) attach-next :keyword ;
<acc_descr_multiline> -   /\}/                             pop attach-prev :keyword ;
<acc_descr_multiline> acc_descr_multiline_value /[^}]*/    :string ;

(** The axis and quadrant keywords take the spaces around them, so they are found anywhere on
a line. *)
X_AXIS                    /[ ]*x-axis[ ]*/                 :keyword ;
Y_AXIS                    /[ ]*y-axis[ ]*/                 :keyword ;
(** `-->` (two or more dashes): between an axis's two labels. *)
AXIS_TEXT_DELIMITER       /[ ]*--+>[ ]*/                   :operator ;
QUADRANT_1                /[ ]*quadrant-1[ ]*/             :keyword ;
QUADRANT_2                /[ ]*quadrant-2[ ]*/             :keyword ;
QUADRANT_3                /[ ]*quadrant-3[ ]*/             :keyword ;
QUADRANT_4                /[ ]*quadrant-4[ ]*/             :keyword ;
(** `classDef <name> <styles>`: one blank after the keyword. *)
CLASSDEF                  /classDef\b/                     :keyword ;

(** Strings: `"…"` (no escapes; it may span lines and is never empty) and markdown strings
`` "`…`" ``. *)
-                         /"`/                             push(md_string) attach-next :string ;
<md_string> MD_STR        /[^`"]+/                         :string ;
<md_string> -             /`"/                             pop attach-prev :string ;
-                         /"/                              push(string) attach-next :string ;
<string> -                /"/                              pop attach-prev :string ;
<string> STR              /[^"]*/                          :string ;

(** `Name:::class: [x, y]`: the class name follows `:::` directly. *)
-                         /:::/                            push(class_name) :operator ;
<class_name> class_name   /\w+/                            pop :variable ;

(** `: [x, y]`: a point's coordinates, each `0`, `1` or `0.` and digits (the `.` is any
character). *)
point_start               /\s*:\s*\[\s*/                   push(point_start) :punctuation ;
<point_start> point_x     /1|0(?:.\d+)?/                   push(point_x) :number ;
<point_start> -           /\s*\][ ]*/                      pop attach-prev :punctuation ;
<point_x> -               /\s*,\s*/                        pop push(point_y) :punctuation ;
<point_y> point_y         /1|0(?:.\d+)?/                   pop :number ;

(** `quadrantChart`: starts a quadrant chart; statements follow, one per line. *)
QUADRANT                  /[ ]*quadrantChart[ ]*/          :keyword ;

ALPHA                     /[A-Za-z]+/ ;
(** Letters outside ASCII: CJK, accented Latin, emoji and the like. *)
UNICODE_TEXT              /[^\x00-\x7F]+/ ;
COLON                     /:/ ;
PLUS                      /\+/ ;
COMMA                     /,/ ;
EQUALS                    /=/ ;
MULT                      /\*/ ;
BRKT                      /#/ ;
UNDERSCORE                /_/ ;
DOT                       /\./ ;
AMP                       /&/ ;
MINUS                     /-/ ;
NUM                       /[0-9]+/ ;
SPACE                     /\s/ ;
SEMI                      /;/ ;
PUNCTUATION               /[!"#$%&'*+,\-.`?\\_\/]/ ;
(** The end of the text. *)
EOF                       /$/ ;

@trivia

(** Removed before lexing (see the lexer input); listed for the highlighters. A comment is a
whole line; both take their leading blanks. *)
COMMENT                   /^[^\S\n]*%%(?!\{)[^\n]+/         :comment ;
(** From `%%{` to the first `}%%`, over line breaks (core preprocess). *)
DIRECTIVE                 /[^\S\n]*%%\{[\s\S]*?\}%%/        :meta ;

@grammar

(** A chart is `quadrantChart`, then statements, one per line. *)
quadrantChart = { eol | SPACE } Header document ;
Header @Header = QUADRANT ;

document = { { SPACE } [ statement ] eol } ;
eol = NEWLINE | SEMI | EOF ;

statement = Title
  | AccTitle
  | AccDescr
  | Axis
  | Quadrant
  | Point
  | ClassDef ;

(** `title <text>`: the chart title, the rest of the line. *)
Title @Title = title title_value ;
(** `accTitle: …`: the accessible title of the chart. *)
AccTitle @AccTitle = acc_title acc_title_value ;
(** `accDescr: …` or `accDescr { … }`: the accessible description of the chart. *)
AccDescr @AccDescr = acc_descr acc_descr_value | acc_descr_multiline_value ;

(** `x-axis Low --> High` or `y-axis Low --> High`: an axis's labels, start then end. One label,
or one label and `-->`, set the start only. *)
Axis @Axis = ( X_AXIS | Y_AXIS ) text [ AXIS_TEXT_DELIMITER [ AxisEnd ] ] ;
AxisEnd @AxisEnd = text ;

(** `quadrant-1 <text>` … `quadrant-4 <text>`: a quadrant's label. Quadrant 1 is the top
right, 2 the top left, 3 the bottom left and 4 the bottom right. *)
Quadrant @Quadrant = ( QUADRANT_1 | QUADRANT_2 | QUADRANT_3 | QUADRANT_4 ) text ;

(** `Name: [x, y]`, with x and y from 0 to 1: a point, with optional styles such as
`radius: 10, color: #ff0000`. `Name:::class: [x, y]` gives it a class. *)
Point @Point = text [ class_name ] point_start point_x point_y [ styles ] ;

(** `classDef <name> <styles>`: a class of point styles, given with `:::name`. *)
ClassDef @ClassDef = CLASSDEF SPACE className SPACE styles ;
className = ( ALPHA | NUM | MINUS | COMMA | COLON | AMP | BRKT | MULT | UNICODE_TEXT )+ ;
(** Styles: `radius: <n>`, `color: <hex>`, `stroke-color: <hex>` and `stroke-width: <n>px`,
separated by `,`. *)
styles = style { COMMA style } ;
style = ( ALPHA | NUM | COLON | SPACE | BRKT | MINUS )+ ;

(** Text: a word, a quoted string or a markdown string, then more words, blanks and `-`. *)
text = ( textStart | STR | MD_STR ) { textStart | SPACE | MINUS } ;
textStart = PUNCTUATION | AMP | NUM | ALPHA | COMMA | PLUS | EQUALS | MULT | DOT | BRKT
  | UNDERSCORE | UNICODE_TEXT ;

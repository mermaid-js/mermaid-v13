        }
      }
    },
    "rule-1": {
      "begin": "(?<=^|\\n)[\\t ]*(?=accTitle[\\t ]*:|accDescr[\\t ]*(?::|\\{[^}]*\\}))",
      "end": "(accDescr[\\t ]*\\{[^}]*\\})|(accTitle[\\t ]*:[^\\n]*)|(accDescr[\\t ]*:[^\\n]*)",

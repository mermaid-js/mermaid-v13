{
  "name": "@mermaid-js/plugin-icons",
  "version": "13.0.0-alpha.0",
  "description": "Iconify icon packs in Mermaid v13: icons drawn as allow-listed SVG nodes, packs loaded only for diagrams that use them (D290, D295).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mermaid-js/mermaid-v13",
    "directory": "packages/plugin-icons"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "mermaid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@mermaid-js/core": "workspace:*"
  },
  "devDependencies": {
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/logos": "^1.2.18",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/utils": "3.1.7",
    "@mermaid-js/core": "workspace:^",
    "esbuild": "^0.25.12",
    "mermaid": "workspace:*"
  },
  "mermaid": {
    "plugin": "extension",
    "id": "icons",
    "entry": "./dist/index.js",
    "export": "icons"
  }
}

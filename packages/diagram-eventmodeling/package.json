{
  "name": "@mermaid-js/diagram-eventmodeling",
  "version": "13.0.0-alpha.1",
  "description": "Event modeling plugin for Mermaid: parser, layout, SVG renderer and language facet.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mermaid-js/mermaid-v13",
    "directory": "packages/diagram-eventmodeling"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "mermaid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./language": {
      "mermaid-source": "./src/language.ts",
      "types": "./dist/language.d.ts",
      "default": "./dist/language.js"
    },
    "./testing": {
      "mermaid-source": "./src/testing.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "port:v12-specs": "tsx scripts/port-v12-specs.ts && prettier --write src/v12-specs"
  },
  "peerDependencies": {
    "@mermaid-js/core": "workspace:*",
    "@mermaid-js/shared": "workspace:*"
  },
  "devDependencies": {
    "@mermaid-js/core": "workspace:^",
    "@mermaid-js/shared": "workspace:^"
  },
  "mermaid": {
    "plugin": "diagram",
    "id": "eventmodeling",
    "types": [
      "eventmodeling"
    ],
    "formats": [
      "svg"
    ],
    "export": "eventmodeling",
    "language": "./dist/language.js"
  }
}

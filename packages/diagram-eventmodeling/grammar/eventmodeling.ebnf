(** Event modeling syntax (R-PARSE-9, D54): the normative grammar of `eventmodeling` diagrams.

The hand-written parser in `src/parser/` implements it; `tools/gen-grammar` builds a reference
parser, a sentence generator, highlighters and the syntax reference page from it. mermaid@12
decides what is valid, this file is fixed to match, and the parser must match this file
(DESIGN §4.4). mermaid@12 parsed event models with Langium (`event-modeling.langium` in
`@mermaid-js/parser`); the rules below are its token rules, in its order, and its grammar.

**Lexer input.** The lexer reads the diagram body as mermaid@12 handed it to its lexer: front
matter and `%%{…}%%` directives removed; CRLF and CR read as LF; `="x"` inside an HTML tag read
as `='x'`; on a line with `style…:…#…;` (or `classDef…`) the last `;` dropped; `#name;` /
`#123;` entities read as opaque text; and a line break appended. Unlike most diagrams, `%%`
comment lines stay in the text (the lexer skips them) and leading blanks are not trimmed.
Keywords are case-sensitive.

Whitespace, line breaks included, separates tokens and nothing more: statements need no line
of their own, and `eventmodeling tf 01 evt A tf 02 evt B` is two frames. A keyword is a keyword
only as a whole word (`tf01` and `evtA` are names), and no name can be a keyword. `title`,
`accTitle` and `accDescr` are read only after a blank on the line of an earlier token (`eventmodeling
title My model`); at the start of a line they are names, which no statement takes. *)

@lexer

(** `eventmodeling`: starts an event model. It ends at a blank, a line break, `%%` or the end
of the text. *)
HEADER                    /eventmodeling(?=\s|%%|$)/       :keyword ;
(** `resetframe 01 evt Name`: a frame that starts a new flow: no relation is drawn to it unless
it names its sources with `->>`. *)
RESETFRAME                /resetframe(?!\w)/               :keyword ;
(** `readmodel`: a read model frame, in the Command/Read Model lane (as `rmo`). *)
READMODEL                 /readmodel(?!\w)/                :keyword ;
(** `processor`: an automated processor frame, in the UI/Automation lane (as `pcr`). *)
PROCESSOR                 /processor(?!\w)/                :keyword ;
(** `timeframe 01 evt Name`: a frame, the next step on the time line (as `tf`). *)
TIMEFRAME                 /timeframe(?!\w)/                :keyword ;
(** `command`: a command frame, in the Command/Read Model lane (as `cmd`). *)
COMMAND                   /command(?!\w)/                  :keyword ;
(** `entity Name`: declares an entity, which `gwt` steps name. It is not drawn. *)
ENTITY                    /entity(?!\w)/                   :keyword ;
(** `event`: an event frame, in the Events lane (as `evt`). *)
EVENT                     /event(?!\w)/                    :keyword ;
(** `` `jsobj` ``: data written as a JavaScript object (the type is not used in drawing). *)
JSOBJ                     /jsobj(?!\w)/                    :keyword ;
(** `` `figma` ``: data that is a Figma reference (the type is not used in drawing). *)
FIGMA                     /figma(?!\w)/                    :keyword ;
(** `given`: the steps a `gwt` starts from. *)
GIVEN                     /given(?!\w)/                    :keyword ;
(** `` `json` ``: data written as JSON (the type is not used in drawing). *)
JSON                      /json(?!\w)/                     :keyword ;
(** `` `salt` ``: data written as a PlantUML Salt wireframe (the type is not used in drawing). *)
SALT                      /salt(?!\w)/                     :keyword ;
(** `` `html` ``: data written as HTML (the type is not used in drawing; it shows as text). *)
HTML                      /html(?!\w)/                     :keyword ;
(** `` `text` ``: data that is plain text. *)
TEXT                      /text(?!\w)/                     :keyword ;
(** `data Name { … }`: a named data block, which frames show with `[[Name]]`. *)
DATA                      /data(?!\w)/                     :keyword ;
(** `note 01 { … }`: a note on a frame. It is not drawn. *)
NOTE                      /note(?!\w)/                     :keyword ;
(** `when`: the steps of a `gwt` that act. *)
WHEN                      /when(?!\w)/                     :keyword ;
(** `then`: the steps a `gwt` expects. *)
THEN                      /then(?!\w)/                     :keyword ;
(** `rmo`: a read model frame, in the Command/Read Model lane. *)
RMO                       /rmo(?!\w)/                      :keyword ;
(** `cmd`: a command frame, in the Command/Read Model lane. *)
CMD                       /cmd(?!\w)/                      :keyword ;
(** `evt`: an event frame, in the Events lane. *)
EVT                       /evt(?!\w)/                      :keyword ;
(** `pcr`: an automated processor frame, in the UI/Automation lane. *)
PCR                       /pcr(?!\w)/                      :keyword ;
(** `` `uri` ``: data that is a link (the type is not used in drawing). *)
URI                       /uri(?!\w)/                      :keyword ;
(** `->> 01`: the frame this one takes its input from; a frame may name several. Without one,
the frame is joined to the nearest earlier frame in another lane. *)
ARROW                     /->>/                            :operator ;
(** `gwt 01 given … when … then …`: a given/when/then specification of a frame. It is not
drawn. *)
GWT                       /gwt(?!\w)/                      :keyword ;
(** `ui`: a user interface frame, in the UI/Automation lane. *)
UI                        /ui(?!\w)/                       :keyword ;
(** `` `md` ``: data written as Markdown (the type is not used in drawing). *)
MD                        /md(?!\w)/                       :keyword ;
(** `tf 01 evt Name`: a frame, the next step on the time line: an id of one to three digits, a
kind, a name, then optionally its sources, a `[[data]]` reference and inline data. *)
TF                        /tf(?!\w)/                       :keyword ;
(** `[[Name]]`: shows the data block `Name` in the frame. *)
OPEN_REF                  /\[\[/                           :punctuation ;
CLOSE_REF                 /\]\]/                           :punctuation ;
(** `rf 01 evt Name`: a reset frame (as `resetframe`). *)
RF                        /rf(?!\w)/                       :keyword ;
(** The backticks around a data type: `` `json` ``. *)
BACKTICK                  /`/                              :punctuation ;
(** `.` in a qualified name: `Inventory.ItemAdded` puts the frame in the lane of its
namespace. *)
DOT                       /\./                             :punctuation ;
(** A name: ASCII letters, digits and `_`, starting with a letter or `_`. *)
ID                        /[_a-zA-Z][\w_]*/                :variable ;
(** A frame id: one to three digits (`0`, `00` and `01` are three ids). *)
FRAME_ID                  /\d{1,3}/                        :number ;
(** Inline data: `{` to the last `}` on its line, or `"…"` or `'…'` to the last quote of its
kind on the line. *)
DATA_INLINE               /\{(.*)\}|"(.*)"|'(.*)'/          :string ;
(** A data block: `{` at the end of its line, the lines of data, then `}` on a line of its
own. *)
DATA_BLOCK                /\{[\t ]*\r?\n(?:[\S\s]*?\r?\n)?\}(?:\r?\n|(?!\S))/ :string ;
(** `accDescr: …` to `%%` or the line end, or `accDescr { … }`: the accessible description,
after another token on its line. *)
ACC_DESCR                 /[\t ]*accDescr(?:[\t ]*:([^\n\r]*?(?=%%)|[^\n\r]*)|\s*\{([^}]*)\})/ :keyword ;
(** `accTitle: …` to `%%` or the line end: the accessible title, after another token on its
line. *)
ACC_TITLE                 /[\t ]*accTitle[\t ]*:(?:[^\n\r]*?(?=%%)|[^\n\r]*)/ :keyword ;
(** `title …` to `%%` or the line end: the title (not drawn), after another token on its
line. *)
TITLE                     /[\t ]*title(?:[\t ][^\n\r]*?(?=%%)|[\t ][^\n\r]*|)/ :keyword ;
-                         /\s+/ ;
(** A `---` … `---` block inside the body: skipped. *)
YAML                      /---[\t ]*\r?\n(?:[\S\s]*?\r?\n)?---(?:\r?\n|(?!\S))/ :meta ;
(** A `%%{…}%%` left in the text the lexer reads: skipped. *)
DIRECTIVE                 /[\t ]*%%\{[\S\s]*?\}%%(?:\r?\n|(?!\S))/ :meta ;
(** `%%` to the end of the line: a comment. *)
COMMENT                   /[\t ]*%%[^\n\r]*/              :comment ;
(** `/* … */`: a comment, over lines. *)
BLOCK_COMMENT             /\/\*[\s\S]*?\*\//               :comment ;
(** `//` to the end of the line: a comment. *)
LINE_COMMENT              /\/\/[^\n\r]*/                  :comment ;
(** The end of the text. *)
EOF                       /$/ ;

@trivia

(** From `%%{` to the first `}%%`, over line breaks (core preprocess). *)
DIRECTIVE                 /[^\S\n]*%%\{[\s\S]*?\}%%/        :meta ;

@grammar

(** An event model is `eventmodeling`, then statements. The `YAML`, `DIRECTIVE` and comment
tokens of the lexer are skipped before parsing. *)
eventmodeling = Header { statement } EOF ;
Header @Header = HEADER ;
statement = Frame | Entity | Data | Note | Gwt | Title | AccTitle | AccDescr ;

(** A frame's kind, which picks its lane. *)
kind = UI | PCR | PROCESSOR | CMD | COMMAND | RMO | READMODEL | EVT | EVENT ;
(** `` `json` `` (…): how the data is written; not used in drawing. *)
dataType = BACKTICK ( JSON | JSOBJ | FIGMA | SALT | URI | MD | HTML | TEXT ) BACKTICK ;
(** `Name` or `Namespace.Name`: a two-part name puts the frame in its namespace's lane. *)
qualifiedName = ID { DOT ID } ;

(** `tf 01 evt Name`, then its sources (`->> 01`), a `[[data]]` reference and inline data, in
that order, each optional. *)
Frame @Frame = ( TF | TIMEFRAME | RF | RESETFRAME ) FRAME_ID kind qualifiedName { Source }
               [ OPEN_REF ID CLOSE_REF ] [ [ dataType ] DATA_INLINE ] ;
Source @Source = ARROW FRAME_ID ;
Entity @Entity = ENTITY qualifiedName ;
Data @Data = DATA ID [ dataType ] DATA_BLOCK ;
Note @Note = NOTE FRAME_ID [ dataType ] DATA_BLOCK ;
(** `gwt 01 given <kind> <Name> … [when …] then …`: each part lists one or more steps. *)
Gwt @Gwt = GWT FRAME_ID GIVEN step { step } [ WHEN step { step } ] THEN step { step } ;
step = kind ID ;
(** `title …`: the title, after another token on its line (the last one wins). *)
Title @Title = TITLE ;
(** `accTitle: …`: the accessible title. *)
AccTitle @AccTitle = ACC_TITLE ;
(** `accDescr: …` or `accDescr { … }`: the accessible description. *)
AccDescr @AccDescr = ACC_DESCR ;

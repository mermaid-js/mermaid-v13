eventmodeling title Cart accTitle: Cart model
%% the shopping cart
tf 01 ui CartScreen
tf 02 cmd Cart.AddItem ->> 01 `json` { "productId": 7 }
tf 03 evt Cart.ItemAdded { productId: 7, quantity: 1 } accDescr {
  A cart model: a screen, a command,
  its event and a read model.
}
rf 04 rmo CartItems ->> 03
/* the cart's
   entity */
entity Cart.Item
gwt 03 given evt ItemAdded when cmd AddItem then evt ItemAdded

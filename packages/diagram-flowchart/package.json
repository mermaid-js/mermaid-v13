{
  "name": "@mermaid-js/diagram-flowchart",
  "version": "13.0.0-alpha.3",
  "description": "Flowchart diagram plugin for Mermaid: parser, model, graph builder, shapes and renderer.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mermaid-js/mermaid-v13",
    "directory": "packages/diagram-flowchart"
  },
  "sideEffects": false,
  "exports": {
    "./testing": {
      "mermaid-source": "./src/testing.ts"
    },
    ".": {
      "mermaid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ascii": {
      "mermaid-source": "./src/ascii.ts",
      "types": "./dist/ascii.d.ts",
      "default": "./dist/ascii.js"
    },
    "./lanes": {
      "mermaid-source": "./src/lanes.ts",
      "types": "./dist/lanes.d.ts",
      "default": "./dist/lanes.js"
    },
    "./language": {
      "mermaid-source": "./src/language.ts",
      "types": "./dist/language.d.ts",
      "default": "./dist/language.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "port:v12-specs": "tsx scripts/port-v12-specs.ts && prettier --write src/v12-specs"
  },
  "peerDependencies": {
    "@mermaid-js/core": "workspace:*",
    "@mermaid-js/shared": "workspace:*"
  },
  "devDependencies": {
    "@mermaid-js/core": "workspace:^",
    "@mermaid-js/shared": "workspace:^"
  },
  "mermaid": {
    "plugin": "diagram",
    "id": "flowchart",
    "types": [
      "flowchart-elk",
      "flowchart-v2",
      "swimlane"
    ],
    "typeOptions": {
      "flowchart-elk": {
        "layout": "elk"
      },
      "swimlane": {
        "section": "swimlane",
        "layout": "swimlane"
      }
    },
    "formats": [
      "svg",
      "ascii"
    ],
    "export": "flowchart",
    "ascii": "./dist/ascii.js",
    "language": "./dist/language.js"
  }
}

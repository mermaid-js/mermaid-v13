{
  "name": "@mermaid-js/diagram-flowchart",
  "version": "0.0.0",
  "description": "Flowchart diagram plugin for Mermaid: parser, model, graph builder, shapes and renderer.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "mermaid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "port:v12-specs": "tsx scripts/port-v12-specs.ts && prettier --write src/v12-specs"
  },
  "peerDependencies": {
    "@mermaid-js/core": "workspace:^"
  },
  "devDependencies": {
    "@mermaid-js/core": "workspace:^"
  }
}

{
  "name": "@mermaid-js/diagram-flowchart",
  "version": "0.0.0",
  "description": "Flowchart diagram plugin for Mermaid: parser, model, graph builder, shapes and renderer.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "mermaid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ascii": {
      "mermaid-source": "./src/ascii.ts",
      "types": "./dist/ascii.d.ts",
      "default": "./dist/ascii.js"
    },
    "./language": {
      "mermaid-source": "./src/language.ts",
      "types": "./dist/language.d.ts",
      "default": "./dist/language.js"
    },
    "./monarch.json": {
      "mermaid-source": "./grammar/generated/flowchart.monarch.json"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "port:v12-specs": "tsx scripts/port-v12-specs.ts && prettier --write src/v12-specs"
  },
  "peerDependencies": {
    "@mermaid-js/core": "workspace:^"
  },
  "devDependencies": {
    "@mermaid-js/core": "workspace:^"
  },
  "mermaid": {
    "plugin": "diagram",
    "id": "flowchart",
    "types": [
      "flowchart-elk",
      "flowchart-v2"
    ],
    "formats": [
      "svg",
      "ascii"
    ],
    "export": "flowchart",
    "ascii": "./dist/ascii.js",
    "language": "./dist/language.js"
  }
}

{
  "name": "@mermaid-js/plugin-autoload",
  "version": "13.0.0-alpha.1",
  "description": "Opt-in plugin discovery for Mermaid v13 in Node: registers the plugins your package.json lists, with one await (D589).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mermaid-js/mermaid-v13",
    "directory": "packages/plugin-autoload"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "mermaid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mermaid-js/core": "workspace:*"
  },
  "devDependencies": {
    "mermaid": "workspace:*"
  }
}

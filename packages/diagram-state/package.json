{
  "name": "@mermaid-js/diagram-state",
  "version": "0.0.0",
  "private": true,
  "description": "State diagram plugin for Mermaid: lexer, parser and model (layout and renderer to follow).",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "mermaid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "port:v12-specs": "tsx scripts/port-v12-specs.ts && prettier --write src/v12-specs"
  },
  "peerDependencies": {
    "@mermaid-js/core": "workspace:^"
  },
  "devDependencies": {
    "@mermaid-js/core": "workspace:^"
  }
}

      [
        "(?i:.*(?=<<fork>>))",
        {
          "token": "variable"
        }
      ],
      [
        "(?i:.*(?=<<join>>))",
        {
          "token": "variable"
        }
      ],
      [
        "(?i:.*(?=<<choice>>))",
        {
          "token": "variable"
        }
      ],
      [
        "(?i:.*(?=\\[\\[fork\\]\\]))",
        {
          "token": "variable"
        }
      ],
      [
        "(?i:.*(?=\\[\\[join\\]\\]))",
        {
          "token": "variable"
        }
      ],
      [
        "(?i:.*(?=\\[\\[choice\\]\\]))",
        {
          "token": "variable"
        }
      ],
      [
        "\"",
        {
          "token": "string",
          "next": "@STATE_STRING"
        }
      ],
      [
        "\\s*(?i:as)\\s+",
        {
          "token": "keyword",
          "next": "@STATE_ID"
        }
      ],
      [
        "\\w+\\s+\\w+.*?\\{",
        {
          "token": ""
        }
      ],
      [
        "[^\\n\\s{]+",
        {
          "token": "variable"
        }
      ],
      [
        "\\n",
        {
          "token": "",
          "next": "@pop"
        }
      ],
      [
        "\\{",
        {
          "token": "delimiter",
          "switchTo": "@struct"
        }
      ]
    ],
    "STATE_STRING": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{.*?\\}%%",
        {
          "token": "annotation"
        }
      ],
      [
        "\"",
        {
          "token": "string",
          "next": "@pop"
        }
      ],
      [
        "[^\"]+",
        {
          "token": "string"
        }
      ]
    ],
    "STATE_ID": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{.*?\\}%%",
        {
          "token": "annotation"
        }
      ],
      [
        "%%[^\\n{]*",
        {
          "token": ""
        }
      ],
      [
        "(?:[^\\n{%]|%(?!%))*",
        {
          "token": "variable",
          "next": "@pop"
        }
      ]
    ],
    "SCALE": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{.*?\\}%%",
        {
          "token": "annotation"
        }
      ],
      [
        "\\d+",
        {
          "token": "number"
        }
      ],
      [
        "\\s+(?i:width)\\b",
        {
          "token": "keyword",
          "next": "@pop"
        }
      ]
    ],
    "acc_title": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{.*?\\}%%",
        {
          "token": "annotation"
        }
      ],
      [
        "[^\\n]*",
        {
          "token": "string",
          "next": "@pop"
        }
      ]
    ],
    "acc_descr": [

        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{.*?\\}%%",
        {
          "token": "annotation"
        }
      ],
      [
        "[^\\n]*",
        {
          "token": "string",
          "next": "@pop"
        }
      ]
    ],
    "acc_descr_multiline": [

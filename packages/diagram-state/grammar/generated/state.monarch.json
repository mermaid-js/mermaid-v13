      [
        "-->",
        {
          "token": "operator"
        }
      ],
      [
        "--",
        {
          "token": "operator"
        }
      ],
      [
        ":::",
        {
          "token": "operator"
        }
      ]
    ],
    "frontMatterStart": [
      [
        "^[^\\S\\n]*---[^\\S\\n]*(?:\\n|$)",
        {
          "token": "annotation",
          "switchTo": "@frontMatter"

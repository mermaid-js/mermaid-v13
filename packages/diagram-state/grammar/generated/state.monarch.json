        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{.*?\\}%%",
        {
          "token": "annotation"
        }
      ],
      [
        "(?:[^\\n%]|%(?!%))*",
        {
          "token": "variable",
          "next": "@pop"
        }
      ]
    ],
    "struct": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{.*?\\}%%",
        {
          "token": "annotation"
        }
      ],
      [
        "(?:(?!\\n)\\s)+",
        {
          "token": ""
        }
      ],
      [
        "#[^\\n]*",
        {
          "token": "comment"
        }
      ],
      [

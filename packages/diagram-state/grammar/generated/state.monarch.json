        {
          "token": "keyword"
        }
      ],
      [
        "(?i:.*direction\\s+bt)[^\\n]*",
        {
          "token": "keyword"
        }
      ],
      [
        "(?i:.*direction\\s+rl)[^\\n]*",
        {
          "token": "keyword"
        }
      ],
      [
        "(?i:.*direction\\s+lr)[^\\n]*",
        {
          "token": "keyword"
        }
      ],
      [
        "\\}",
        {
          "token": "delimiter",
          "next": "@pop"
        }
      ],
      [

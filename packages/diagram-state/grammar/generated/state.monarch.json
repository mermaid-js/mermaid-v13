{
  "tokenPostfix": ".mermaid-state",
  "defaultToken": "",
  "includeLF": true,
  "start": "frontMatterStart",
  "tokenizer": {
    "root": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{.*?\\}%%",
        {
          "token": "annotation"
        }
      ],
      [
        "(?i:click)\\b",
        {
          "token": "keyword"
        }
      ],
      [
        "(?i:href)\\b",
        {
          "token": "keyword"
        }
      ],
      [
        "\"[^\"]*\"",
        {
          "token": "string"
        }
      ],
      [
        "(?i:default)\\b",
        {
          "token": "keyword"
        }
      ],
      [
        "(?i:.*direction\\s+tb)[^\\n]*",
        {
          "token": "keyword"
        }
      ],
      [
        "(?i:.*direction\\s+bt)[^\\n]*",
        {
          "token": "keyword"
        }
      ],
      [
        "(?i:.*direction\\s+rl)[^\\n]*",
        {
          "token": "keyword"
        }
      ],
      [
        "(?i:.*direction\\s+lr)[^\\n]*",
        {
          "token": "keyword"
        }
      ],
      [
        "\\n+",
        {
          "token": ""
        }
      ],
      [
        "\\s+",
        {
          "token": ""
        }
      ],
      [
        "#[^\\n]*",
        {
          "token": "comment"
        }
      ],
      [
        "%%(?!\\{)[^\\n]*",
        {
          "token": "comment"
        }
      ],
      [
        "(?i:scale)\\s+",
        {
          "token": "keyword",
          "next": "@SCALE"
        }
      ],
      [
        "(?i:accTitle)\\s*:\\s*",
        {
          "token": "keyword",
          "next": "@acc_title"
        }
      ],
      [
        "(?i:accDescr)\\s*:\\s*",
        {
          "token": "keyword",
          "next": "@acc_descr"
        }
      ],
      [
        "(?i:accDescr)\\s*\\{\\s*",
        {
          "token": "keyword",
          "next": "@acc_descr_multiline"
        }
      ],
      [
        "(?i:classDef)\\s+",
        {
          "token": "keyword",
          "next": "@CLASSDEF"
        }
      ],
      [
        "(?i:class)\\s+",
        {
          "token": "keyword",
          "next": "@CLASS"
        }
      ],
      [
        "(?i:style)\\s+",
        {
          "token": "keyword",
          "next": "@STYLE"
        }
      ],
      [
        "(?i:state)\\s+",
        {
          "token": "keyword",
          "next": "@STATE"
        }
      ],
      [
        "\\{",
        {
          "token": "delimiter",
          "next": "@struct"
        }
      ],
      [
        "(?i:note)\\s+",
        {
          "token": "keyword",
          "next": "@NOTE"
        }
      ],
      [
        "(?i:stateDiagram)\\s+",
        {
          "token": "keyword"
        }
      ],
      [
        "(?i:stateDiagram-v2)\\s+",
        {
          "token": "keyword"
        }
      ],
      [
        "(?i:hide empty description)\\b",
        {
          "token": "keyword"
        }
      ],
      [
        "\\[\\*\\]",
        {
          "token": "constant"
        }
      ],
      [
        "%%[^:\\n\\s\\-{]*",
        {
          "token": ""
        }
      ],
      [
        "(?:[^:\\n\\s\\-{%]|%(?!%))+",
        {
          "token": "variable"
        }
      ],
      [
        "\\s*:(?:[^:\\n;]|:[^:\\n;])+",
        {
          "token": "string"
        }
      ],
      [
        "-->",
        {
          "token": "operator"
        }
      ],
      [
        ":::",
        {
          "token": "operator"
        }
      ],
      [
        ".",
        {
          "token": ""
        }
      ]
    ],
    "STATE": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{.*?\\}%%",
        {
          "token": "annotation"
        }
      ],
      [
        "(?:(?!\\n)\\s)+",
        {
          "token": ""
        }
      ],
      [
        "#[^\\n]*",
        {
          "token": "comment"
        }
      ],
      [
        "%%(?!\\{)[^\\n]*",
        {
          "token": "comment"
        }
      ],

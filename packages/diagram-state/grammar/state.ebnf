(** State diagram syntax (R-PARSE-9, D54): the normative grammar of `stateDiagram` and
`stateDiagram-v2` diagrams, which are the same language (D101).

The hand-written parser in `src/parser/` implements it; `tools/gen-grammar` builds a reference
parser, a sentence generator, highlighters and the syntax reference page from it. mermaid@12
decides what is valid, this file is fixed to match, and the parser must match this file
(DESIGN §4.4).

**Lexer input.** The lexer reads the diagram body as mermaid@12 handed it to its lexer: front
matter and `%%{…}%%` directives removed; CRLF read as LF; `="x"` inside an HTML tag read as
`='x'`; `%%` comment lines removed and leading blanks trimmed; on a line with
`style…:…#…;` (or `classDef…`) the last `;` dropped; `#name;` / `#123;` entities kept as
opaque text that no rule matches as `#`; and a line break appended. Keywords match in any case.

**Statements** need no separator: a line break is a statement of its own, so `A B` is two
states. Inside a composite state line breaks are not tokens at all. *)

@lexer

@modes STATE STATE_STRING STATE_ID SCALE acc_title acc_descr acc_descr_multiline CLASSDEF
  CLASSDEFID CLASS CLASS_STYLE STYLE STYLEDEF_STYLES NOTE NOTE_ID NOTE_TEXT FLOATING_NOTE
  FLOATING_NOTE_ID struct embed ;

(** `click <state> "url" "tooltip"` or `click <state> href "url"`: makes the state a link. *)
CLICK                     /(?i:click)\b/                   :keyword ;
HREF                      /(?i:href)\b/                    :keyword ;
STRING                    /"[^"]*"/                        :string ;
DEFAULT                   /(?i:default)\b/                 :keyword ;

(** `direction TB`, `BT`, `RL` or `LR`: the direction of the diagram, or of the composite state
it is in. The whole line is the statement, wherever `direction` stands in it. *)
direction_tb              /(?i:.*direction\s+tb)[^\n]*/    :keyword ;
direction_bt              /(?i:.*direction\s+bt)[^\n]*/    :keyword ;
direction_rl              /(?i:.*direction\s+rl)[^\n]*/    :keyword ;
direction_lr              /(?i:.*direction\s+lr)[^\n]*/    :keyword ;

NL                        /\n+/ ;
-                         /\s+/ ;
<STATE,struct> -          /(?:(?!\n)\s)+/ ;
<INITIAL,STATE,struct> -  /#[^\n]*/                        :comment ;
<INITIAL,STATE,struct> -  /%%(?!\{)[^\n]*/                 :comment ;

(** `scale 200 width`: accepted and ignored. *)
scale                     /(?i:scale)\s+/                  push(SCALE) :keyword ;
<SCALE> WIDTH             /\d+/                            :number ;
<SCALE> -                 /\s+(?i:width)\b/                pop attach-prev :keyword ;

(** `accTitle: …`: the accessible title of the diagram. *)
acc_title                 /(?i:accTitle)\s*:\s*/           push(acc_title) :keyword ;
<acc_title> acc_title_value /[^\n]*/                       pop :string ;
(** `accDescr: …` or `accDescr { … }`: the accessible description of the diagram. *)
acc_descr                 /(?i:accDescr)\s*:\s*/           push(acc_descr) :keyword ;
<acc_descr> acc_descr_value /[^\n]*/                       pop :string ;
-                         /(?i:accDescr)\s*\{\s*/          push(acc_descr_multiline) attach-next :keyword ;
<acc_descr_multiline> -   /\}/                             pop attach-prev :keyword ;
<acc_descr_multiline> acc_descr_multiline_value /[^}]*/    :string ;

(** `classDef name fill:#f96,color:#000`: defines a class of styles. `default` is not a class
name here. *)
<INITIAL,struct> classDef /(?i:classDef)\s+/               push(CLASSDEF) :keyword ;
<CLASSDEF> DEFAULT_CLASSDEF_ID /(?i:default)\s+/           pop push(CLASSDEFID) :variable ;
<CLASSDEF> CLASSDEF_ID    /\w+\s+/                         pop push(CLASSDEFID) :variable ;
<CLASSDEFID> CLASSDEF_STYLEOPTS /[^\n]*/                   pop :string ;
(** `class A,B name`: gives states a class, as `A:::name` does. *)
<INITIAL,struct> class    /(?i:class)\s+/                  push(CLASS) :keyword ;
<CLASS> CLASSENTITY_IDS   /\w+(?:,\s*\w+)*/                pop push(CLASS_STYLE) :variable ;
<CLASS_STYLE> STYLECLASS  /[^\n]*/                         pop :variable ;
(** `style A,B fill:#f96`: styles states. *)
<INITIAL,struct> style    /(?i:style)\s+/                  push(STYLE) :keyword ;
<STYLE> STYLE_IDS         /[\w,]+\s+/                      pop push(STYLEDEF_STYLES) :variable ;
<STYLEDEF_STYLES> STYLEDEF_STYLEOPTS /[^\n]*/              pop :string ;

(** `state X { … }`, `state "description" as X`, `state x <<fork>>`: declares a state. *)
<INITIAL,struct> -        /(?i:state)\s+/                  push(STATE) attach-next :keyword ;
<STATE> -                 /(?i:<<(?:fork|join|choice)>>|\[\[(?:fork|join|choice)\]\])/ pop attach-prev :keyword ;
(** `state f <<fork>>`, `<<join>>`, `<<choice>>` (or `[[fork]]` …): a pseudo-state. *)
<STATE> FORK              /(?i:.*(?=<<fork>>))/            :variable ;
<STATE> JOIN              /(?i:.*(?=<<join>>))/            :variable ;
<STATE> CHOICE            /(?i:.*(?=<<choice>>))/          :variable ;
<STATE> FORK              /(?i:.*(?=\[\[fork\]\]))/        :variable ;
<STATE> JOIN              /(?i:.*(?=\[\[join\]\]))/        :variable ;
<STATE> CHOICE            /(?i:.*(?=\[\[choice\]\]))/      :variable ;
<struct> direction_tb     /(?i:.*direction\s+tb)[^\n]*/    :keyword ;
<struct> direction_bt     /(?i:.*direction\s+bt)[^\n]*/    :keyword ;
<struct> direction_rl     /(?i:.*direction\s+rl)[^\n]*/    :keyword ;
<struct> direction_lr     /(?i:.*direction\s+lr)[^\n]*/    :keyword ;
<STATE> -                 /"/                              push(STATE_STRING) attach-next :string ;
<STATE> AS                /\s*(?i:as)\s+/                  push(STATE_ID) :keyword ;
(** An id holding `%%` ends before it. *)
<STATE_ID> -              /%%[^\n{]*/ ;
<STATE_ID> ID             /(?:[^\n{%]|%(?!%))*/            pop :variable ;
<STATE_STRING> -          /"/                              pop attach-prev :string ;
<STATE_STRING> STATE_DESCR /[^"]*/                         :string ;
(** A state name is one word: v12 throws here. The `{` is read on as in a valid one. *)
<STATE> MULTI_WORD_STATE  /\w+\s+\w+.*?(?=\{)/ ;
<STATE> COMPOSITE_STATE   /[^\n\s{]+/                      :variable ;
<STATE> -                 /\n/                             pop ;
(** `{` and `}` around the statements of a composite state. *)
<INITIAL,STATE> STRUCT_START /\{/                          pop push(struct) :punctuation ;
<struct> STRUCT_STOP      /\}/                             pop :punctuation ;
<struct> -                /\n/ ;

(** `note left of A : text`, or `note right of A`, the text on the lines after it, then
`end note`. *)
<INITIAL,struct> note     /(?i:note)\s+/                   push(NOTE) :keyword ;
<NOTE> left_of            /(?i:left of)\b/                 pop push(NOTE_ID) :keyword ;
<NOTE> right_of           /(?i:right of)\b/                pop push(NOTE_ID) :keyword ;
<NOTE> -                  /"/                              pop push(FLOATING_NOTE) attach-next :string ;
<FLOATING_NOTE> AS        /\s*(?i:as)\s*/                  pop push(FLOATING_NOTE_ID) :keyword ;
<FLOATING_NOTE> -         /"/                              attach-prev :string ;
<FLOATING_NOTE> NOTE_TEXT /[^"]*/                          :string ;
<FLOATING_NOTE_ID> ID     /(?:[^\n%]|%(?!%))*/             pop :variable ;
<NOTE_ID> ID              /\s*(?:[^:\n\s\-%]|%(?!%))+/     pop push(NOTE_TEXT) :variable ;
<NOTE_TEXT> NOTE_TEXT     /\s*:[^:\n;]+/                   pop :string ;
<NOTE_TEXT> -             /\n\s*(?i:end note)\b/           pop attach-prev :keyword ;
<NOTE_TEXT> NOTE_TEXT     /[\s\S]*?(?=\n\s*(?i:end note)\b)/ :string ;

(** Embedded diagram blocks (ADR-15, not in mermaid@12): `mermaid <id>["Title"] {` on a line of
its own, the body (another diagram's text, as one token), then `}` first on its own line. The
hand-written lexer enters this mode for `mermaid` and a blank at the start of a line ending in
`{`, and finds the closing line by counting lines that end in `{` against lines that start with
`}`; this file lists the tokens for their highlight categories only. *)
<embed> EMBED             /mermaid/                        :keyword ;
<embed> EMBED_ID          /[^\s\[{]+/                      :variable ;
<embed> EMBED_TITLE       /\[[^\]]*\]/                     :string ;
<embed> EMBED_OPEN        /\{/                             :punctuation ;
<embed> EMBED_BODY        /[^}]+/                          :meta ;
<embed> EMBED_END         /\}/                             :punctuation ;

(** The header: `stateDiagram` or `stateDiagram-v2`. *)
SD                        /(?i:stateDiagram)\s+/           :keyword ;
SD                        /(?i:stateDiagram-v2)\s+/        :keyword ;
(** `hide empty description`: accepted and ignored. *)
HIDE_EMPTY                /(?i:hide empty description)\b/  :keyword ;

(** `[*]`: the start state of the composite (or diagram) it is in, or its end state when a
transition goes to it. *)
<INITIAL,struct> EDGE_STATE /\[\*\]/                       :constant ;
<INITIAL,struct> -        /%%[^:\n\s\-{]*/ ;
<INITIAL,struct> ID       /(?:[^:\n\s\-{%]|%(?!%))+/       :variable ;
(** `A : text` gives a state a description; after a transition it is the transition's label.
An entity's `;` (`#colon;`) does not end it. *)
<INITIAL,struct> DESCR    /\s*:(?:#\w+;|[^:\n;]|:[^:\n;])+/ :string ;
(** `A --> B`: a transition. *)
<INITIAL,struct> ARROW    /-->/                            :operator ;
(** `--` splits a composite state into concurrent regions. *)
<struct> CONCURRENT       /--/                             :operator ;
(** `A:::name`: gives the state a class, as `class A name` does. *)
<INITIAL,struct> STYLE_SEPARATOR /:::/                     :operator ;
END_OF_INPUT              /$/ ;
INVALID                   /./ ;

@trivia

(** Removed before lexing (see the lexer input); listed for the highlighters. *)
COMMENT                   /^[^\S\n]*%%(?!\{)[^\n]+/         :comment ;
(** From `%%{` to the first `}%%`, over line breaks (core preprocess). *)
DIRECTIVE                 /[^\S\n]*%%\{[\s\S]*?\}%%/        :meta ;

@grammar

(** A diagram is the header, then statements; line breaks are statements too. *)
stateDiagram = { NL | END_OF_INPUT } Header document ;
Header @Header = SD ;
document = { statement | NL | END_OF_INPUT } ;

statement = Plain
  | Transition
  | Declared
  | Composite
  | Described
  | Pseudo
  | Divider
  | Note
  | ClassDef
  | Style
  | Class
  | Direction
  | AccTitle
  | AccDescr
  | Click
  | HideEmpty
  | Scale ;

idStatement = ( ID | EDGE_STATE ) [ STYLE_SEPARATOR ID ] ;
(** A state on its own, with an optional description. *)
Plain @State = idStatement [ DESCR ] ;
(** A transition with an optional label. *)
Transition @Transition = end ARROW end [ DESCR ] ;
end @State = idStatement ;
(** `state X` on its own declares nothing (v12 draws no state for it). *)
Declared @State = COMPOSITE_STATE ;
(** `state X { … }` or `state "description" as X { … }`: a composite state; `--` splits it into
concurrent regions. *)
Composite @Composite = COMPOSITE_STATE STRUCT_START document STRUCT_STOP
  | STATE_DESCR AS ID STRUCT_START document STRUCT_STOP ;
(** `state "description" as X`: a state with a description. *)
Described @State = STATE_DESCR AS ID ;
(** `state f <<fork>>`, `<<join>>`, `<<choice>>` (or `[[fork]]` …): a pseudo-state. *)
Pseudo @State = FORK | JOIN | CHOICE ;
(** `--` splits a composite state into concurrent regions. *)
Divider @Divider = CONCURRENT ;
(** `note left of A : text`, or `note right of A`, the text on the lines after it, then
`end note`. A floating `note "text" as N` is accepted and not drawn. *)
Note @Note = note ( left_of | right_of ) target NOTE_TEXT
  | note NOTE_TEXT AS ID ;
target @State = ID ;
(** `classDef name fill:#f96,color:#000`: defines a class of styles. *)
ClassDef @ClassDef = classDef ( CLASSDEF_ID | DEFAULT ) CLASSDEF_STYLEOPTS ;
(** `style A,B fill:#f96`: styles states. *)
Style @Style = style STYLE_IDS STYLEDEF_STYLEOPTS ;
(** `class A,B name`: gives states a class, as `A:::name` does. *)
Class @Class = class CLASSENTITY_IDS STYLECLASS ;
(** `direction TB`, `BT`, `RL` or `LR`: the direction of the diagram, or of the composite state
it is in. *)
Direction @Direction = direction_tb | direction_bt | direction_rl | direction_lr ;
(** `accTitle: …`: the accessible title of the diagram. *)
AccTitle @AccTitle = acc_title acc_title_value ;
(** `accDescr: …` or `accDescr { … }`: the accessible description of the diagram. *)
AccDescr @AccDescr = acc_descr acc_descr_value | acc_descr_multiline_value ;
(** `click <state> "url" "tooltip"` or `click <state> href "url"`: makes the state a link. *)
Click @Click = CLICK idStatement ( STRING STRING | HREF STRING ) ( NL | END_OF_INPUT ) ;
(** `hide empty description`: accepted and ignored. *)
HideEmpty @HideEmpty = HIDE_EMPTY ;
(** `scale 200 width`: accepted and ignored. *)
Scale @Scale = scale WIDTH ;

(** Git graph syntax (R-PARSE-9, D54): the normative grammar of `gitGraph` diagrams.

The hand-written parser in `src/parser/` implements it; `tools/gen-grammar` builds a reference
parser, a sentence generator, highlighters and the syntax reference page from it. mermaid@12
decides what is valid, this file is fixed to match, and the parser must match this file
(DESIGN §4.4). mermaid@12 parsed gitGraph with Langium (`gitGraph.langium`, `common.langium`
and `reference.langium` in `@mermaid-js/parser`); the rules below are its token rules, in its
order, and its grammar.

**Lexer input.** The lexer reads the diagram body as mermaid@12 handed it to its lexer: front
matter and `%%{…}%%` directives removed; CRLF and CR read as LF; `="x"` inside an HTML tag read
as `='x'`; `%%` comment lines removed and leading blanks trimmed; on a line with
`style…:…#…;` (or `classDef…`) the last `;` dropped; `#name;` / `#123;` entities read as
opaque text; and a line break appended. Keywords are case-sensitive. A word keyword gives way
to a name that goes on past it (`commits`, `cherry-pick03`), so each has a lookahead for the
rest of a name; `title` never does, so a name cannot start with `title` unless it is quoted.

Each statement ends at a line break (or the end of the text); `;` is not a separator. *)

@lexer

(** `cherry-pick id:"A"`: copies commit `A` onto the current branch. Takes `id:` (required),
`parent:` (required for a merge commit) and `tag:`. *)
CHERRY_PICK               /cherry-pick(?![-.\/\w]*[-\w])/ :keyword ;
(** `gitGraph:`: starts a git graph. *)
GIT_GRAPH_COLON           /gitGraph:/                      :keyword ;
(** `type: HIGHLIGHT`: a commit drawn as a filled square. *)
HIGHLIGHT                 /HIGHLIGHT(?![-.\/\w]*[-\w])/    :keyword ;
(** `gitGraph`: starts a git graph, optionally with a direction: `gitGraph TB:`. *)
GIT_GRAPH                 /gitGraph(?:(?=%%)|(?!\S))/      :keyword ;
(** `checkout dev`: makes `dev` the current branch. *)
CHECKOUT                  /checkout(?![-.\/\w]*[-\w])/     :keyword ;
(** `type: REVERSE`: a commit drawn crossed out. *)
REVERSE                   /REVERSE(?![-.\/\w]*[-\w])/      :keyword ;
(** `parent: "B"`: which parent of a merge commit a cherry-pick follows. *)
PARENT                    /parent:/                        :keyword ;
(** `commit`: adds a commit to the current branch. Takes `id:`, `msg:` (or a quoted message),
`tag:` and `type:`, in any order. *)
COMMIT                    /commit(?![-.\/\w]*[-\w])/       :keyword ;
(** `type: NORMAL`: a plain commit (the default). *)
NORMAL                    /NORMAL(?![-.\/\w]*[-\w])/       :keyword ;
(** `branch dev`: creates the branch `dev` at the current commit and checks it out. *)
BRANCH                    /branch(?![-.\/\w]*[-\w])/       :keyword ;
(** `order: 2`: where a branch is drawn among the others (lower first; 0 without one). *)
ORDER                     /order:/                         :keyword ;
(** `switch dev`: the same as `checkout dev`. *)
SWITCH                    /switch(?![-.\/\w]*[-\w])/       :keyword ;
(** `type: HIGHLIGHT`: how a commit or merge is drawn: `NORMAL`, `REVERSE` or `HIGHLIGHT`. *)
TYPE                      /type:/                          :keyword ;
(** `merge dev`: merges branch `dev` into the current branch. Takes `id:`, `tag:` and `type:`. *)
MERGE                     /merge(?![-.\/\w]*[-\w])/        :keyword ;
(** `msg: "text"`: the commit message. *)
MSG                       /msg:/                           :keyword ;
(** `tag: "v1.0"`: a tag drawn next to the commit; repeat it for more. *)
TAG                       /tag:/                           :keyword ;
(** `id: "A"`: the commit's id, shown as its label; a cherry-pick's source commit. *)
ID                        /id:/                            :keyword ;
(** `gitGraph LR:`: branches run left to right (the default). *)
LR                        /LR(?![-.\/\w]*[-\w])/           :keyword ;
(** `gitGraph TB:`: branches run top to bottom. *)
TB                        /TB(?![-.\/\w]*[-\w])/           :keyword ;
(** `gitGraph BT:`: branches run bottom to top. *)
BT                        /BT(?![-.\/\w]*[-\w])/           :keyword ;
COLON                     /:/                              :punctuation ;
(** `accDescr: …` (the rest of the line) or `accDescr { … }` (over lines, to `}`): the accessible
description of the graph. mermaid@12's one rule, as two tried in order; the block's
`[\s\S]*?\}` is its `[^}]*\}`, written so that line-based highlighters read the block as one span. *)
ACC_DESCR                 /[\t ]*accDescr[\t ]*:(?:[^\n\r]*?(?=%%)|[^\n\r]*)/ :keyword ;
ACC_DESCR                 /[\t ]*accDescr\s*\{[\s\S]*?\}/ :keyword ;
(** `accTitle: …`: the accessible title of the graph, the rest of the line. *)
ACC_TITLE                 /[\t ]*accTitle[\t ]*:(?:[^\n\r]*?(?=%%)|[^\n\r]*)/ :keyword ;
(** `title …`: the title drawn above the graph, the rest of the line. *)
TITLE                     /[\t ]*title(?:[\t ][^\n\r]*?(?=%%)|[\t ][^\n\r]*|)/ :keyword ;
(** A branch order: `0` or a number without leading zeros, not followed by `.`. *)
INT                       /0|[1-9][0-9]*(?!\.)/            :number ;
(** A quoted text: `"…"` or `'…'`; `\` escapes the next character, and the text may span
lines. Ids, messages, tags and quoted branch names. *)
STRING                    /"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'/ :string ;
NEWLINE                   /\r?\n/ ;
-                         /[\t ]+/ ;
(** A `---` … `---` block inside the body: skipped. *)
YAML                      /---[\t ]*\r?\n(?:[\S\s]*?\r?\n)?---(?:\r?\n|(?!\S))/ :meta ;
(** A `%%{…}%%` left in the text the lexer reads: skipped. *)
DIRECTIVE                 /[\t ]*%%\{[\S\s]*?\}%%(?:\r?\n|(?!\S))/ :meta ;
(** `%%` to the end of the line, after other text: a comment. *)
COMMENT                   /[\t ]*%%[^\n\r]*/              :comment ;
(** A branch name: letters, digits and `_`, with `-`, `.` and `/` inside, not ending in `.` or
`/` (`feature/x.y`, `1.0.1`, `hotfix-2`). Quote any other name. *)
REFERENCE                 /\w(?:[-.\/\w]*[-\w])?/          :variable ;
(** The end of the text. *)
EOF                       /$/ ;

@trivia

(** Removed before lexing (see the lexer input); listed for the highlighters. A comment is a
whole line; both take their leading blanks. *)
COMMENT                   /^[^\S\n]*%%(?!\{)[^\n]+/         :comment ;
(** From `%%{` to the first `}%%`, over line breaks (core preprocess). *)
DIRECTIVE                 /[^\S\n]*%%\{[\s\S]*?\}%%/        :meta ;

@grammar

(** A git graph is `gitGraph` (with a direction), then statements, one per line; the first may
follow on the `gitGraph` line. The `YAML`, `DIRECTIVE` and `COMMENT` tokens of the lexer are
skipped before parsing. *)
gitGraph = { NEWLINE } Header { NEWLINE | statement NEWLINE } [ statement ] EOF ;
(** `gitGraph`, `gitGraph:`, or with a direction and its colon: `gitGraph TB:`. *)
Header @Header = GIT_GRAPH [ COLON | direction COLON ] | GIT_GRAPH_COLON ;
direction = LR | TB | BT ;

statement = Commit | Branch | Merge | Checkout | CherryPick | Title | AccTitle | AccDescr ;

(** `commit id: "A" msg: "Fix" tag: "v1" type: HIGHLIGHT`: a commit on the current branch. The
last `id:`, message and `type:` count; every `tag:` is drawn. *)
Commit @Commit = COMMIT { ID STRING | [ MSG ] STRING | TAG STRING | TYPE commitType } ;
commitType = NORMAL | REVERSE | HIGHLIGHT ;
name = REFERENCE | STRING ;
(** `branch dev order: 2`: a new branch at the current commit, checked out. *)
Branch @Branch = BRANCH name [ ORDER INT ] ;
(** `merge dev id: "M" tag: "v2" type: REVERSE`: a merge commit of `dev` into the current
branch. *)
Merge @Merge = MERGE name { ID STRING | TAG STRING | TYPE commitType } ;
(** `checkout dev` or `switch dev`: the branch the next statements work on. *)
Checkout @Checkout = ( CHECKOUT | SWITCH ) name ;
(** `cherry-pick id: "A" parent: "B" tag: "fix"`: a copy of commit `A` on the current branch,
tagged `cherry-pick:A` unless `tag:` is given. *)
CherryPick @CherryPick = CHERRY_PICK { ID STRING | TAG STRING | PARENT STRING } ;
(** `title Release flow`: the title drawn above the graph (the last one wins). *)
Title @Title = TITLE ;
(** `accTitle: …`: the accessible title. *)
AccTitle @AccTitle = ACC_TITLE ;
(** `accDescr: …` or `accDescr { … }`: the accessible description. *)
AccDescr @AccDescr = ACC_DESCR ;

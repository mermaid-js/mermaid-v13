{
  "tokenPostfix": ".mermaid-gitgraph",
  "defaultToken": "",
  "includeLF": true,
  "start": "frontMatterStart",
  "tokenizer": {
    "spanTrivia1": [
      [
        "\\}%%",
        {
          "token": "annotation",
          "next": "@pop"
        }
      ],
      [
        "(?:(?!\\}%%)[\\s\\S])+",
        {
          "token": "annotation"
        }
      ]
    ],
    "spanRule22": [
      [
        "\\}",
        {
          "token": "keyword",
          "next": "@pop"
        }
      ],
      [
        "(?:(?!\\})[\\s\\S])+",
        {
          "token": "keyword"
        }
      ]
    ],
    "root": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{",
        {
          "token": "annotation",
          "next": "@spanTrivia1"
        }
      ],
      [
        "cherry-pick(?![-.\\/\\w]*[-\\w])",
        {
          "token": "keyword"
        }
      ],
      [
        "gitGraph:",
        {
          "token": "keyword"
        }
      ],
      [
        "HIGHLIGHT(?![-.\\/\\w]*[-\\w])",
        {
          "token": "keyword"
        }
      ],
      [
        "gitGraph(?:(?=%%)|(?!\\S))",
        {
          "token": "keyword"
        }
      ],
      [
        "checkout(?![-.\\/\\w]*[-\\w])",
        {
          "token": "keyword"
        }
      ],
      [
        "REVERSE(?![-.\\/\\w]*[-\\w])",
        {
          "token": "keyword"
        }
      ],
      [
        "parent:",
        {
          "token": "keyword"
        }
      ],
      [
        "commit(?![-.\\/\\w]*[-\\w])",
        {
          "token": "keyword"
        }
      ],
      [
        "NORMAL(?![-.\\/\\w]*[-\\w])",
        {
          "token": "keyword"
        }
      ],
      [
        "branch(?![-.\\/\\w]*[-\\w])",
        {
          "token": "keyword"
        }
      ],
      [
        "order:",
        {
          "token": "keyword"
        }
      ],
      [
        "switch(?![-.\\/\\w]*[-\\w])",
        {
          "token": "keyword"
        }
      ],
      [
        "type:",
        {
          "token": "keyword"
        }
      ],
      [
        "merge(?![-.\\/\\w]*[-\\w])",
        {
          "token": "keyword"
        }
      ],
      [
        "msg:",
        {
          "token": "keyword"
        }
      ],
      [
        "tag:",
        {
          "token": "keyword"
        }
      ],
      [
        "id:",
        {
          "token": "keyword"
        }
      ],
      [
        "LR(?![-.\\/\\w]*[-\\w])",
        {
          "token": "keyword"
        }
      ],
      [
        "TB(?![-.\\/\\w]*[-\\w])",
        {
          "token": "keyword"
        }
      ],
      [
        "BT(?![-.\\/\\w]*[-\\w])",
        {
          "token": "keyword"
        }
      ],
      [
        ":",
        {
          "token": "delimiter"
        }
      ],
      [
        "[\\t ]*accDescr[\\t ]*:(?:[^\\n\\r]*?(?=%%)|[^\\n\\r]*)",
        {
          "token": "keyword"
        }
      ],
      [
        "[\\t ]*accDescr\\s*\\{",
        {
          "token": "keyword",
          "next": "@spanRule22"
        }
      ],
      [
        "[\\t ]*accTitle[\\t ]*:(?:[^\\n\\r]*?(?=%%)|[^\\n\\r]*)",
        {
          "token": "keyword"
        }
      ],
      [
        "[\\t ]*title(?:[\\t ][^\\n\\r]*?(?=%%)|[\\t ][^\\n\\r]*|)",
        {
          "token": "keyword"
        }
      ],
      [
        "0|[1-9][0-9]*(?!\\.)",
        {
          "token": "number"
        }
      ],
      [
        "\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'",
        {
          "token": "string"
        }
      ],
      [
        "\\r?\\n",
        {
          "token": ""
        }
      ],
      [
        "[\\t ]+",
        {
          "token": ""
        }
      ],
      [
        "---[\\t ]*\\r?\\n(?:[\\S\\s]*?\\r?\\n)?---(?:\\r?\\n|(?!\\S))",
        {
          "token": "annotation"
        }
      ],
      [
        "[\\t ]*%%\\{[\\S\\s]*?\\}%%(?:\\r?\\n|(?!\\S))",
        {
          "token": "annotation"
        }
      ],
      [
        "[\\t ]*%%[^\\n\\r]*",
        {
          "token": "comment"
        }
      ],
      [
        "\\w(?:[-.\\/\\w]*[-\\w])?",
        {
          "token": "variable"
        }
      ]
    ],
    "frontMatterStart": [
      [
        "^[^\\S\\n]*---[^\\S\\n]*(?:\\n|$)",
        {
          "token": "annotation",
          "switchTo": "@frontMatter"
        }
      ],
      [
        "[^\\S\\n]*(?:\\n|$)",
        {
          "token": ""
        }
      ],
      [
        "",
        {
          "token": "",
          "switchTo": "@root"
        }
      ]
    ],
    "frontMatter": [
      [
        "^[^\\S\\n]*---[^\\S\\n]*(?:\\n|$)",
        {
          "token": "annotation",
          "switchTo": "@root"
        }
      ],
      [
        "[^\\S\\n]*#.*",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*(?:- )?[^\\s#:'\"-][^:#\\n]*(?=:(?:\\s|$))",
        {
          "token": "variable"
        }
      ],
      [
        "[^#]+",
        {
          "token": ""
        }
      ]
    ]
  }
}

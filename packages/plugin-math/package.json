{
  "name": "@mermaid-js/plugin-math",
  "version": "13.0.0-alpha.2",
  "description": "TeX math in Mermaid v13 labels: $$…$$ typeset by MathJax into SVG paths, loaded only for diagrams with math (D175, D178).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mermaid-js/mermaid-v13",
    "directory": "packages/plugin-math"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "mermaid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@mermaid-js/core": "workspace:*"
  },
  "devDependencies": {
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@mermaid-js/core": "workspace:^",
    "esbuild": "^0.25.12",
    "mermaid": "workspace:*",
    "tsx": "^4.20.6"
  },
  "mermaid": {
    "plugin": "extension",
    "id": "math",
    "entry": "./dist/index.js",
    "export": "math"
  }
}

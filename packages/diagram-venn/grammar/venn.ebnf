(** Venn diagram syntax (R-PARSE-9, D54): the normative grammar of `venn-beta` diagrams.

The hand-written parser in `src/parser/` implements it; `tools/gen-grammar` builds a reference
parser, a sentence generator, highlighters and the syntax reference page from it. mermaid@12
decides what is valid, this file is fixed to match, and the parser must match this file
(DESIGN §4.4).

**Lexer input.** The lexer reads the diagram body as mermaid@12 handed it to its lexer: front
matter and `%%{…}%%` directives removed; CRLF and CR read as LF; `="x"` inside an HTML tag read
as `='x'`; `%%` comment lines removed and leading blanks trimmed; on a line with
`style…:…#…;` (or `classDef…`) the last `;` dropped; `#name;` / `#123;` entities read as
opaque text that no rule takes apart; and a line break appended. Keywords are matched without
regard to case; ids are case-sensitive.

**Indented text.** After a `set` or `union`, a line of blanks and then `text` is an indented
text node, which takes the sets of that `set` or `union`. This lasts through blank and comment
lines until a line starts with anything else (an indented one too); the depth of the indent is
never compared.

Statements need no separator: one ends where its rule does, so `venn-beta set A` and
`set A set B` are two statements. A `union` names two or more sets declared before it with
`set`; the parser checks that, the grammar does not. *)

@lexer

@options case-insensitive ;

@modes bol on onBol itext qlabel label labelEnd ;

(** A `%%` comment after other text on a line, to the end of the line; at the start of a token it
takes the character before it. *)
<INITIAL,bol,on,onBol> -     /%%(?!\{)[^\n]*/              :comment ;
<INITIAL,bol,on,onBol> -     /[^}]%%[^\n]*/                :comment ;
(** At a line start: blanks before a line break or before other text are skipped. *)
<bol,onBol> -                /[ \t]+(?=[\n\r])/ ;
(** `text <id>` on an indented line right under a `set` or `union` (or another such line): a
text node in its area. The token is the indent. *)
<onBol> INDENT_TEXT          /[ \t]+(?=text\b)/            pop push(itext) ;
<bol,onBol> -                /[ \t]+/ ;
(** Any other line start ends the indented text lines. *)
<bol> -                      /(?=[^ \t\n\r])/              pop ;
<onBol> -                    /(?=[^ \t\n\r])/              pop pop ;
<itext> -                    /text\b/                      pop attach-prev :keyword ;
(** Line breaks separate statements. *)
NEWLINE                      /[\n\r]+/                     push(bol) ;
<on> NEWLINE                 /[\n\r]+/                     push(onBol) ;
<bol,onBol> NEWLINE          /[\n\r]+/ ;
<INITIAL,on> -               /%%[^\n]*/                    :comment ;
<INITIAL,on> -               /[ \t]+/ ;
(** The end of the text. *)
<INITIAL,bol,on,onBol> EOF   /$/ ;

(** `title <text>`: the diagram title, the rest of the line (no `#` or `;`); a bare `title`
takes the next line. One pair of surrounding quotes is removed. *)
<INITIAL,on> TITLE           /title\s[^#\n;]+/             :keyword ;
(** `venn-beta`: starts a venn diagram. *)
<INITIAL,on> VENN            /venn-beta\b/                 :keyword ;
(** `set <id>`: a set, with an optional `[label]` and `: size` (10 by default). *)
SET                          /set\b/                       push(on) :keyword ;
<on> SET                     /set\b/                       :keyword ;
(** `union <id>,<id>…`: the overlap of two or more declared sets, with an optional `[label]`
and `: size` (10 / n² for n sets by default). *)
UNION                        /union\b/                     push(on) :keyword ;
<on> UNION                   /union\b/                     :keyword ;
(** `text <ids> <id>`: a text node in the area of those sets, with an optional `[label]`. *)
<INITIAL,on> TEXT            /text\b/                      :keyword ;
(** `style <ids> key: value, …`: the `fill`, `fill-opacity`, `stroke`, `stroke-width` and
`color` of a set, an overlap or a text node. *)
<INITIAL,on> STYLE           /style\b/                     :keyword ;

(** A label: `["…"]` as written, or `[…]` trimmed. *)
<INITIAL,on> -               /\["(?=[^"]*"\])/             push(qlabel) attach-next :string ;
<qlabel> BRACKET_LABEL       /[^"]*/                       pop push(labelEnd) :string ;
<INITIAL,on> -               /\[\s*(?=[^\]"]+\])/          push(label) attach-next :string ;
<label> BRACKET_LABEL        /[^\]"]*?(?=\s*\])/           pop push(labelEnd) :string ;
<labelEnd> -                 /"?\s*\]/                     pop attach-prev :string ;

(** A size or a number in a style value. *)
<INITIAL,on> NUMERIC         /[+-]?(?:\d+(?:\.\d+)?|\.\d+)/ :number ;
(** A colour in a style value: `#` and three to eight hex digits, `rgba(…)` or `rgb(…)`. *)
<INITIAL,on> HEXCOLOR        /#[0-9a-fA-F]{3,8}/           :constant ;
<INITIAL,on> RGBACOLOR       /rgba\(\s*[0-9.]+\s*,\s*[0-9.]+\s*,\s*[0-9.]+\s*,\s*[0-9.]+\s*\)/ :constant ;
<INITIAL,on> RGBCOLOR        /rgb\(\s*[0-9.]+\s*,\s*[0-9.]+\s*,\s*[0-9.]+\s*\)/ :constant ;
(** An id, a style key or a word of a style value: letters, digits, `_` and `-`, starting with
a letter or `_`. *)
<INITIAL,on> IDENTIFIER      /[A-Za-z_][A-Za-z0-9\-_]*/    :variable ;
(** A quoted id or style value; one pair of quotes is removed. *)
<INITIAL,on> STRING          /"[^"]*"/                     :string ;
<INITIAL,on> COMMA           /,/                           :punctuation ;
<INITIAL,on> COLON           /:/                           :punctuation ;

@trivia

(** Removed before lexing (see the lexer input); listed for the highlighters. A comment is a
whole line; both take their leading blanks. *)
COMMENT                      /^[^\S\n]*%%(?!\{)[^\n]+/     :comment ;
(** From `%%{` to the first `}%%`, over line breaks (core preprocess). *)
DIRECTIVE                    /[^\S\n]*%%\{[\s\S]*?\}%%/    :meta ;

@grammar

(** A venn diagram is `venn-beta`, then its statements and line breaks. Line breaks may come
before `venn-beta`. *)
diagram = { NEWLINE } VENN { NEWLINE | statement } EOF ;

statement = Title | Set | Union | Text | IndentedText | Style ;

(** `title <text>`: the diagram title, the rest of the line; one pair of surrounding quotes
is removed, as in `title "Team overlap"`. *)
Title @Title = TITLE ;
(** `set <id>`: a set, with an optional `[label]` and `:size` (10 by default), as in
`set A["Alpha"]:20`. *)
Set @Set = SET id [ BRACKET_LABEL ] [ COLON NUMERIC ] ;
(** `union <id>,<id>…`: the overlap of two or more sets declared before it, with an optional
`[label]` and `:size` (10 / n² for n sets by default), as in `union A,B["Both"]:2`. *)
Union @Union = UNION ids [ BRACKET_LABEL ] [ COLON NUMERIC ] ;
(** `text <ids> <id>`: a text node in the area of those sets, with an optional `[label]` (not
after an id that is a number), as in `text A,B t1["In both"]`. *)
Text @Text = TEXT ids textId ;
(** `text <id>` on an indented line right under a `set` or `union` (or another such line): a
text node in its area. *)
IndentedText @Text = INDENT_TEXT textId ;
textId = NUMERIC | id [ BRACKET_LABEL ] ;
(** `style <ids> key: value, …`: the `fill`, `fill-opacity`, `stroke`, `stroke-width` and
`color` of a set, an overlap or a text node, as in `style A,B fill: #f00`. *)
Style @Style = STYLE ids field { COMMA field } ;
field = IDENTIFIER COLON value ;
(** A quoted value, or words, numbers and colours (joined with one blank). *)
value = STRING | valueToken { valueToken } ;
valueToken = IDENTIFIER | NUMERIC | HEXCOLOR | RGBCOLOR | RGBACOLOR ;
ids = id { COMMA id } ;
id = IDENTIFIER | STRING ;

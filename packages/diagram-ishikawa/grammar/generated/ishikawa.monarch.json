{
  "tokenPostfix": ".mermaid-ishikawa",
  "defaultToken": "",
  "ignoreCase": true,
  "includeLF": true,
  "start": "frontMatterStart",
  "tokenizer": {
    "spanTrivia1": [
      [
        "\\}%%",
        {
          "token": "annotation",
          "next": "@pop"
        }
      ],
      [
        "(?:(?!\\}%%)[\\s\\S])+",
        {
          "token": "annotation"
        }
      ]
    ],
    "root": [
      [
        "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*%%\\{",
        {
          "token": "annotation",
          "next": "@spanTrivia1"
        }
      ],
      [
        "\\s*%%.*",
        {
          "token": "comment"
        }
      ],
      [
        "ishikawa-beta\\b",
        {
          "token": "keyword"
        }
      ],
      [
        "ishikawa\\b",
        {
          "token": "keyword"
        }
      ],
      [
        "[\\s]+[\\n]",
        {
          "token": ""
        }
      ],
      [
        "[\\n]+",
        {
          "token": ""
        }
      ],
      [
        "[\\s]+",
        {
          "token": ""
        }
      ],
      [
        "[^\\n]+",
        {
          "token": "string"
        }
      ]
    ],
    "frontMatterStart": [
      [
        "^[^\\S\\n]*---[^\\S\\n]*(?:\\n|$)",
        {
          "token": "annotation",
          "switchTo": "@frontMatter"
        }
      ],
      [
        "[^\\S\\n]*(?:\\n|$)",
        {
          "token": ""
        }
      ],
      [
        "",
        {
          "token": "",
          "switchTo": "@root"
        }
      ]
    ],
    "frontMatter": [
      [
        "^[^\\S\\n]*---[^\\S\\n]*(?:\\n|$)",
        {
          "token": "annotation",
          "switchTo": "@root"
        }
      ],
      [
        "[^\\S\\n]*#.*",
        {
          "token": "comment"
        }
      ],
      [
        "[^\\S\\n]*(?:- )?[^\\s#:'\"-][^:#\\n]*(?=:(?:\\s|$))",
        {
          "token": "variable"
        }
      ],
      [
        "[^#]+",
        {
          "token": ""
        }
      ]
    ]
  }
}

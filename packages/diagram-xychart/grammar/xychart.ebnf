(** XY chart syntax (R-PARSE-9, D54): the normative grammar of `xychart` and `xychart-beta`
diagrams.

The hand-written parser in `src/parser/` implements it; `tools/gen-grammar` builds a reference
parser, a sentence generator, highlighters and the syntax reference page from it. mermaid@12
decides what is valid, this file is fixed to match, and the parser must match this file
(DESIGN §4.4).

**Lexer input.** The lexer reads the diagram body as mermaid@12 handed it to its lexer: front
matter and `%%{…}%%` directives removed (an unclosed `%%{` takes the rest of the text, or ends
after a word argument); CRLF and CR read as LF; `="x"` inside an HTML tag read as `='x'`; `%%`
comment lines removed and leading blanks trimmed; on a line with `style…:…#…;` (or
`classDef…`) the last `;` dropped; `#name;` / `#123;` entities read as opaque text (letters
outside ASCII); and a line break appended. Keywords are matched without regard to case.

Statements may end at a line break, `;` or the end of the text, but need not: `bar [1] line [2]`
is two plots. Text outside quotes is a run of letters, digits and `+ = * # _ . & -`, with one
space wherever blanks separate them (`title Sales  2024` is `Sales 2024`; #683, as v12's fix
mermaid-js/mermaid#8575; 12.2.0 read `Sales2024`), and a line break after a blank is one of the
blanks; quote it to keep a run of blanks or to use other characters. After `x-axis` and `y-axis` digits read as numbers (`x-axis Year2024
[a]` is a title and the start of a range), and inside a plot's brackets only numbers and quoted
labels are allowed. A `%%` right after a character other than `}` is a comment that takes that
character with it (`bar [1]%% c` loses its `]`). *)

@lexer

@options case-insensitive ;

@modes acc_title acc_descr acc_descr_multiline string axis_data axis_band_data data data_inner ;

(** A `%%` comment after other text on a line, to the end of the line; the second form takes the
character before it. *)
<INITIAL,axis_data,axis_band_data,data,data_inner> - /%%(?!\{)[^\n]*/ :comment ;
<INITIAL,axis_data,axis_band_data,data,data_inner> - /[^\}]%%[^\n]*/ :comment ;
(** Line breaks, `;` and the end of the text end a statement. A line break ends an axis's data
and a plot's. *)
<axis_data> NEWLINE /\r?\n/ pop ;
<data> NEWLINE /\r?\n/ pop ;
<INITIAL,axis_data,axis_band_data,data,data_inner> NEWLINE /[\n\r]+/ ;
<INITIAL,axis_data,axis_band_data,data,data_inner> - /%%[^\n]*/ :comment ;

(** `title <text>`: the chart title. *)
<INITIAL,axis_data,axis_band_data,data,data_inner> title /title\b/ :keyword ;
(** `accTitle: …` and `accDescr: …` take the rest of the line; `accDescr { … }` runs to `}`. *)
<INITIAL,axis_data,axis_band_data,data,data_inner> acc_title /accTitle\s*:\s*/ push(acc_title)
  :keyword ;
<acc_title> acc_title_value /[^\n]*/ pop :string ;
<INITIAL,axis_data,axis_band_data,data,data_inner> acc_descr /accDescr\s*:\s*/ push(acc_descr)
  :keyword ;
<acc_descr> acc_descr_value /[^\n]*/ pop :string ;
<INITIAL,axis_data,axis_band_data,data,data_inner> - /accDescr\s*\{\s*/
  push(acc_descr_multiline) attach-next :keyword ;
<acc_descr_multiline> - /\}/ pop attach-prev :keyword ;
<acc_descr_multiline> acc_descr_multiline_value /[^\}]*/ :string ;

(** `xychart` or `xychart-beta`: starts an XY chart, optionally followed by its orientation. *)
<INITIAL,axis_data,axis_band_data,data,data_inner> XYCHART /xychart-beta\b/ :keyword ;
<INITIAL,axis_data,axis_band_data,data,data_inner> XYCHART /xychart\b/ :keyword ;
(** `vertical` (the default) or `horizontal`, right after `xychart`: which way the bars run. *)
<INITIAL,axis_data,axis_band_data,data,data_inner> CHART_ORIENTATION /(?:vertical|horizontal)/
  :keyword ;

(** `x-axis` and `y-axis`: an axis's title and data. *)
<INITIAL,axis_data,axis_band_data,data,data_inner> X_AXIS /x-axis\b/ push(axis_data) :keyword ;
<INITIAL,axis_data,axis_band_data,data,data_inner> Y_AXIS /y-axis\b/ push(axis_data) :keyword ;
<axis_data> SQUARE_BRACES_START /\[/ push(axis_band_data) :punctuation ;
(** `-->`: between the two ends of an axis range. *)
<axis_data> ARROW_DELIMITER /-->/ :operator ;

(** `line` and `bar`: a plot, with an optional name and its values in brackets. *)
<INITIAL,axis_data,axis_band_data,data,data_inner> LINE /line\b/ push(data) :keyword ;
<INITIAL,axis_data,axis_band_data,data,data_inner> BAR /bar\b/ push(data) :keyword ;
<data> SQUARE_BRACES_START /\[/ push(data_inner) :punctuation ;

(** A number: an optional sign, then digits with an optional fraction, or `.` and digits. *)
<axis_data,data_inner> NUMBER_WITH_DECIMAL /[+-]?(?:\d+(?:\.\d+)?|\.\d+)/ :number ;
<data_inner,axis_band_data> SQUARE_BRACES_END /\]/ pop :punctuation ;

(** The literal source text of v12's broken markdown-string rules, which jison compiled into one
rule matching that text: a markdown string never opens. *)
<INITIAL,axis_data,axis_band_data,data,data_inner> -
  /`\)[ ]{36}\{ this\.pushState\(md_string\); \}\n<md_string>\(\?:\(\?!`"\)\.\)\+[ ]{18}
  \{ return MD_STR; \}\n<md_string>\(\?:`/ pop :string ;

(** Strings: `"…"` (no escapes; it may span lines). *)
<INITIAL,axis_data,axis_band_data,data,data_inner> - /"/ push(string) attach-next :string ;
<string> - /"/ pop attach-prev :string ;
<string> STR /[^"]*/ :string ;

<INITIAL,axis_data,axis_band_data,data,data_inner> SQUARE_BRACES_START /\[/ :punctuation ;
<INITIAL,axis_data,axis_band_data,data,data_inner> SQUARE_BRACES_END /\]/ :punctuation ;
<INITIAL,axis_data,axis_band_data,data,data_inner> ALPHA /[A-Za-z]+/ ;
<INITIAL,axis_data,axis_band_data,data,data_inner> COLON /:/ ;
<INITIAL,axis_data,axis_band_data,data,data_inner> PLUS /\+/ ;
<INITIAL,axis_data,axis_band_data,data,data_inner> COMMA /,/ :punctuation ;
<INITIAL,axis_data,axis_band_data,data,data_inner> EQUALS /=/ ;
<INITIAL,axis_data,axis_band_data,data,data_inner> MULT /\*/ ;
<INITIAL,axis_data,axis_band_data,data,data_inner> BRKT /#/ ;
<INITIAL,axis_data,axis_band_data,data,data_inner> UNDERSCORE /_/ ;
<INITIAL,axis_data,axis_band_data,data,data_inner> DOT /\./ ;
<INITIAL,axis_data,axis_band_data,data,data_inner> AMP /&/ ;
<INITIAL,axis_data,axis_band_data,data,data_inner> MINUS /-/ ;
<INITIAL,axis_data,axis_band_data,data,data_inner> NUM /[0-9]+/ ;
<INITIAL,axis_data,axis_band_data,data,data_inner> - /\s+/ ;
<INITIAL,axis_data,axis_band_data,data,data_inner> SEMI /;/ ;
(** The end of the text. *)
<INITIAL,axis_data,axis_band_data,data,data_inner> EOF /$/ ;

@trivia

(** Removed before lexing (see the lexer input); listed for the highlighters. A comment is a
whole line; both take their leading blanks. *)
COMMENT /^[^\S\n]*%%(?!\{)[^\n]+/ :comment ;
(** From `%%{` to the first `}%%`, over line breaks (core preprocess). *)
DIRECTIVE /[^\S\n]*%%\{[\s\S]*?\}%%/ :meta ;

@grammar

(** A chart is `xychart` (or `xychart-beta`), then statements. The header may come more than
once before the first statement; the last orientation given wins. *)
xychart = { eol | Header } document ;
Header @Header = XYCHART [ CHART_ORIENTATION ] ;

document = { statement { eol } } ;
eol = NEWLINE | SEMI | EOF ;

statement = Title
  | XAxis
  | YAxis
  | Plot
  | AccTitle
  | AccDescr ;

(** `title <text>`: the chart title. The last one wins. *)
Title @Title = title text ;

(** `x-axis [<title>] [<a>, <b>, …]` (categories) or `x-axis [<title>] <min> --> <max>` (a
range), or just a title. Without data, the x axis is the range `1 --> n` of the first plot's n
values. *)
XAxis @Axis = X_AXIS ( text [ xAxisData ] | xAxisData ) ;
xAxisData = band | range ;
band = SQUARE_BRACES_START text { COMMA text } SQUARE_BRACES_END ;
range = NUMBER_WITH_DECIMAL ARROW_DELIMITER NUMBER_WITH_DECIMAL ;

(** `y-axis [<title>] <min> --> <max>`, or just a title. Without a range, the y axis spans the
plots' values. *)
YAxis @Axis = Y_AXIS ( text [ range ] | range ) ;

(** `bar [<name>] [<v>, <v>, …]` or `line [<name>] [<v>, …]`: a plot. A value may carry a point
label, `line [5 "peak", 6]` (drawn for lines only). A named plot gets a legend entry. *)
Plot @Plot = ( LINE | BAR ) [ text ] SQUARE_BRACES_START dataPoint { COMMA dataPoint }
  SQUARE_BRACES_END ;
dataPoint = NUMBER_WITH_DECIMAL [ STR ] ;

(** `accTitle: …`: the accessible title of the chart. *)
AccTitle @AccTitle = acc_title acc_title_value ;
(** `accDescr: …` or `accDescr { … }`: the accessible description of the chart. *)
AccDescr @AccDescr = acc_descr acc_descr_value | acc_descr_multiline_value ;

(** Text: a run of words, digits and `+ = * # _ . & -`, one space where blanks separate them,
or a quoted string. *)
text = alphaNumToken { alphaNumToken } | STR ;
alphaNumToken = AMP | NUM | ALPHA | PLUS | EQUALS | MULT | DOT | BRKT | MINUS | UNDERSCORE ;

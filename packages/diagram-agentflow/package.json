{
  "name": "@mermaid-js/diagram-agentflow",
  "version": "0.0.0",
  "private": true,
  "description": "Agentflow diagram plugin for Mermaid: lexer, parser, model and semantic model (layout and renderer to follow).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mermaid-js/mermaid-v13",
    "directory": "packages/diagram-agentflow"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "mermaid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "port:v12-specs": "tsx scripts/port-v12-specs.ts && prettier --write src/v12-specs"
  },
  "peerDependencies": {
    "@mermaid-js/core": "workspace:*"
  },
  "devDependencies": {
    "@mermaid-js/core": "workspace:^"
  }
}

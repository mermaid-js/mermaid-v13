{
  "name": "@mermaid-js/diagram-agentflow",
  "version": "13.0.0-alpha.2",
  "description": "Agentflow diagram plugin for Mermaid: lexer, parser, model, semantic model, layout, SVG renderer, text output and language facet.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mermaid-js/mermaid-v13",
    "directory": "packages/diagram-agentflow"
  },
  "sideEffects": false,
  "exports": {
    "./testing": {
      "mermaid-source": "./src/testing.ts"
    },
    ".": {
      "mermaid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ascii": {
      "mermaid-source": "./src/ascii.ts",
      "types": "./dist/ascii.d.ts",
      "default": "./dist/ascii.js"
    },
    "./language": {
      "mermaid-source": "./src/language.ts",
      "types": "./dist/language.d.ts",
      "default": "./dist/language.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "port:v12-specs": "tsx scripts/port-v12-specs.ts && prettier --write src/v12-specs"
  },
  "peerDependencies": {
    "@mermaid-js/core": "workspace:*",
    "@mermaid-js/shared": "workspace:*"
  },
  "devDependencies": {
    "@mermaid-js/core": "workspace:^",
    "@mermaid-js/shared": "workspace:^"
  },
  "mermaid": {
    "plugin": "diagram",
    "id": "agentflow",
    "types": [
      "agentflow"
    ],
    "formats": [
      "svg",
      "ascii"
    ],
    "export": "agentflow",
    "ascii": "./dist/ascii.js",
    "language": "./dist/language.js"
  }
}

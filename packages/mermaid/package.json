{
  "name": "mermaid",
  "version": "13.0.0-alpha.2",
  "description": "Markdown-ish syntax for generating flowcharts and other diagrams.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mermaid-js/mermaid-v13",
    "directory": "packages/mermaid"
  },
  "sideEffects": [
    "./src/index.ts",
    "./src/node.ts",
    "./dist/index.js",
    "./dist/node.js",
    "./dist/mermaid.esm.min.mjs",
    "./dist/mermaid.min.js"
  ],
  "exports": {
    ".": {
      "mermaid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "node": "./dist/node.js",
      "default": "./dist/index.js"
    },
    "./slim": {
      "mermaid-source": "./src/slim.ts",
      "types": "./dist/slim.d.ts",
      "default": "./dist/slim.js"
    },
    "./discovered": {
      "mermaid-source": "./src/discovered.ts",
      "types": "./dist/discovered.d.ts",
      "default": "./dist/discovered.js"
    },
    "./node-scan": {
      "mermaid-source": "./src/node-scan.ts",
      "types": "./dist/node-scan.d.ts",
      "node": "./dist/node-scan.js"
    }
  },
  "unpkg": "./dist/mermaid.min.js",
  "jsdelivr": "./dist/mermaid.min.js",
  "bin": {
    "mermaid": "./dist/cli.js"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/cdn-build.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mermaid-js/core": "workspace:*",
    "@mermaid-js/diagram-class": "workspace:*",
    "@mermaid-js/diagram-cynefin": "workspace:*",
    "@mermaid-js/diagram-er": "workspace:*",
    "@mermaid-js/diagram-eventmodeling": "workspace:*",
    "@mermaid-js/diagram-flowchart": "workspace:*",
    "@mermaid-js/diagram-gantt": "workspace:*",
    "@mermaid-js/diagram-gitgraph": "workspace:*",
    "@mermaid-js/diagram-info": "workspace:*",
    "@mermaid-js/diagram-ishikawa": "workspace:*",
    "@mermaid-js/diagram-journey": "workspace:*",
    "@mermaid-js/diagram-kanban": "workspace:*",
    "@mermaid-js/diagram-mindmap": "workspace:*",
    "@mermaid-js/diagram-packet": "workspace:*",
    "@mermaid-js/diagram-pie": "workspace:*",
    "@mermaid-js/diagram-quadrant": "workspace:*",
    "@mermaid-js/diagram-radar": "workspace:*",
    "@mermaid-js/diagram-sankey": "workspace:*",
    "@mermaid-js/diagram-sequence": "workspace:*",
    "@mermaid-js/diagram-state": "workspace:*",
    "@mermaid-js/diagram-timeline": "workspace:*",
    "@mermaid-js/diagram-treemap": "workspace:*",
    "@mermaid-js/diagram-venn": "workspace:*",
    "@mermaid-js/diagram-wardley": "workspace:*",
    "@mermaid-js/diagram-xychart": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6"
  }
}

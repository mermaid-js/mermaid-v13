{
  "name": "@mermaid-js/conformance",
  "version": "0.0.0",
  "private": true,
  "description": "Parity oracle against mermaid@12, corpus runners and normalisers.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "oracle": "vitest run --root ../.. packages/conformance/src/parity.spec.ts",
    "oracle:report": "tsx --conditions=mermaid-source src/cli/oracle-report.ts",
    "harvest": "tsx --conditions=mermaid-source src/cli/harvest.ts",
    "fuzz": "tsx --conditions=mermaid-source src/cli/fuzz.ts",
    "smoke": "tsx --conditions=mermaid-source src/cli/smoke.ts",
    "harvest:pie": "tsx --conditions=mermaid-source src/cli/harvest-v12.ts pie",
    "harvest:gitgraph": "tsx --conditions=mermaid-source src/cli/harvest-gitgraph.ts",
    "harvest:cynefin": "tsx --conditions=mermaid-source src/cli/harvest-v12.ts cynefin",
    "harvest:packet": "tsx --conditions=mermaid-source src/cli/harvest-v12.ts packet",
    "harvest:info": "tsx --conditions=mermaid-source src/cli/harvest-v12.ts info",
    "harvest:radar": "tsx --conditions=mermaid-source src/cli/harvest-v12.ts radar",
    "harvest:treemap": "tsx --conditions=mermaid-source src/cli/harvest-v12.ts treemap",
    "harvest:wardley": "tsx --conditions=mermaid-source src/cli/harvest-v12.ts wardley"
  },
  "devDependencies": {
    "@asamuzakjp/css-color": "3.2.0",
    "@braintree/sanitize-url": "7.1.2",
    "@mermaid-js/core": "workspace:^",
    "@mermaid-js/diagram-class": "workspace:^",
    "@mermaid-js/diagram-cynefin": "workspace:^",
    "@mermaid-js/diagram-er": "workspace:^",
    "@mermaid-js/diagram-flowchart": "workspace:^",
    "@mermaid-js/diagram-gantt": "workspace:^",
    "@mermaid-js/diagram-gitgraph": "workspace:^",
    "@mermaid-js/diagram-info": "workspace:^",
    "@mermaid-js/diagram-journey": "workspace:^",
    "@mermaid-js/diagram-kanban": "workspace:^",
    "@mermaid-js/diagram-mindmap": "workspace:^",
    "@mermaid-js/diagram-packet": "workspace:^",
    "@mermaid-js/diagram-pie": "workspace:^",
    "@mermaid-js/diagram-quadrant": "workspace:^",
    "@mermaid-js/diagram-radar": "workspace:^",
    "@mermaid-js/diagram-sequence": "workspace:^",
    "@mermaid-js/diagram-state": "workspace:^",
    "@mermaid-js/diagram-timeline": "workspace:^",
    "@mermaid-js/diagram-treemap": "workspace:^",
    "@mermaid-js/diagram-wardley": "workspace:^",
    "@mermaid-js/diagram-xychart": "workspace:^",
    "@mermaid-js/gen-grammar": "workspace:^",
    "@mermaid-js/language-service": "workspace:^",
    "@mermaid-js/layout-elk": "workspace:^",
    "@mermaid-js/plugin-math": "workspace:^",
    "@types/js-yaml": "^4.0.9",
    "entities": "8.1.0",
    "js-yaml": "^4.3.2",
    "mermaid": "workspace:*",
    "mermaid-parser-v12": "npm:@mermaid-js/parser@2.0.1",

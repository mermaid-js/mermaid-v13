@ 3:9  Alice-|>>Alice: z
  -->> operator (dotted line, arrowhead) 3:8-3:11 "->>" -> "-->>"
  -> operator (solid line, no arrowhead) 3:8-3:11 "->>" -> "->"
  --> operator (dotted line, no arrowhead) 3:8-3:11 "->>" -> "-->"
  -x operator (solid line, a cross at the end) 3:8-3:11 "->>" -> "-x"
  --x operator (dotted line, a cross at the end) 3:8-3:11 "->>" -> "--x"
  -) operator (solid line, an open arrowhead (async)) 3:8-3:11 "->>" -> "-)"
  --) operator (dotted line, an open arrowhead (async)) 3:8-3:11 "->>" -> "--)"
  -|\ operator (solid line, solid half arrowhead on the top) 3:8-3:11 "->>" -> "-|\\"
  -|/ operator (solid line, solid half arrowhead on the bottom) 3:8-3:11 "->>" -> "-|/"
  -\\ operator (solid line, open half arrowhead on the top) 3:8-3:11 "->>" -> "-\\\\"
  -// operator (solid line, open half arrowhead on the bottom) 3:8-3:11 "->>" -> "-//"
  --|\ operator (dotted line, solid half arrowhead on the top) 3:8-3:11 "->>" -> "--|\\"
  --|/ operator (dotted line, solid half arrowhead on the bottom) 3:8-3:11 "->>" -> "--|/"
  --\\ operator (dotted line, open half arrowhead on the top) 3:8-3:11 "->>" -> "--\\\\"
  --// operator (dotted line, open half arrowhead on the bottom) 3:8-3:11 "->>" -> "--//"

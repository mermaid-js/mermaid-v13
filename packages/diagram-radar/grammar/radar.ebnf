(** Radar chart syntax (R-PARSE-9, D54): the normative grammar of `radar-beta` diagrams.

The hand-written parser in `src/parser/` implements it; `tools/gen-grammar` builds a reference
parser, a sentence generator, highlighters and the syntax reference page from it. mermaid@12
decides what is valid, this file is fixed to match, and the parser must match this file
(DESIGN §4.4). mermaid@12 parsed radar with Langium (`radar.langium` and `common.langium` in
`@mermaid-js/parser`); the rules below are its token rules, in its order, and its grammar.

**Lexer input.** The lexer reads the diagram body as mermaid@12 handed it to its lexer: front
matter and `%%{…}%%` directives removed; CRLF and CR read as LF; `="x"` inside an HTML tag read
as `='x'`; `%%` comment lines removed and leading blanks trimmed; on a line with
`style…:…#…;` (or `classDef…`) the last `;` dropped; `#name;` / `#123;` entities read as
opaque text; and a line break appended. Keywords are case-sensitive.

A word keyword gives way to a longer name (`maxi`, `axisB` and `min-1` are names), but
`circle`, `polygon`, `true`, `false` and `title` do not: `circles` is `circle` and the name
`s`, so no name can start with them (D357). Statements need no separator, except that
`title`, `accTitle` and `accDescr` end their line; `;` is not a separator. *)

@lexer

(** `radar-beta:`: starts a radar chart, as `radar-beta` does. *)
RADAR_BETA_COLON          /radar-beta:/                    :keyword ;
(** `radar-beta`: starts a radar chart. `radar-beta:` and `radar-beta :` do too. *)
RADAR_BETA                /radar-beta(?:(?=%%)|(?!\S))/    :keyword ;
(** `showLegend true|false`: whether the legend lists the curves (default `true`; the last
one wins, as for every option). *)
SHOW_LEGEND               /showLegend(?!-*\w)/             :keyword ;
(** `graticule circle|polygon`: the shape of the rings and of the curves (default
`circle`). *)
GRATICULE                 /graticule(?!-*\w)/              :keyword ;
(** `curve c["Label"]{1, 2, 3}`: a curve, its values in axis order or as `axis: value`
pairs. *)
CURVE                     /curve(?!-*\w)/                  :keyword ;
(** `ticks 5`: the number of rings (default 5, at most 32). *)
TICKS                     /ticks(?!-*\w)/                  :keyword ;
(** `axis A["Label"], B`: the axes, in clockwise order from the top. *)
AXIS                      /axis(?!-*\w)/                   :keyword ;
(** `max 10`: the value at the outer ring (default: the largest value). *)
MAX                       /max(?!-*\w)/                    :keyword ;
(** `min 0`: the value at the centre (default 0). *)
MIN                       /min(?!-*\w)/                    :keyword ;
COLON                     /:/                              :punctuation ;
COMMA                     /,/                              :punctuation ;
LBRACKET                  /\[/                             :punctuation ;
RBRACKET                  /\]/                             :punctuation ;
LBRACE                    /\{/                             :punctuation ;
RBRACE                    /\}/                             :punctuation ;
(** `circle` or `polygon`, the value of `graticule`. *)
GRATICULE_VALUE           /circle|polygon/                 :keyword ;
(** `true` or `false`, the value of `showLegend`. *)
BOOLEAN                   /true|false/                     :keyword ;
(** `accDescr: …` (the rest of the line) or `accDescr { … }` (over lines, to `}`): the accessible
description of the chart. mermaid@12's one rule, as two tried in order; the block's
`[\s\S]*?\}` is its `[^}]*\}`, written so that line-based highlighters read the block as one span. *)
ACC_DESCR                 /[\t ]*accDescr[\t ]*:(?:[^\n\r]*?(?=%%)|[^\n\r]*)/ :keyword ;
ACC_DESCR                 /[\t ]*accDescr\s*\{[\s\S]*?\}/ :keyword ;
(** `accTitle: …`: the accessible title of the chart, the rest of the line. *)
ACC_TITLE                 /[\t ]*accTitle[\t ]*:(?:[^\n\r]*?(?=%%)|[^\n\r]*)/ :keyword ;
(** `title …`: the title drawn at the top of the chart, the rest of the line. *)
TITLE                     /[\t ]*title(?:[\t ][^\n\r]*?(?=%%)|[\t ][^\n\r]*|)/ :keyword ;
(** A value: a number such as `42` or `3.5`, never negative; no sign, no exponent, no leading
zeros and no `.` without digits on both sides. *)
NUMBER                    /[0-9]+\.[0-9]+(?!\.)|0|[1-9][0-9]*(?!\.)/ :number ;
(** A label: `"…"` or `'…'`; `\` escapes the next character, and a label may span lines. *)
STRING                    /"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'/ :string ;
(** A name: ASCII letters, digits, `_` and `-`, not ending in `-`. *)
ID                        /\w(?:[-\w]*\w)?/                :variable ;
NEWLINE                   /\r?\n/ ;
-                         /[\t ]+/ ;
(** A `---` … `---` block inside the body: skipped. *)
YAML                      /---[\t ]*\r?\n(?:[\S\s]*?\r?\n)?---(?:\r?\n|(?!\S))/ :meta ;
(** A `%%{…}%%` left in the text the lexer reads: skipped. *)
DIRECTIVE                 /[\t ]*%%\{[\S\s]*?\}%%(?:\r?\n|(?!\S))/ :meta ;
(** `%%` to the end of the line, after other text: a comment. *)
COMMENT                   /[\t ]*%%[^\n\r]*/              :comment ;
(** The end of the text. *)
EOF                       /$/ ;

@trivia

(** Removed before lexing (see the lexer input); listed for the highlighters. A comment is a
whole line; both take their leading blanks. *)
COMMENT                   /^[^\S\n]*%%(?!\{)[^\n]+/         :comment ;
(** From `%%{` to the first `}%%`, over line breaks (core preprocess). *)
DIRECTIVE                 /[^\S\n]*%%\{[\s\S]*?\}%%/        :meta ;

@grammar

(** A chart is `radar-beta`, then statements. `title`, `accTitle` and `accDescr` end their line;
the others may share one. The `YAML`, `DIRECTIVE` and `COMMENT` tokens of the lexer are
skipped before parsing. *)
radar = { NEWLINE } Header { NEWLINE | list | text NEWLINE } [ text ] EOF ;
Header @Header = RADAR_BETA_COLON | RADAR_BETA [ COLON ] ;

list = AXIS Axis { COMMA Axis } | CURVE Curve { COMMA Curve } | Option { COMMA Option } ;
text = Title | AccTitle | AccDescr ;

(** `A["Label"]`: an axis, its name and its label (the name when there is none). *)
Axis @Axis = ID [ LBRACKET STRING RBRACKET ] ;
(** `c["Label"]{1, 2, 3}` or `c{A: 1, B: 2}`: a curve. Its values are all positional, in axis
order, or all `axis: value` pairs (the `:` is optional); line breaks may follow `{` and `,` and
come before `}`. *)
Curve @Curve = ID [ LBRACKET STRING RBRACKET ] LBRACE entries RBRACE ;
entries = { NEWLINE } NumberEntry { COMMA { NEWLINE } NumberEntry } { NEWLINE }
        | { NEWLINE } DetailedEntry { COMMA { NEWLINE } DetailedEntry } { NEWLINE } ;
NumberEntry @Entry = NUMBER ;
DetailedEntry @Entry = ID [ COLON ] NUMBER ;
(* An option: the last of each name wins. Each keyword's doc is in the lexer section. *)
Option @Option = SHOW_LEGEND BOOLEAN | TICKS NUMBER | MAX NUMBER | MIN NUMBER
               | GRATICULE GRATICULE_VALUE ;
(** `title Skills`: the title drawn at the top (the last one wins). *)
Title @Title = TITLE ;
(** `accTitle: …`: the accessible title. *)
AccTitle @AccTitle = ACC_TITLE ;
(** `accDescr: …` or `accDescr { … }`: the accessible description. *)
AccDescr @AccDescr = ACC_DESCR ;

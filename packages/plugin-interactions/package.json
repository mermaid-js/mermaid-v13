{
  "name": "@mermaid-js/plugin-interactions",
  "version": "13.0.0-alpha.3",
  "description": "Mermaid extension plugin restoring v12 click callbacks and actor menus (DESIGN §12.3).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mermaid-js/mermaid-v13",
    "directory": "packages/plugin-interactions"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "mermaid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@mermaid-js/core": "workspace:*",
    "@mermaid-js/shared": "workspace:*"
  },
  "devDependencies": {
    "@mermaid-js/core": "workspace:^",
    "mermaid": "workspace:*",
    "@mermaid-js/shared": "workspace:^"
  },
  "mermaid": {
    "plugin": "extension",
    "id": "interactions",
    "entry": "./dist/index.js",
    "export": "interactions"
  }
}

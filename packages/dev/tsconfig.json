{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // src/browser runs in the page; the server, gallery builder and specs run in Node.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  // The ambient declarations its plugins' sources import: layout-elk's for elkjs's untyped worker
  // build, plugin-hand-drawn's for roughjs's ES module bundle.
  "include": ["src", "../layout-elk/src/elk-worker.d.ts", "../plugin-hand-drawn/src/roughjs.d.ts"]
}

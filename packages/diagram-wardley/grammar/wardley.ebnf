(** Wardley map syntax (R-PARSE-9, D54): the normative grammar of `wardley-beta` diagrams.

The hand-written parser in `src/parser/` implements it; `tools/gen-grammar` builds a reference
parser, a sentence generator, highlighters and the syntax reference page from it. mermaid@12
decides what is valid, this file is fixed to match, and the parser must match this file
(DESIGN §4.4). mermaid@12 parsed Wardley maps with Langium (`wardley.langium` and
`common.langium` in `@mermaid-js/parser`); the rules below are its token rules, in its order,
and its grammar.

**Lexer input.** The lexer reads the diagram body as mermaid@12 handed it to its lexer: front
matter and `%%{…}%%` directives removed; CRLF and CR read as LF; `="x"` inside an HTML tag read
as `='x'`; `%%` comment lines removed and leading blanks trimmed; on a line with
`style…:…#…;` (or `classDef…`) the last `;` dropped; `#name;` / `#123;` entities read as
opaque text; and a line break appended. Keywords are case-sensitive.

The first rule that matches wins, and no keyword gives way to a longer name: `notebook` is
`note` and the name `book`, `buyer` is `buy` and `er`, so no unquoted name can start with a
keyword or a strategy (D423); quote such names. A name is words of letters, digits, `_`, `&`,
`(`, `)` and `-`, separated by blanks: `Cup of Tea` is one name. Each statement ends its line,
except that `wardley-beta` may share its line with the first one.

Coordinates are `[visibility, evolution]`, each a decimal with a `.`: up to 1 a fraction of
the axis (`0.5` is half way, `1.0` is the end), above 1 a percentage (`1.5` is 1.5 %, D428),
above 100 an error. A stage's `@boundary` is a fraction of the axis, whatever its value. *)

@lexer

LBRACKET                  /\[/                             :punctuation ;
COMMA                     /,/                              :punctuation ;
RBRACKET                  /\]/                             :punctuation ;
AT                        /@/                              :punctuation ;
SLASH                     /\//                             :punctuation ;
LPAREN                    /\(/                             :punctuation ;
RPAREN                    /\)/                             :punctuation ;
(** `-` before a label offset: `label [-10, 5]`. A `->`, `-->`, `-.->` or `---` block starting
here is that token instead (mermaid@12's longer alternatives of `-`). *)
DASH                      /-(?!>|->|\.->|--[\t ]*\r?\n(?:[\S\s]*?\r?\n)?---(?:\r?\n|(?!\S)))/ :operator ;
LBRACE                    /\{/                             :punctuation ;
RBRACE                    /\}/                             :punctuation ;
(** A coordinate or boundary: a decimal such as `0.5`, with digits on both sides of its `.`. A
coordinate up to 1 is a fraction of the axis, above 1 a percentage; a stage boundary is always
a fraction, drawn clamped to [0, 1] (D424). *)
DECIMAL                   /[0-9]+\.[0-9]+/                 :number ;
(** `->`: a link from one component to another, or the next evolution stage. *)
ARROW                     /->/                             :operator ;
(** `+>`, `+<` or `+<>`: a flow along a link (forward, backward or both ways), after either
name. *)
LINK_PORT                 /\+<>|\+>|\+</                   :operator ;
(** A link's arrow: `-->`, `-.->` (dashed) or `>`, or a labelled flow such as `+'label'>`,
`+'label'<` or `+'label'<>`. *)
LINK_ARROW                /-->|-\.->|>|\+'[^']*'<>|\+'[^']*'<|\+'[^']*'>/ :operator ;
(** `; label`: a link's label, the rest of the line. *)
LINK_LABEL                /;[^\n\r]+/                      :string ;
(** `(build)`, `(buy)`, `(outsource)` or `(market)` after a component: how it is sourced. *)
STRATEGY                  /build|buy|outsource|market/     :keyword ;
(** `wardley-beta`: starts a Wardley map. *)
WARDLEY_BETA              /wardley-beta/                   :keyword ;
(** `size [1100, 800]`: the map's width and height in pixels (the last one wins). *)
SIZE                      /size/                           :keyword ;
(** `evolution Genesis -> Custom -> Product -> Commodity`: the stages along the evolution
axis, at least two; `Name@0.3` sets where a stage ends, `Name / Second` gives it two names. *)
EVOLUTION                 /evolution/                      :keyword ;
(** `anchor User [0.95, 0.5]`: a user or need the map starts from, at `[visibility,
evolution]`. *)
ANCHOR                    /anchor/                         :keyword ;
(** `component Tea [0.8, 0.6]`: a component at `[visibility, evolution]`, then optionally
`label [x, y]`, a strategy such as `(build)`, and `inertia`. Inside a pipeline it has only its
evolution: `component Gas [0.3]`. *)
COMPONENT                 /component/                      :keyword ;
(** `label [x, y]`: moves a component's label by `x`, `y` pixels. *)
LABEL                     /label/                          :keyword ;
(** `inertia` or `(inertia)` after a component: it resists change. *)
INERTIA                   /inertia/                        :keyword ;
(** `evolve Kettle 0.8`: the evolution a component is moving to (the last one per component
wins). *)
EVOLVE                    /evolve/                         :keyword ;
(** `pipeline Kettle { … }`: the components of a pipeline, one per line, each `component Name
[evolution]` on the parent's visibility. *)
PIPELINE                  /pipeline/                       :keyword ;
(** `note "text" [0.3, 0.5]`: a note on the map. *)
NOTE                      /note/                           :keyword ;
(** `annotations [0.1, 0.9]`: where the box that lists the annotations goes (the first one
wins). *)
ANNOTATIONS               /annotations/                    :keyword ;
(** `annotation 1, [0.5, 0.5] "text"`: a numbered marker on the map, listed in the box. *)
ANNOTATION                /annotation/                     :keyword ;
(** `accelerator Cloud [0.5, 0.8]`: a force that speeds evolution up. *)
ACCELERATOR               /accelerator/                    :keyword ;
(** `deaccelerator Legacy [0.5, 0.3]`: a force that slows evolution down. *)
DEACCELERATOR             /deaccelerator/                  :keyword ;
(** A name: words of ASCII letters, digits, `_`, `&`, `(`, `)` and `-` (not before `>`),
separated by blanks; never starting with `title` and a blank, `accTitle` or `accDescr`. *)
NAME                      /(?!title\s|accTitle|accDescr)[A-Za-z](?:[A-Za-z0-9_()&]|-(?!>))*(?:[\t ]+[A-Za-z(](?:[A-Za-z0-9_()&]|-(?!>))*)*/ :variable ;
-                         /[\t ]+/ ;
(** `accDescr: …` (the rest of the line) or `accDescr { … }` (over lines, to `}`): the accessible
description of the map. mermaid@12's one rule, as two tried in order; the block's
`[\s\S]*?\}` is its `[^}]*\}`, written so that line-based highlighters read the block as one span. *)
ACC_DESCR                 /[\t ]*accDescr[\t ]*:(?:[^\n\r]*?(?=%%)|[^\n\r]*)/ :keyword ;
ACC_DESCR                 /[\t ]*accDescr\s*\{[\s\S]*?\}/ :keyword ;
(** `accTitle: …`: the accessible title of the map, the rest of the line. *)
ACC_TITLE                 /[\t ]*accTitle[\t ]*:(?:[^\n\r]*?(?=%%)|[^\n\r]*)/ :keyword ;
(** `title …`: the title drawn at the top of the map, the rest of the line. *)
TITLE                     /[\t ]*title(?:[\t ][^\n\r]*?(?=%%)|[\t ][^\n\r]*|)/ :keyword ;
(** A whole number such as `10`: a size, a label offset, an annotation's number, or an
annotation coordinate (`1` is 100 %); no leading zeros. *)
INT                       /0|[1-9][0-9]*(?!\.)/            :number ;
(** A quoted name or text: `"…"` or `'…'`; `\` escapes the next character, and it may span
lines. *)
STRING                    /"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'/ :string ;
(** A name of ASCII letters, digits, `_` and `-` that no other rule reads (one that starts
with `_`, or `accTitleX`). *)
ID                        /\w(?:[-\w]*\w)?/                :variable ;
NEWLINE                   /\r?\n/ ;
(** A `---` … `---` block inside the body: skipped. *)
YAML                      /---[\t ]*\r?\n(?:[\S\s]*?\r?\n)?---(?:\r?\n|(?!\S))/ :meta ;
(** A `%%{…}%%` left in the text the lexer reads: skipped. *)
DIRECTIVE                 /[\t ]*%%\{[\S\s]*?\}%%(?:\r?\n|(?!\S))/ :meta ;
(** `%%` to the end of the line, after other text: a comment. *)
COMMENT                   /[\t ]*%%[^\n\r]*/              :comment ;
(** The end of the text. *)
EOF                       /$/ ;

@trivia

(** Removed before lexing (see the lexer input); listed for the highlighters. A comment is a
whole line; both take their leading blanks. *)
COMMENT                   /^[^\S\n]*%%(?!\{)[^\n]+/         :comment ;
(** From `%%{` to the first `}%%`, over line breaks (core preprocess). *)
DIRECTIVE                 /[^\S\n]*%%\{[\s\S]*?\}%%/        :meta ;

@grammar

(** A map is `wardley-beta`, then statements, each on a line of its own (the first may share
the header's line). The `YAML`, `DIRECTIVE` and `COMMENT` tokens of the lexer are skipped
before parsing. *)
wardley = { NEWLINE } Header { NEWLINE | statement NEWLINE } [ statement ] EOF ;
Header @Header = WARDLEY_BETA ;
statement = Size | Evolution | Anchor | Component | Link | Evolve | Pipeline | Note
          | Annotations | Annotation | Accelerator | Deaccelerator | Title | AccTitle | AccDescr ;

name = STRING | ID | NAME ;
(** `[visibility, evolution]`, both decimals. *)
coordinates = LBRACKET DECIMAL COMMA DECIMAL RBRACKET ;
coordinate = DECIMAL | INT ;
labelOffset = LABEL LBRACKET [ DASH ] INT COMMA [ DASH ] INT RBRACKET ;

(** `size [width, height]`, whole pixels. *)
Size @Size = SIZE LBRACKET INT COMMA INT RBRACKET ;
(** `evolution A -> B -> …`: the stage names, each with an optional `@boundary` and `/ name`. *)
Evolution @Evolution = EVOLUTION stage ARROW stage { ARROW stage } ;
stage = name [ AT DECIMAL ] [ SLASH name ] ;
Anchor @Anchor = ANCHOR name coordinates ;
(** `component Name [visibility, evolution]`, then `label [x, y]`, a strategy and `inertia`,
in that order, each optional. *)
Component @Component = COMPONENT name coordinates [ labelOffset ] [ LPAREN STRATEGY RPAREN ]
                       [ INERTIA | LPAREN INERTIA RPAREN ] ;
(** `A -> B`: a link, with optional flows after either name and a `; label`. Without an arrow
the names must be quoted (`"A" "B"`), since unquoted words run into one name. *)
Link @Link = name [ LINK_PORT ] [ LINK_ARROW | ARROW ] name [ LINK_PORT ] [ LINK_LABEL ] ;
Evolve @Evolve = EVOLVE name DECIMAL ;
(** `pipeline Parent {`, then at least one component per line, then `}` on its own line. *)
Pipeline @Pipeline = PIPELINE name LBRACE NEWLINE { NEWLINE } PipelineComponent NEWLINE
                     { NEWLINE } { PipelineComponent NEWLINE { NEWLINE } } RBRACE ;
PipelineComponent @PipelineComponent = COMPONENT name LBRACKET DECIMAL RBRACKET [ labelOffset ] ;
Note @Note = NOTE STRING coordinates ;
Annotations @Annotations = ANNOTATIONS LBRACKET coordinate COMMA coordinate RBRACKET ;
Annotation @Annotation = ANNOTATION INT COMMA LBRACKET coordinate COMMA coordinate RBRACKET STRING ;
Accelerator @Accelerator = ACCELERATOR name coordinates ;
Deaccelerator @Deaccelerator = DEACCELERATOR name coordinates ;
(** `title Tea Shop`: the title drawn at the top (the last one wins). *)
Title @Title = TITLE ;
(** `accTitle: …`: the accessible title. *)
AccTitle @AccTitle = ACC_TITLE ;
(** `accDescr: …` or `accDescr { … }`: the accessible description. *)
AccDescr @AccDescr = ACC_DESCR ;

      "name": "keyword.control.mermaid-wardley"
    },
    "rule-33": {
      "begin": "[\\t ]*accDescr\\s*\\{",
      "end": "\\}",
      "name": "keyword.control.mermaid-wardley"
    },
    "rule-34": {
      "match": "[\\t ]*accTitle[\\t ]*:(?:[^\\n\\r]*?(?=%%)|[^\\n\\r]*)",
      "name": "keyword.control.mermaid-wardley"
    },
    "rule-35": {
      "match": "[\\t ]*title(?:[\\t ][^\\n\\r]*?(?=%%)|[\\t ][^\\n\\r]*|)",
      "name": "keyword.control.mermaid-wardley"
    },
    "rule-36": {
      "match": "0|[1-9][0-9]*(?!\\.)",
      "name": "constant.numeric.mermaid-wardley"
    },
    "rule-37": {
      "match": "\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'",
      "name": "string.quoted.mermaid-wardley"
    },
    "rule-38": {
      "match": "\\w(?:[-\\w]*\\w)?",
      "name": "variable.other.mermaid-wardley"
    },
    "rule-39": {
      "match": "\\r?\\n"
    },
    "rule-40": {
      "match": "---[\\t ]*\\r?\\n(?:[\\S\\s]*?\\r?\\n)?---(?:\\r?\\n|(?!\\S))",
      "name": "meta.embedded.mermaid-wardley"
    },
    "rule-41": {
      "match": "[\\t ]*%%\\{[\\S\\s]*?\\}%%(?:\\r?\\n|(?!\\S))",
      "name": "meta.embedded.mermaid-wardley"
    },
    "rule-42": {
      "match": "[\\t ]*%%[^\\n\\r]*",
      "name": "comment.line.mermaid-wardley"
    },

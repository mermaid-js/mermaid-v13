  "repository": {
    "trivia-0": {
      "match": "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
      "name": "comment.line.mermaid-wardley"
    },
    "trivia-1": {
      "begin": "[^\\S\\n]*%%\\{",
      "end": "\\}%%",
      "name": "meta.embedded.mermaid-wardley"
    },
    "rule-0": {
      "match": "\\[",
      "name": "punctuation.definition.mermaid-wardley"
    },
    "rule-1": {
      "match": ",",
      "name": "punctuation.definition.mermaid-wardley"
    },
    "rule-2": {
      "match": "\\]",
      "name": "punctuation.definition.mermaid-wardley"
    },
    "rule-3": {
      "match": "@",
      "name": "punctuation.definition.mermaid-wardley"
    },

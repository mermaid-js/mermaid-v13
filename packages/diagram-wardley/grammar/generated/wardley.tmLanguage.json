      "name": "keyword.control.mermaid-wardley"
    },
    "rule-30": {
      "match": "(?!title\\s|accTitle|accDescr)[A-Za-z](?:[A-Za-z0-9_()&]|-(?!>))*(?:[\\t ]+[A-Za-z(](?:[A-Za-z0-9_()&]|-(?!>))*)*",
      "name": "variable.other.mermaid-wardley"
    },
    "rule-31": {

    },
    "rule-21": {
      "match": "title(?!\\w|-\\w)[^\\n\\r]*?(?=%%|[\\r\\n]|$)",
      "name": "keyword.control.mermaid-c4beta"
    },
    "rule-22": {
      "match": "accTitle(?!\\w|-\\w)[\\t ]*:[^\\n\\r]*?(?=%%|[\\r\\n]|$)",
      "name": "keyword.control.mermaid-c4beta"
    },
    "rule-23": {
      "match": "accDescr(?!\\w|-\\w)[\\t ]*:[^\\n\\r]*?(?=%%|[\\r\\n]|$)",
      "name": "keyword.control.mermaid-c4beta"
    },
    "rule-24": {
      "begin": "accDescr(?!\\w|-\\w)\\s*\\{",
      "end": "\\}",
      "name": "keyword.control.mermaid-c4beta"
    },
    "rule-25": {
      "match": "-->",
      "name": "keyword.operator.mermaid-c4beta"
    },
    "rule-26": {
      "match": "<--(?!>)",
      "name": "keyword.operator.mermaid-c4beta"
    },
    "rule-27": {
      "match": "<-->",
      "name": "keyword.operator.mermaid-c4beta"
    },
    "rule-28": {
      "match": "---(?![->])",
      "name": "keyword.operator.mermaid-c4beta"
    },
    "rule-29": {
      "match": ":::[A-Za-z0-9_]+(?:-[A-Za-z0-9_]+)*",
      "name": "variable.other.mermaid-c4beta"
    },
    "rule-30": {
      "match": ":",
      "name": "punctuation.definition.mermaid-c4beta"
    },
    "rule-31": {
      "match": ",",
      "name": "punctuation.definition.mermaid-c4beta"
    },
    "rule-32": {
      "match": "\\{",
      "name": "punctuation.definition.mermaid-c4beta"
    },
    "rule-33": {
      "match": "\\}",
      "name": "punctuation.definition.mermaid-c4beta"
    },
    "rule-34": {
      "match": "(?<=(?:^|[\\n\\r])[\\t ]*)[0-9]+(?=[\\t ]*:)",
      "name": "constant.language.mermaid-c4beta"
    },
    "rule-35": {
      "match": "#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{3})(?!\\w)",
      "name": "constant.language.mermaid-c4beta"
    },
    "rule-36": {
      "match": "\"(?:[^\"\\\\\\r\\n]|\\\\.)*\"|'(?:[^'\\\\\\r\\n]|\\\\.)*'",
      "name": "string.quoted.mermaid-c4beta"
    },
    "rule-37": {
      "match": "(?!(?:accTitle|accDescr)(?!\\w|-\\w))[A-Za-z0-9_]+(?:-[A-Za-z0-9_]+)*",
      "name": "variable.other.mermaid-c4beta"
    },
    "rule-38": {
      "match": "\\r\\n|\\n|\\r"
    },
    "rule-39": {
      "match": "[\\t ]+"
    },
    "rule-40": {
      "match": "%%[^\\n\\r]*",
      "name": "comment.line.mermaid-c4beta"
    },

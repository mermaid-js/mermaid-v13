(** C4 syntax (R-PARSE-9, D54): the normative grammar of `C4Context`, `C4Container`,
`C4Component`, `C4Dynamic` and `C4Deployment` diagrams.

The hand-written parser in `src/parser/` implements it; `tools/gen-grammar` builds a reference
parser, a sentence generator, highlighters and the syntax reference page from it. mermaid@12
decides what is valid, apart from D452's changes, this file is fixed to match, and the parser
must match this file (DESIGN §4.4).

**Lexer input.** The lexer reads the diagram body as mermaid@12 handed it to its lexer: front
matter and `%%{…}%%` directives removed; CRLF and CR read as LF; `="x"` inside an HTML tag read
as `='x'`; `%%` comment lines removed and leading blanks trimmed; on a line with
`style…:…#…;` (or `classDef…`) the last `;` dropped; `#name;` / `#123;` entities read as
opaque text that no rule takes apart; and a line break appended. Keywords are case-sensitive.

Each statement goes on a line of its own, after the header line. A macro takes its arguments
in `( )`, right after its name: text, `"text"` (no escapes), `$name="value"` or an empty one;
commas only separate them. A boundary holds its statements between `{` and `}`, the first an
element, relation or style. As mermaid@12 lexed it, apart from D452: an unquoted argument stops
at `)` and at the line end, a `%%` comment keeps the line break after it, and a lone `title` is
a title with no text. A line holding `direction TB`, `BT`, `RL` or `LR` is one token that no
statement takes. *)

@lexer

@modes macro attribute string string_kv string_kv_key string_kv_value acc_title acc_descr
  acc_descr_multiline ;

(** `direction TB|BT|RL|LR`: tried first, over the whole line from the token start (inside a
label too). C4 has no `direction` statement: it is an error. *)
direction_tb              /.*direction\s+TB[^\n]*/         :keyword ;
(** `direction BT`: an error, as `direction TB`. *)
direction_bt              /.*direction\s+BT[^\n]*/         :keyword ;
(** `direction RL`: an error, as `direction TB`. *)
direction_rl              /.*direction\s+RL[^\n]*/         :keyword ;
(** `direction LR`: an error, as `direction TB`. *)
direction_lr              /.*direction\s+LR[^\n]*/         :keyword ;
(** `title <text>`: the diagram title, the rest of the line up to a `#` or `;`, trimmed. A
lone `title` is a title with no text (D452). *)
title                     /title(?=\n)/                    :keyword ;
title                     /title\s[^#\n;]+/                :keyword ;
(** `accDescription <text>`: the accessible description, the rest of the line. *)
accDescription            /accDescription\s[^#\n;]+/       :keyword ;
(** `accTitle: …` and `accDescr: …` take the rest of the line; `accDescr { … }` runs to `}`. *)
acc_title                 /accTitle\s*:\s*/                push(acc_title) :keyword ;
<acc_title> acc_title_value /[^\n]*/                       pop :string ;
acc_descr                 /accDescr\s*:\s*/                push(acc_descr) :keyword ;
<acc_descr> acc_descr_value /[^\n]*/                       pop :string ;
-                         /accDescr\s*\{\s*/               push(acc_descr_multiline) attach-next :keyword ;
<acc_descr_multiline> -   /\}/                             pop attach-prev :keyword ;
<acc_descr_multiline> acc_descr_multiline_value /[^\}]*/   :string ;
(** A `%%` comment after a statement, to the line end; the line break after it stays (D452).
The parser keeps it as trivia; it is named here so the grammar can join the line breaks around
a bare `%%` line. *)
COMMENT                   /%%[^\n]*/                       :comment ;
(** Line breaks, with the blanks before the last of them. *)
NEWLINE                   /\s*(?:\n)+/ ;
-                         /\s+/ ;

C4_CONTEXT                /C4Context\b/                    :keyword ;
C4_CONTAINER              /C4Container\b/                  :keyword ;
C4_COMPONENT              /C4Component\b/                  :keyword ;
C4_DYNAMIC                /C4Dynamic\b/                    :keyword ;
C4_DEPLOYMENT             /C4Deployment\b/                 :keyword ;

PERSON_EXT                /Person_Ext\b/                   push(macro) :keyword ;
PERSON                    /Person\b/                       push(macro) :keyword ;
SYSTEM_EXT_QUEUE          /SystemQueue_Ext\b/              push(macro) :keyword ;
SYSTEM_EXT_DB             /SystemDb_Ext\b/                 push(macro) :keyword ;
SYSTEM_EXT                /System_Ext\b/                   push(macro) :keyword ;
SYSTEM_QUEUE              /SystemQueue\b/                  push(macro) :keyword ;
SYSTEM_DB                 /SystemDb\b/                     push(macro) :keyword ;
SYSTEM                    /System\b/                       push(macro) :keyword ;
BOUNDARY                  /Boundary\b/                     push(macro) :keyword ;
ENTERPRISE_BOUNDARY       /Enterprise_Boundary\b/          push(macro) :keyword ;
SYSTEM_BOUNDARY           /System_Boundary\b/              push(macro) :keyword ;
CONTAINER_EXT_QUEUE       /ContainerQueue_Ext\b/           push(macro) :keyword ;
CONTAINER_EXT_DB          /ContainerDb_Ext\b/              push(macro) :keyword ;
CONTAINER_EXT             /Container_Ext\b/                push(macro) :keyword ;
CONTAINER_QUEUE           /ContainerQueue\b/               push(macro) :keyword ;
CONTAINER_DB              /ContainerDb\b/                  push(macro) :keyword ;
CONTAINER                 /Container\b/                    push(macro) :keyword ;
CONTAINER_BOUNDARY        /Container_Boundary\b/           push(macro) :keyword ;
COMPONENT_EXT_QUEUE       /ComponentQueue_Ext\b/           push(macro) :keyword ;
COMPONENT_EXT_DB          /ComponentDb_Ext\b/              push(macro) :keyword ;
COMPONENT_EXT             /Component_Ext\b/                push(macro) :keyword ;
COMPONENT_QUEUE           /ComponentQueue\b/               push(macro) :keyword ;
COMPONENT_DB              /ComponentDb\b/                  push(macro) :keyword ;
COMPONENT                 /Component\b/                    push(macro) :keyword ;
NODE                      /Deployment_Node\b/              push(macro) :keyword ;
NODE                      /Node\b/                         push(macro) :keyword ;
NODE_L                    /Node_L\b/                       push(macro) :keyword ;
NODE_R                    /Node_R\b/                       push(macro) :keyword ;
REL                       /Rel\b/                          push(macro) :keyword ;
BIREL                     /BiRel\b/                        push(macro) :keyword ;
REL_U                     /Rel_Up\b/                       push(macro) :keyword ;
REL_U                     /Rel_U\b/                        push(macro) :keyword ;
REL_D                     /Rel_Down\b/                     push(macro) :keyword ;
REL_D                     /Rel_D\b/                        push(macro) :keyword ;
REL_L                     /Rel_Left\b/                     push(macro) :keyword ;
REL_L                     /Rel_L\b/                        push(macro) :keyword ;
REL_R                     /Rel_Right\b/                    push(macro) :keyword ;
REL_R                     /Rel_R\b/                        push(macro) :keyword ;
REL_B                     /Rel_Back\b/                     push(macro) :keyword ;
REL_INDEX                 /RelIndex\b/                     push(macro) :keyword ;
UPDATE_EL_STYLE           /UpdateElementStyle\b/           push(macro) :keyword ;
UPDATE_REL_STYLE          /UpdateRelStyle\b/               push(macro) :keyword ;
UPDATE_LAYOUT_CONFIG      /UpdateLayoutConfig\b/           push(macro) :keyword ;

(** The text ended right after a macro name. *)
<macro> EOF_IN_STRUCT     /$/ ;
(** `(` then blanks and `,`: the arguments, the first one empty. The arguments take the macro's
place on the mode stack (jison pushed them over it and popped both at once). *)
<macro> ATTRIBUTE_EMPTY   /\([ ]*,/                        pop push(attribute) :punctuation ;
<macro> -                 /\(/                             pop push(attribute) :punctuation ;
(** `)` closes the arguments (jison returned no token for it; D452 makes it the only way out of
them but a line break). *)
<macro,attribute> ARGS_CLOSE /\)/                          pop :punctuation ;
(** An empty argument: `,,` or `""`. *)
<attribute> ATTRIBUTE_EMPTY /,,/                           :punctuation ;
<attribute> -             /,/                              :punctuation ;
<attribute> ATTRIBUTE_EMPTY /[ ]*""/                       :punctuation ;
<attribute> -             /[ ]*"/                          push(string) :string ;
<string> -                /"/                              pop :string ;
(** An argument in quotes: no escapes, line breaks included. *)
<string> STR              /[^"]*/                          :string ;
(** `$name="value"`: a named argument. Each part takes the place of the one before on the mode
stack (jison pushed them and popped two at once). *)
<attribute> -             /[ ]*\$/                         push(string_kv) :variable ;
<string_kv> STR_KEY       /[^=]*/                          pop push(string_kv_key) :variable ;
<string_kv_key> -         /=[ ]*"/                         pop push(string_kv_value) :string ;
<string_kv_value> STR_VALUE /[^"]+/                        :string ;
<string_kv_value> -       /"/                              pop :string ;
(** A line break in the arguments leaves them, the macro open (D452). *)
<attribute> -             /(?=\n)/                         pop ;
(** An argument without quotes: to a `,`, a `)` or the line end, blanks included (D452). *)
<attribute> STR           /[^,)\n]+/                       :string ;

(** `{` and `}` around a boundary's statements. *)
LBRACE                    /\{/                             :punctuation ;
RBRACE                    /\}/                             :punctuation ;
(** The end of the text. *)
EOF                       /$/ ;

@trivia

(** Removed before lexing (see the lexer input); listed for the highlighters. A comment is a
whole line; both take their leading blanks. *)
COMMENT                   /^[^\S\n]*%%(?!\{)[^\n]+/         :comment ;
(** From `%%{` to the first `}%%`, over line breaks (core preprocess). *)
DIRECTIVE                 /[^\S\n]*%%\{[\s\S]*?\}%%/        :meta ;

@grammar

diagram = header nl statements EOF ;
(** `C4Context`, `C4Container`, `C4Component`, `C4Dynamic` or `C4Deployment`: the header, on the
first line. Every header takes every element.

A C4 diagram is a header, a line break, then its statements: one or more, each on a line of its
own. *)
header = C4_CONTEXT | C4_CONTAINER | C4_COMPONENT | C4_DYNAMIC | C4_DEPLOYMENT ;
(** Line breaks: a `%%` comment may come before each. *)
nl = [ COMMENT ] NEWLINE { COMMENT NEWLINE } ;

(** Statements, each after a line break; a title or accessibility line may be followed by an
element on the same line (`accDescr { … }` ends before the line does). *)
statements = otherStatement [ nl [ statements ] ]
  | otherStatement diagramStatements
  | diagramStatements ;
diagramStatements = diagramStatement [ nl [ statements ] ] ;

(** `title`, `accDescription`, `accTitle:`, `accDescr:` or `accDescr { … }`: the title and the
accessible title and description; the last of each wins. *)
otherStatement = title
  | accDescription
  | acc_title acc_title_value
  | acc_descr acc_descr_value
  | acc_descr_multiline_value ;

diagramStatement = Element | Relation | Style | Boundary ;

(** `Person(alias, "Label", "Description")` and the other elements: `alias, label, descr?,
sprite?, tags?, link?`; containers and components take `techn?` after the label. A later
statement with the same alias merges into the first. *)
Element @Element = element arguments ;
element = PERSON_EXT
  | PERSON
  | SYSTEM_EXT_QUEUE
  | SYSTEM_EXT_DB
  | SYSTEM_EXT
  | SYSTEM_QUEUE
  | SYSTEM_DB
  | SYSTEM
  | CONTAINER_EXT_QUEUE
  | CONTAINER_EXT_DB
  | CONTAINER_EXT
  | CONTAINER_QUEUE
  | CONTAINER_DB
  | CONTAINER
  | COMPONENT_EXT_QUEUE
  | COMPONENT_EXT_DB
  | COMPONENT_EXT
  | COMPONENT_QUEUE
  | COMPONENT_DB
  | COMPONENT ;

(** `Rel(from, to, "Label")` and the other relations: `from, to, label, techn?, descr?,
sprite?, tags?, link?`; `RelIndex` takes an index first, which is not drawn. *)
Relation @Relation = relation arguments ;
relation = REL
  | BIREL
  | REL_U
  | REL_D
  | REL_L
  | REL_R
  | REL_B
  | REL_INDEX ;

(** `UpdateElementStyle(alias, …)`, `UpdateRelStyle(from, to, …)` and
`UpdateLayoutConfig(shapesInRow?, boundariesInRow?)`: style an element or relation already
written, or set how many shapes and boundaries go in a row. *)
Style @Style = style arguments ;
style = UPDATE_EL_STYLE | UPDATE_REL_STYLE | UPDATE_LAYOUT_CONFIG ;

(** `Boundary(alias, "Label") { … }` and the other boundaries and deployment nodes: their
statements go between `{` and `}`, the first an element, relation or style. The `{` ends the
macro's line or starts the next. *)
Boundary @Boundary = boundary arguments brace diagramStatements RBRACE ;
boundary = BOUNDARY
  | ENTERPRISE_BOUNDARY
  | SYSTEM_BOUNDARY
  | CONTAINER_BOUNDARY
  | NODE
  | NODE_L
  | NODE_R ;
brace = LBRACE nl | [ COMMENT ] NEWLINE LBRACE [ nl ] ;

(** The arguments, in `( )`: at least one. *)
arguments = argument { argument } ARGS_CLOSE ;
argument = STR | STR_KEY STR_VALUE | ATTRIBUTE_EMPTY ;

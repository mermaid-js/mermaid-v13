{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "mermaid-railroad",
  "scopeName": "source.mermaid-railroad",
  "fileTypes": [
    "mmd",
    "mermaid"
  ],
  "patterns": [
    {
      "include": "#front-matter-start"
    },
    {
      "include": "#mode-INITIAL"
    }
  ],
  "repository": {
    "trivia-0": {
      "match": "^[^\\S\\n]*%%(?!\\{)[^\\n]+",
      "name": "comment.line.mermaid-railroad"
    },
    "trivia-1": {
      "begin": "[^\\S\\n]*%%\\{",
      "end": "\\}%%",
      "name": "meta.embedded.mermaid-railroad"
    },
    "rule-0": {
      "match": "railroad-beta(?:(?=%%)|(?!\\S))",
      "name": "keyword.control.mermaid-railroad"
    },
    "rule-1": {
      "match": "nonterminal(?![\\w-])",
      "name": "keyword.control.mermaid-railroad"
    },
    "rule-2": {
      "match": "zeroOrMore(?![\\w-])",
      "name": "keyword.control.mermaid-railroad"
    },
    "rule-3": {
      "match": "oneOrMore(?![\\w-])",
      "name": "keyword.control.mermaid-railroad"
    },
    "rule-4": {
      "match": "sequence(?![\\w-])",
      "name": "keyword.control.mermaid-railroad"
    },
    "rule-5": {
      "match": "optional(?![\\w-])",
      "name": "keyword.control.mermaid-railroad"
    },
    "rule-6": {
      "match": "terminal(?![\\w-])",
      "name": "keyword.control.mermaid-railroad"
    },
    "rule-7": {
      "match": "special(?![\\w-])",
      "name": "keyword.control.mermaid-railroad"
    },
    "rule-8": {
      "match": "choice(?![\\w-])",
      "name": "keyword.control.mermaid-railroad"
    },
    "rule-9": {
      "match": "=",
      "name": "keyword.operator.mermaid-railroad"
    },
    "rule-10": {
      "match": ";",
      "name": "punctuation.definition.mermaid-railroad"
    },
    "rule-11": {
      "match": "\\(",
      "name": "punctuation.definition.mermaid-railroad"
    },
    "rule-12": {
      "match": ",",
      "name": "punctuation.definition.mermaid-railroad"
    },
    "rule-13": {
      "match": "\\)",
      "name": "punctuation.definition.mermaid-railroad"
    },
    "rule-14": {
      "match": "title(?:[\\t ][^\\n\\r]*?(?=%%)|[\\t ][^\\n\\r]*|)",
      "name": "keyword.control.mermaid-railroad"
    },
    "rule-15": {
      "match": "accTitle[\\t ]*:(?:[^\\n\\r]*?(?=%%)|[^\\n\\r]*)",
      "name": "keyword.control.mermaid-railroad"
    },
    "rule-16": {
      "match": "accDescr[\\t ]*:(?:[^\\n\\r]*?(?=%%)|[^\\n\\r]*)",
      "name": "keyword.control.mermaid-railroad"
    },
    "rule-17": {
      "begin": "accDescr\\s*\\{",
      "end": "\\}",
      "name": "keyword.control.mermaid-railroad"
    },
    "rule-18": {
      "match": "[A-Z_a-z][\\w-]*",
      "name": "variable.other.mermaid-railroad"
    },
    "rule-19": {
      "match": "\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'",
      "name": "string.quoted.mermaid-railroad"
    },
    "rule-20": {
      "match": "[\\t \\r\\n]+"
    },
    "rule-21": {
      "match": "---[\\t ]*\\r?\\n(?:[\\S\\s]*?\\r?\\n)?---(?:\\r?\\n|(?!\\S))",
      "name": "meta.embedded.mermaid-railroad"
    },
    "rule-22": {
      "match": "%%\\{[\\S\\s]*?\\}%%(?:\\r?\\n|(?!\\S))",
      "name": "meta.embedded.mermaid-railroad"
    },
    "rule-23": {
      "match": "%%[^\\n\\r]*",
      "name": "comment.line.mermaid-railroad"
    },
    "rule-24": {
      "begin": "\\/\\*",
      "end": "\\*\\/",
      "name": "comment.line.mermaid-railroad"
    },
    "mode-INITIAL": {
      "patterns": [
        {
          "include": "#trivia-0"
        },
        {
          "include": "#trivia-1"
        },
        {
          "include": "#rule-0"
        },
        {
          "include": "#rule-1"
        },
        {
          "include": "#rule-2"
        },
        {
          "include": "#rule-3"
        },
        {
          "include": "#rule-4"
        },
        {
          "include": "#rule-5"
        },
        {
          "include": "#rule-6"
        },
        {
          "include": "#rule-7"
        },
        {
          "include": "#rule-8"
        },
        {
          "include": "#rule-9"
        },
        {
          "include": "#rule-10"
        },
        {
          "include": "#rule-11"
        },
        {
          "include": "#rule-12"
        },
        {
          "include": "#rule-13"
        },
        {
          "include": "#rule-14"
        },
        {
          "include": "#rule-15"
        },
        {
          "include": "#rule-16"
        },
        {
          "include": "#rule-17"
        },
        {
          "include": "#rule-18"
        },
        {
          "include": "#rule-19"
        },
        {
          "include": "#rule-20"
        },
        {
          "include": "#rule-21"
        },
        {
          "include": "#rule-22"
        },
        {
          "include": "#rule-23"
        },
        {
          "include": "#rule-24"
        }
      ]
    },
    "front-matter-start": {
      "begin": "\\A(?=[^\\S\\n]*(?:---[^\\S\\n]*)?$)",
      "end": "(?=\\S)",
      "applyEndPatternLast": 1,
      "patterns": [
        {
          "include": "#front-matter"
        }
      ]
    },
    "front-matter": {
      "begin": "^[^\\S\\n]*---[^\\S\\n]*$",
      "beginCaptures": {
        "0": {
          "name": "meta.embedded.mermaid-railroad"
        }
      },
      "end": "(?!)",
      "patterns": [
        {
          "include": "#front-matter-body"
        },
        {
          "match": "#.*",
          "name": "comment.line.mermaid-railroad"
        },
        {
          "match": "^[^\\S\\n]*(?:- )?[^\\s#:'\"-][^:#\\n]*(?=:(?:\\s|$))",
          "name": "variable.other.mermaid-railroad"
        }
      ]
    },
    "front-matter-body": {
      "begin": "^[^\\S\\n]*---[^\\S\\n]*$",
      "beginCaptures": {
        "0": {
          "name": "meta.embedded.mermaid-railroad"
        }
      },
      "end": "(?!)",
      "patterns": [
        {
          "include": "#mode-INITIAL"
        }
      ]
    }
  }
}

(** Railroad diagram syntax, PEG notation (R-PARSE-9, D54, D512): the normative grammar of
`railroad-peg-beta` diagrams.

The hand-written parser in `src/parser/peg/` implements it; `tools/gen-grammar` builds a
reference parser, a sentence generator, highlighters and the syntax reference page from it.
mermaid@12 decides what is valid, this file is fixed to match, and the parser must match this
file (DESIGN §4.4). mermaid@12 parsed the PEG notation with Langium (`railroad-peg.langium` in
`@mermaid-js/parser`, which does not import `common.langium`); the rules below are its token
rules, in its order, and its grammar. The other notations have grammars of their own
(`railroad.ebnf`, `railroad-ebnf.ebnf`, `railroad-abnf.ebnf`).

**Lexer input.** The lexer reads the diagram body as mermaid@12 handed it to its lexer: front
matter and `%%{…}%%` directives removed; CRLF and CR read as LF; `="x"` inside an HTML tag read
as `='x'`; `%%` comment lines removed and leading blanks trimmed; on a line with
`style…:…#…;` (or `classDef…`) the last `;` dropped; `#name;` / `#123;` entities read as
opaque text; and a line break appended. Keywords are case-sensitive.

`#` starts a comment to the line end. An element takes at most one `&` or `!` before it and
one `?`, `*` or `+` after it. A name that starts with `title` reads as a `title` line. Line
breaks are blanks: a rule may span lines, and ends at its `;`. *)

@lexer

(** `railroad-peg-beta`: starts a railroad diagram in the PEG notation, followed by a blank,
a line break or `%%`. *)
HEADER                    /railroad-peg-beta(?:(?=%%)|(?!\S))/ :keyword ;
(** `<-` between a rule's name and its definition. *)
ARROW                     /<-/                             :operator ;
(** `;` at the end of a rule. *)
SEMI                      /;/                              :punctuation ;
(** `a / b`: the first alternative that matches. *)
SLASH                     /\//                             :operator ;
(** `&e`: `e` must follow, and is not read; drawn as a special labelled `&e`. *)
AMP                       /&/                              :operator ;
(** `!e`: `e` must not follow; drawn as a special labelled `!e`. *)
BANG                      /!/                              :operator ;
(** `e?`: `e` or nothing. *)
QUESTION                  /\?/                             :operator ;
(** `e*`: `e` any number of times, or not at all. *)
STAR                      /\*/                             :operator ;
(** `e+`: `e` once or more. *)
PLUS                      /\+/                             :operator ;
(** `( … )`: a group, drawn as its contents. *)
LPAREN                    /\(/                             :punctuation ;
RPAREN                    /\)/                             :punctuation ;
(** `.`: any character, drawn as a special. *)
DOT                       /\./                             :operator ;
(** `title …`: the diagram's title, the rest of the line (quotes around it are dropped). It is
not drawn. *)
TITLE                     /title(?:[\t ][^\n\r]*?(?=%%)|[\t ][^\n\r]*|)/ :keyword ;
(** `accTitle: …`: the accessible title of the diagram, the rest of the line. *)
ACC_TITLE                 /accTitle[\t ]*:(?:[^\n\r]*?(?=%%)|[^\n\r]*)/ :keyword ;
(** `accDescr: …` (the rest of the line) or `accDescr { … }` (over lines, to `}`): the accessible
description of the diagram. mermaid@12's one rule, as two tried in order; the block's
`[\s\S]*?\}` is its `[^}]*\}`, written so that line-based highlighters read the block as one span. *)
ACC_DESCR                 /accDescr[\t ]*:(?:[^\n\r]*?(?=%%)|[^\n\r]*)/ :keyword ;
ACC_DESCR                 /accDescr\s*\{[\s\S]*?\}/        :keyword ;
(** A rule's name: a letter or `_`, then letters, digits, `_` and `-`. A name in an expression
is a reference to that rule, drawn in a square box. *)
ID                        /[A-Z_a-z][\w-]*/                :variable ;
(** `"…"` or `'…'`: `\n`, `\r` and `\t` are a line feed, a carriage return and a tab, and `\`
before any other character is that character. A string may span lines. *)
STRING                    /"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'/ :string ;
-                         /[\t \r\n]+/ ;
(** A `---` … `---` block inside the body: skipped. *)
YAML                      /---[\t ]*\r?\n(?:[\S\s]*?\r?\n)?---(?:\r?\n|(?!\S))/ :meta ;
(** A `%%{…}%%` left in the text the lexer reads: skipped. *)
DIRECTIVE                 /%%\{[\S\s]*?\}%%(?:\r?\n|(?!\S))/ :meta ;
(** `%%` to the end of the line, after other text: a comment. *)
COMMENT                   /%%[^\n\r]*/                    :comment ;
(** `#` to the end of the line: a comment. *)
HASH_COMMENT              /#[^\n\r]*/                     :comment ;
(** The end of the text. *)
EOF                       /$/ ;

@trivia

(** Removed before lexing (see the lexer input); listed for the highlighters. A comment is a
whole line; both take their leading blanks. *)
COMMENT                   /^[^\S\n]*%%(?!\{)[^\n]+/         :comment ;
(** From `%%{` to the first `}%%`, over line breaks (core preprocess). *)
DIRECTIVE                 /[^\S\n]*%%\{[\s\S]*?\}%%/        :meta ;

@grammar

(** A diagram is `railroad-peg-beta`, then `title`, `accTitle` and `accDescr` lines, then rules.
The `YAML`, `DIRECTIVE`, `COMMENT` and `HASH_COMMENT` tokens of the lexer are skipped before
parsing. *)
peg = Header { text } { Rule } EOF ;
Header @Header = HEADER ;
text = Title | AccTitle | AccDescr ;

(** `Name <- … ;`: a rule, drawn as a track from its name. A name defined twice is drawn
twice. *)
Rule @Rule = ID ARROW orderedChoice SEMI ;

(** Alternatives, tried in order; one alternative is itself. *)
orderedChoice = sequence { SLASH sequence } ;
(** Elements one after another; one element is itself. *)
sequence = prefix { prefix } ;
prefix = [ AMP | BANG ] suffix ;
suffix = primary [ QUESTION | STAR | PLUS ] ;
primary = STRING | ID | DOT | LPAREN orderedChoice RPAREN ;

(** `title Grammar`: the title (the last one wins). *)
Title @Title = TITLE ;
(** `accTitle: …`: the accessible title. *)
AccTitle @AccTitle = ACC_TITLE ;
(** `accDescr: …` or `accDescr { … }`: the accessible description. *)
AccDescr @AccDescr = ACC_DESCR ;

{
  "name": "@mermaid-js/language-service",
  "version": "0.0.0",
  "description": "Editor-agnostic Mermaid language service: diagnostics, navigation, rename, folding, semantic tokens.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "mermaid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@mermaid-js/core": "workspace:^",
    "@mermaid-js/diagram-flowchart": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@mermaid-js/diagram-flowchart": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mermaid-js/core": "workspace:^",
    "@mermaid-js/diagram-flowchart": "workspace:^"
  }
}

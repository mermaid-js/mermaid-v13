@ 3:5  B |
  --> operator (normal line with an arrow head) 3:5-3:5 "" -> "-->"
  --- operator (normal line with no head) 3:5-3:5 "" -> "---"
  -.-> operator (dotted line with an arrow head) 3:5-3:5 "" -> "-.->"
  -.- operator (dotted line with no head) 3:5-3:5 "" -> "-.-"
  ==> operator (thick line with an arrow head) 3:5-3:5 "" -> "==>"
  === operator (thick line with no head) 3:5-3:5 "" -> "==="
  ~~~ operator (invisible link with no head) 3:5-3:5 "" -> "~~~"
  --o operator (normal line with a circle head) 3:5-3:5 "" -> "--o"
  --x operator (normal line with a cross head) 3:5-3:5 "" -> "--x"
  <--> operator (normal line with an arrow head at both ends) 3:5-3:5 "" -> "<-->"
  o--o operator (normal line with a circle head at both ends) 3:5-3:5 "" -> "o--o"
  x--x operator (normal line with a cross head at both ends) 3:5-3:5 "" -> "x--x"
  & operator 3:5-3:5 "" -> "&"
@ 4:9  A --> |
  A node (Start) 4:9-4:9 "" -> "A"
  B node 4:9-4:9 "" -> "B"
  Bee node 4:9-4:9 "" -> "Bee"
@ 5:7  A & |
  A node (Start) 5:7-5:7 "" -> "A"
  B node 5:7-5:7 "" -> "B"
  Bee node 5:7-5:7 "" -> "Bee"
@ 6:12  A --> Bee|
  Bee[Bee] shape (square) 6:9-6:12 "Bee" -> "Bee[Bee]"
  Bee(Bee) shape (round) 6:9-6:12 "Bee" -> "Bee(Bee)"
  Bee([Bee]) shape (stadium) 6:9-6:12 "Bee" -> "Bee([Bee])"
  Bee[[Bee]] shape (subroutine) 6:9-6:12 "Bee" -> "Bee[[Bee]]"
  Bee[(Bee)] shape (cylinder) 6:9-6:12 "Bee" -> "Bee[(Bee)]"
  Bee((Bee)) shape (circle) 6:9-6:12 "Bee" -> "Bee((Bee))"
  Bee(((Bee))) shape (doublecircle) 6:9-6:12 "Bee" -> "Bee(((Bee)))"
  Bee>Bee] shape (odd) 6:9-6:12 "Bee" -> "Bee>Bee]"
  Bee{Bee} shape (diamond) 6:9-6:12 "Bee" -> "Bee{Bee}"
  Bee{{Bee}} shape (hexagon) 6:9-6:12 "Bee" -> "Bee{{Bee}}"
  Bee[/Bee/] shape (lean_right) 6:9-6:12 "Bee" -> "Bee[/Bee/]"
  Bee[\Bee\] shape (lean_left) 6:9-6:12 "Bee" -> "Bee[\\Bee\\]"
  Bee[/Bee\] shape (trapezoid) 6:9-6:12 "Bee" -> "Bee[/Bee\\]"
  Bee[\Bee/] shape (inv_trapezoid) 6:9-6:12 "Bee" -> "Bee[\\Bee/]"
  Bee(-Bee-) shape (ellipse) 6:9-6:12 "Bee" -> "Bee(-Bee-)"
@ 7:12  A --> end|
  none

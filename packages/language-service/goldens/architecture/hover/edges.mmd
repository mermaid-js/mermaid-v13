architecture-beta
  group api[API]
  service db(database) in api
  service web
  junction hub in api
  db:|L -- R:hub
  db:L -|- R:hub
  hub:B <-->| T:web
  web:R -[re|ads]- L:db
  web{group}:T -- B:db{gro|up}
  db{group}:|R -- L:web
  api:R -- |L:web
  api{group}:R -- |L:web
  group p
  group g in p
  g{group}:B -- |T:web

@ 6:6  db:|
  L constant (left) 6:6-6:6 "" -> "L"
  R constant (right) 6:6-6:6 "" -> "R"
  T constant (top) 6:6-6:6 "" -> "T"
  B constant (bottom) 6:6-6:6 "" -> "B"
@ 7:6  db |
  {group} keyword 7:6-7:6 "" -> "{group}"
@ 8:8  db:R |
  -- operator (edge) 8:8-8:8 "" -> "--"
  --> operator (edge, arrowhead on the right) 8:8-8:8 "" -> "-->"
  <-- operator (edge, arrowhead on the left) 8:8-8:8 "" -> "<--"
  <--> operator (edge, arrowheads on both ends) 8:8-8:8 "" -> "<-->"
  -[label]- operator (labelled edge) 8:8-8:8 "" -> "-[label]-"

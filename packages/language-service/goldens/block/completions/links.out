@ 2:10  a["A"] |
  --> operator (line with an arrow head) 2:10-2:10 "" -> "-->"
  --- operator (line with no head) 2:10-2:10 "" -> "---"
  --x operator (line with a cross head) 2:10-2:10 "" -> "--x"
  --o operator (line with a circle head) 2:10-2:10 "" -> "--o"
  <--> operator (line with an arrow head at both ends) 2:10-2:10 "" -> "<-->"
  ==> operator (thick line with an arrow head) 2:10-2:10 "" -> "==>"
  === operator (thick line with no head) 2:10-2:10 "" -> "==="
  <==> operator (thick line with an arrow head at both ends) 2:10-2:10 "" -> "<==>"
  -.-> operator (dotted line with an arrow head) 2:10-2:10 "" -> "-.->"
  -.- operator (dotted line with no head) 2:10-2:10 "" -> "-.-"
  <-.-> operator (dotted line with an arrow head at both ends) 2:10-2:10 "" -> "<-.->"
  space keyword 2:10-2:10 "" -> "space"
  a node (A) 2:10-2:10 "" -> "a"
  b node 2:10-2:10 "" -> "b"
@ 3:5  b |
  --> operator (line with an arrow head) 3:5-3:5 "" -> "-->"
  --- operator (line with no head) 3:5-3:5 "" -> "---"
  --x operator (line with a cross head) 3:5-3:5 "" -> "--x"
  --o operator (line with a circle head) 3:5-3:5 "" -> "--o"
  <--> operator (line with an arrow head at both ends) 3:5-3:5 "" -> "<-->"
  ==> operator (thick line with an arrow head) 3:5-3:5 "" -> "==>"
  === operator (thick line with no head) 3:5-3:5 "" -> "==="
  <==> operator (thick line with an arrow head at both ends) 3:5-3:5 "" -> "<==>"
  -.-> operator (dotted line with an arrow head) 3:5-3:5 "" -> "-.->"
  -.- operator (dotted line with no head) 3:5-3:5 "" -> "-.-"
  <-.-> operator (dotted line with an arrow head at both ends) 3:5-3:5 "" -> "<-.->"
  ["b"] shape (square) 3:5-3:5 "" -> "[\"b\"]"
  ("b") shape (round) 3:5-3:5 "" -> "(\"b\")"
  (("b")) shape (circle) 3:5-3:5 "" -> "((\"b\"))"
  ((("b"))) shape (doublecircle) 3:5-3:5 "" -> "(((\"b\")))"
  (["b"]) shape (stadium) 3:5-3:5 "" -> "([\"b\"])"
  [["b"]] shape (subroutine) 3:5-3:5 "" -> "[[\"b\"]]"
  [("b")] shape (cylinder) 3:5-3:5 "" -> "[(\"b\")]"
  {"b"} shape (diamond) 3:5-3:5 "" -> "{\"b\"}"
  {{"b"}} shape (hexagon) 3:5-3:5 "" -> "{{\"b\"}}"
  >"b"] shape (rect_left_inv_arrow) 3:5-3:5 "" -> ">\"b\"]"
  [/"b"/] shape (lean_right) 3:5-3:5 "" -> "[/\"b\"/]"
  [\"b"\] shape (lean_left) 3:5-3:5 "" -> "[\\\"b\"\\]"
  [/"b"\] shape (trapezoid) 3:5-3:5 "" -> "[/\"b\"\\]"
  [\"b"/] shape (inv_trapezoid) 3:5-3:5 "" -> "[\\\"b\"/]"
  <["b"]>(right) shape (block_arrow) 3:5-3:5 "" -> "<[\"b\"]>(right)"
  space keyword 3:5-3:5 "" -> "space"
  a node (A) 3:5-3:5 "" -> "a"
  b node 3:5-3:5 "" -> "b"
@ 4:6  a <|
  <--> operator (line with an arrow head at both ends) 4:5-4:6 "<" -> "<-->"
  <==> operator (thick line with an arrow head at both ends) 4:5-4:6 "<" -> "<==>"
  <-.-> operator (dotted line with an arrow head at both ends) 4:5-4:6 "<" -> "<-.->"
@ 5:6  a -|
  --> operator (line with an arrow head) 5:5-5:6 "-" -> "-->"
  --- operator (line with no head) 5:5-5:6 "-" -> "---"
  --x operator (line with a cross head) 5:5-5:6 "-" -> "--x"
  --o operator (line with a circle head) 5:5-5:6 "-" -> "--o"
  -.-> operator (dotted line with an arrow head) 5:5-5:6 "-" -> "-.->"
  -.- operator (dotted line with no head) 5:5-5:6 "-" -> "-.-"
@ 6:7  a -.|
  -.-> operator (dotted line with an arrow head) 6:5-6:7 "-." -> "-.->"
  -.- operator (dotted line with no head) 6:5-6:7 "-." -> "-.-"
@ 7:7  a ==|
  ==> operator (thick line with an arrow head) 7:5-7:7 "==" -> "==>"
  === operator (thick line with no head) 7:5-7:7 "==" -> "==="

@ 2:10  a["A"] |
  --> operator (line with an arrow head) 2:10-2:10 "" -> "-->"
  --- operator (line with no head) 2:10-2:10 "" -> "---"
  --x operator (line with a cross head) 2:10-2:10 "" -> "--x"
  --o operator (line with a circle head) 2:10-2:10 "" -> "--o"
  <--> operator (line with an arrow head at both ends) 2:10-2:10 "" -> "<-->"
  x--x operator (line with a cross head at both ends) 2:10-2:10 "" -> "x--x"
  o--o operator (line with a circle head at both ends) 2:10-2:10 "" -> "o--o"
  ==> operator (thick line with an arrow head) 2:10-2:10 "" -> "==>"
  === operator (thick line with no head) 2:10-2:10 "" -> "==="
  -.-> operator (dotted line with an arrow head) 2:10-2:10 "" -> "-.->"
  -.- operator (dotted line with no head) 2:10-2:10 "" -> "-.-"
@ 3:6  a -|
  --> operator (line with an arrow head) 3:5-3:6 "-" -> "-->"
  --- operator (line with no head) 3:5-3:6 "-" -> "---"
  --x operator (line with a cross head) 3:5-3:6 "-" -> "--x"
  --o operator (line with a circle head) 3:5-3:6 "-" -> "--o"
  -.-> operator (dotted line with an arrow head) 3:5-3:6 "-" -> "-.->"
  -.- operator (dotted line with no head) 3:5-3:6 "-" -> "-.-"
@ 4:7  a ==|
  ==> operator (thick line with an arrow head) 4:5-4:7 "==" -> "==>"
  === operator (thick line with no head) 4:5-4:7 "==" -> "==="
@ 5:6  a <|
  <--> operator (line with an arrow head at both ends) 5:5-5:6 "<" -> "<-->"
@ 6:7  a -.|
  -.-> operator (dotted line with an arrow head) 6:5-6:7 "-." -> "-.->"
  -.- operator (dotted line with no head) 6:5-6:7 "-." -> "-.-"

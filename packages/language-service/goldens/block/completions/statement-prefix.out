@ 3:5  cl|
  classDef keyword 3:3-3:5 "cl" -> "classDef "
  class keyword 3:3-3:5 "cl" -> "class "
  cl["cl"] shape (square) 3:3-3:5 "cl" -> "cl[\"cl\"]"
  cl("cl") shape (round) 3:3-3:5 "cl" -> "cl(\"cl\")"
  cl(("cl")) shape (circle) 3:3-3:5 "cl" -> "cl((\"cl\"))"
  cl((("cl"))) shape (doublecircle) 3:3-3:5 "cl" -> "cl(((\"cl\")))"
  cl(["cl"]) shape (stadium) 3:3-3:5 "cl" -> "cl([\"cl\"])"
  cl[["cl"]] shape (subroutine) 3:3-3:5 "cl" -> "cl[[\"cl\"]]"
  cl[("cl")] shape (cylinder) 3:3-3:5 "cl" -> "cl[(\"cl\")]"
  cl{"cl"} shape (diamond) 3:3-3:5 "cl" -> "cl{\"cl\"}"
  cl{{"cl"}} shape (hexagon) 3:3-3:5 "cl" -> "cl{{\"cl\"}}"
  cl>"cl"] shape (rect_left_inv_arrow) 3:3-3:5 "cl" -> "cl>\"cl\"]"
  cl[/"cl"/] shape (lean_right) 3:3-3:5 "cl" -> "cl[/\"cl\"/]"
  cl[\"cl"\] shape (lean_left) 3:3-3:5 "cl" -> "cl[\\\"cl\"\\]"
  cl[/"cl"\] shape (trapezoid) 3:3-3:5 "cl" -> "cl[/\"cl\"\\]"
  cl[\"cl"/] shape (inv_trapezoid) 3:3-3:5 "cl" -> "cl[\\\"cl\"/]"
  cl<["cl"]>(right) shape (block_arrow) 3:3-3:5 "cl" -> "cl<[\"cl\"]>(right)"

  excludes keyword 1:7-1:7 "" -> "excludes "
  includes keyword 1:7-1:7 "" -> "includes "
  todayMarker keyword 1:7-1:7 "" -> "todayMarker "
  inclusiveEndDates keyword 1:7-1:7 "" -> "inclusiveEndDates"
  topAxis keyword 1:7-1:7 "" -> "topAxis"
  weekday keyword 1:7-1:7 "" -> "weekday "
  weekend keyword 1:7-1:7 "" -> "weekend "
  click keyword 1:7-1:7 "" -> "click "
  accTitle keyword 1:7-1:7 "" -> "accTitle: "
  accDescr keyword 1:7-1:7 "" -> "accDescr: "
@ 2:3  |
  section keyword 2:3-2:3 "" -> "section "
  title keyword 2:3-2:3 "" -> "title "
  dateFormat keyword 2:3-2:3 "" -> "dateFormat "
  axisFormat keyword 2:3-2:3 "" -> "axisFormat "
  tickInterval keyword 2:3-2:3 "" -> "tickInterval "
  excludes keyword 2:3-2:3 "" -> "excludes "
  includes keyword 2:3-2:3 "" -> "includes "

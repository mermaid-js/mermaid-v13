@ 4:1  |
  title keyword 4:1-4:1 "" -> "title "
  accTitle keyword 4:1-4:1 "" -> "accTitle: "
  accDescr: keyword 4:1-4:1 "" -> "accDescr: "
  accDescr { keyword 4:1-4:1 "" -> "accDescr { }"
  size keyword 4:1-4:1 "" -> "size "
  evolution keyword 4:1-4:1 "" -> "evolution "
  anchor keyword 4:1-4:1 "" -> "anchor "
  component keyword 4:1-4:1 "" -> "component "
  evolve keyword 4:1-4:1 "" -> "evolve "
  pipeline keyword 4:1-4:1 "" -> "pipeline "
  note keyword 4:1-4:1 "" -> "note "
  annotations keyword 4:1-4:1 "" -> "annotations "
  annotation keyword 4:1-4:1 "" -> "annotation "
  accelerator keyword 4:1-4:1 "" -> "accelerator "
  deaccelerator keyword 4:1-4:1 "" -> "deaccelerator "
@ 5:30  component Kettle [0.5, 0.5] (|
  build constant 5:30-5:30 "" -> "build"
  buy constant 5:30-5:30 "" -> "buy"
  outsource constant 5:30-5:30 "" -> "outsource"
  market constant 5:30-5:30 "" -> "market"
  inertia keyword 5:30-5:30 "" -> "inertia"
@ 6:8  Tea -> |
  Tea node (component) 6:8-6:8 "" -> "Tea"

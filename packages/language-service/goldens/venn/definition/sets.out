@ 5:9  union |A,B
  -> 2:7-2:8 "A"
@ 5:11  union A,|B
  -> 3:8-3:9 "B"
@ 6:11  text a|b
  -> 6:10-6:12 "ab"
@ 8:8  text |A t1
  -> 2:7-2:8 "A"
@ 9:9  style |A fill: red
  -> 2:7-2:8 "A"
@ 10:9  style |ab color: blue
  -> 6:10-6:12 "ab"
@ 11:9  style |t1 color: blue
  -> 8:10-8:12 "t1"
@ 12:8  text |Z z1
  -> none
@ 13:3  |set C
  -> none

@ 3:3  |
  classDef keyword 3:3-3:3 "" -> "classDef "
  title keyword 3:3-3:3 "" -> "title "
  accTitle keyword 3:3-3:3 "" -> "accTitle: "
  accDescr: keyword 3:3-3:3 "" -> "accDescr: "
  accDescr { keyword 3:3-3:3 "" -> "accDescr { }"
  " value (a row: "Section", or "Leaf": value) 3:3-3:3 "" -> "\""
@ 4:10  "B" "C"|
  : operator (then the value: a leaf) 4:10-4:10 "" -> ": "
  ::: operator (then a class name) 4:10-4:10 "" -> ":::"

@ 4:3  |
  class keyword 4:3-4:3 "" -> "class"
  namespace keyword 4:3-4:3 "" -> "namespace"
  note for keyword 4:3-4:3 "" -> "note for"
  note keyword 4:3-4:3 "" -> "note"
  style keyword 4:3-4:3 "" -> "style"
  classDef keyword 4:3-4:3 "" -> "classDef"
  cssClass keyword 4:3-4:3 "" -> "cssClass"
  callback keyword 4:3-4:3 "" -> "callback"
  link keyword 4:3-4:3 "" -> "link"
  click keyword 4:3-4:3 "" -> "click"
  accTitle keyword 4:3-4:3 "" -> "accTitle: "
  accDescr keyword 4:3-4:3 "" -> "accDescr: "
  direction TB keyword 4:3-4:3 "" -> "direction TB"
  direction BT keyword 4:3-4:3 "" -> "direction BT"
  direction LR keyword 4:3-4:3 "" -> "direction LR"
  direction RL keyword 4:3-4:3 "" -> "direction RL"
  Animal class (An animal) 4:3-4:3 "" -> "Animal"
  Duck class 4:3-4:3 "" -> "Duck"
  cl class 4:3-4:3 "" -> "cl"
  no class 4:3-4:3 "" -> "no"
  di class 4:3-4:3 "" -> "di"
  direction class 4:3-4:3 "" -> "direction"
@ 5:5  cl|
  class keyword 5:3-5:5 "cl" -> "class"
  classDef keyword 5:3-5:5 "cl" -> "classDef"
  click keyword 5:3-5:5 "cl" -> "click"
@ 6:5  no|
  note for keyword 6:3-6:5 "no" -> "note for"
  note keyword 6:3-6:5 "no" -> "note"
@ 7:5  di|
  direction TB keyword 7:3-7:5 "di" -> "direction TB"
  direction BT keyword 7:3-7:5 "di" -> "direction BT"
  direction LR keyword 7:3-7:5 "di" -> "direction LR"
  direction RL keyword 7:3-7:5 "di" -> "direction RL"
  direction class 7:3-7:5 "di" -> "direction"
@ 8:13  direction |
  TB constant (top to bottom) 8:13-8:13 "" -> "TB"
  BT constant (bottom to top) 8:13-8:13 "" -> "BT"
  LR constant (left to right) 8:13-8:13 "" -> "LR"
  RL constant (right to left) 8:13-8:13 "" -> "RL"

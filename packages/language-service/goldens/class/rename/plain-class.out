@ 3:9  class |Animal
  prepare: 3:9-3:15 "Animal"; rename to "Creature":
  %% rename-to: Creature
  classDiagram
    class Creature
    Creature <|-- Duck
    Creature : +int age
    note for Creature "every animal"
    cssClass "Creature,Duck" hot
    style Creature fill:#f00
    click Creature call onClick()
@ 5:3  |Animal : +int age
  prepare: 5:3-5:9 "Animal"; rename to "Creature":
  %% rename-to: Creature
  classDiagram
    class Creature
    Creature <|-- Duck
    Creature : +int age
    note for Creature "every animal"
    cssClass "Creature,Duck" hot
    style Creature fill:#f00
    click Creature call onClick()
@ 9:9  click |Animal call onClick()
  prepare: 9:9-9:15 "Animal"; rename to "Creature":
  %% rename-to: Creature
  classDiagram
    class Creature
    Creature <|-- Duck
    Creature : +int age
    note for Creature "every animal"
    cssClass "Creature,Duck" hot
    style Creature fill:#f00
    click Creature call onClick()

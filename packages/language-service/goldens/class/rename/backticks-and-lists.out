@ 3:10  class `|Animal`~T~
  prepare: 3:10-3:16 "Animal"; rename to "Creature":
  %% rename-to: Creature
  classDiagram
    class `Creature`~T~
    Creature --> Duck
    cssClass "Creature~T~,Duck" hot
    namespace Water {
      class Fish
    }

@ 2:1  |
  tf keyword (frame) 2:1-2:1 "" -> "tf "
  rf keyword (reset frame) 2:1-2:1 "" -> "rf "
  timeframe keyword (frame) 2:1-2:1 "" -> "timeframe "
  resetframe keyword (reset frame) 2:1-2:1 "" -> "resetframe "
  entity keyword 2:1-2:1 "" -> "entity "
  data keyword 2:1-2:1 "" -> "data "
  note keyword 2:1-2:1 "" -> "note "
  gwt keyword 2:1-2:1 "" -> "gwt "
@ 3:17  tf 01 ui Screen |
  tf keyword (frame) 3:17-3:17 "" -> "tf "
  rf keyword (reset frame) 3:17-3:17 "" -> "rf "
  timeframe keyword (frame) 3:17-3:17 "" -> "timeframe "
  resetframe keyword (reset frame) 3:17-3:17 "" -> "resetframe "
  entity keyword 3:17-3:17 "" -> "entity "
  data keyword 3:17-3:17 "" -> "data "
  note keyword 3:17-3:17 "" -> "note "
  gwt keyword 3:17-3:17 "" -> "gwt "
  title keyword 3:17-3:17 "" -> "title "
  accTitle: keyword 3:17-3:17 "" -> "accTitle: "
  accDescr: keyword 3:17-3:17 "" -> "accDescr: "
  ->> operator (source frame) 3:17-3:17 "" -> "->> "
@ 4:22  tf 02 cmd Add ->> 01 |
  tf keyword (frame) 4:22-4:22 "" -> "tf "
  rf keyword (reset frame) 4:22-4:22 "" -> "rf "
  timeframe keyword (frame) 4:22-4:22 "" -> "timeframe "
  resetframe keyword (reset frame) 4:22-4:22 "" -> "resetframe "
  entity keyword 4:22-4:22 "" -> "entity "
  data keyword 4:22-4:22 "" -> "data "
  note keyword 4:22-4:22 "" -> "note "
  gwt keyword 4:22-4:22 "" -> "gwt "
  title keyword 4:22-4:22 "" -> "title "
  accTitle: keyword 4:22-4:22 "" -> "accTitle: "
  accDescr: keyword 4:22-4:22 "" -> "accDescr: "
  ->> operator (source frame) 4:22-4:22 "" -> "->> "
@ 5:2  d|
  data keyword 5:1-5:2 "d" -> "data "

@ 1:10  timeline |
  LR constant (left to right) 1:10-1:10 "" -> "LR"
  TD constant (top to bottom) 1:10-1:10 "" -> "TD"
  title keyword 1:10-1:10 "" -> "title "
  section keyword 1:10-1:10 "" -> "section "
  accTitle keyword 1:10-1:10 "" -> "accTitle: "
  accDescr keyword 1:10-1:10 "" -> "accDescr: "

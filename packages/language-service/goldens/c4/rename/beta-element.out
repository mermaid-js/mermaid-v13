@ 5:14  container a|pi "API" "Serves orders." "Kotlin"
  prepare: 5:13-5:16 "api"; rename to "gateway":
  c4-beta container
  %% rename-to: gateway
  person user "User"
  softwareSystem shop "Shop" {
    container gateway "API" "Serves orders." "Kotlin"
    container store "Store"
  }
  user --> gateway : "Calls"
  gateway --> store
  store <-- gateway
  shop --> gateway
  1: gateway --- store

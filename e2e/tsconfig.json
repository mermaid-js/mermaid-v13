{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true
  },
  // Only the parts of e2e/ the v13 visual baseline runs; the rest is the parked v12 suite.
  "include": [
    "browser",
    "dev",
    "smoke",
    "language",
    "helpers/util.ts",
    "helpers/mmd-snapshots.ts",
    "helpers/mmd-snapshots.spec.ts",
    "helpers/argos-metadata.ts",
    "helpers/argos-metadata.spec.ts",
    "rendering/mmd-snapshots.spec.ts",
    "../playwright.config.ts"
  ]
}

---
description: >-
  Label syntax with legacyMarkdown (D731, #1368): label-syntax.mmd's source with
  `legacyMarkdown: true`. Every requirement label kind is one v12 read markdown in, so plain
  `**bold** _ital_` draws as emphasis again; markdown strings, code spans, tags and the
  written `\n` draw as in the default mode.
config:
  legacyMarkdown: true
---
requirementDiagram
  requirement "reqName **bold** _ital_" {
    id: "id **bold** _ital_"
    text: "text **bold** _ital_"
  }
  element "elementName **bold** _ital_" {
    type: "type **bold** _ital_"
    docref: "docref **bold** _ital_"
  }
  "elementName **bold** _ital_" - satisfies -> "reqName **bold** _ital_"

  requirement "`reqName **bold** _ital_`" {
    id: "`id **bold** _ital_`"
    text: "`text **bold** _ital_`"
  }
  element "`elementName **bold** _ital_`" {
    type: "`type **bold** _ital_`"
    docref: "`docref **bold** _ital_`"
  }
  "`elementName **bold** _ital_`" - satisfies -> "`reqName **bold** _ital_`"

  requirement "reqName a `code` b" {
    id: "id a `code` b"
    text: "text a `code` b"
  }
  element "elementName a `code` b" {
    type: "type a `code` b"
    docref: "docref a `code` b"
  }
  "elementName a `code` b" - satisfies -> "reqName a `code` b"

  requirement "reqName <b>bold</b> <i>ital</i><br>next H<sub>2</sub>O" {
    id: "id <b>bold</b> <i>ital</i><br>next H<sub>2</sub>O"
    text: "text <b>bold</b> <i>ital</i><br>next H<sub>2</sub>O"
  }
  element "elementName <b>bold</b> <i>ital</i><br>next H<sub>2</sub>O" {
    type: "type <b>bold</b> <i>ital</i><br>next H<sub>2</sub>O"
    docref: "docref <b>bold</b> <i>ital</i><br>next H<sub>2</sub>O"
  }
  "elementName <b>bold</b> <i>ital</i><br>next H<sub>2</sub>O" - satisfies -> "reqName <b>bold</b> <i>ital</i><br>next H<sub>2</sub>O"

  requirement "reqName one\ntwo" {
    id: "id one\ntwo"
    text: "text one\ntwo"
  }
  element "elementName one\ntwo" {
    type: "type one\ntwo"
    docref: "docref one\ntwo"
  }
  "elementName one\ntwo" - satisfies -> "reqName one\ntwo"

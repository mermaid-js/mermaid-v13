---
description: >-
  Markdown bold/italic emphasis in requirement/element quoted fields, with
  htmlLabels disabled. With markdownAlwaysOn every label is markdown, so the plain markers draw
  bold and italic (#1368).
config:
  markdownAlwaysOn: true
  htmlLabels: false
---
requirementDiagram
    requirement "__my bolded name__" {
        id: 1
        text: "**Bolded text** _italicized text_"
        risk: high
        verifymethod: test
    }
    element "*my italicized name*" {
      type: "**Bolded type** _italicized type_"
      docref: "*Italicized* __Bolded__"
    }

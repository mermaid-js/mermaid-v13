---
description: >-
  punctuation entity names draw as their characters in bare and quoted text
  (#396); a name core does not know draws as written in both (D561)
---
quadrantChart
  title unknown #bogus; title
  x-axis Low #colon; a --> "High #bogus; b"
  y-axis L --> H
  quadrant-1 bare #bogus; stays
  quadrant-2 "quoted #bogus; stays"
  Point #bogus; p: [0.3, 0.6]
  "Q #semi; r": [0.6, 0.3]

railroad-ebnf-beta
title "Quoted strings"
accTitle: A string literal
accDescr: Double or single quoted, with backslash escapes
(* ISO 14977 comment *)
string = '"' { char } '"' | "'" { char } "'" ; /* C comment */
char = "\\" "n" | "\"" | 'x' ;

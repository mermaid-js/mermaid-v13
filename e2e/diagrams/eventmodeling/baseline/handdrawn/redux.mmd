---
config:
  theme: redux
  look: handDrawn
description: >-
  one representative event model, hand-drawn in the redux theme: lanes, boxes and relations
  sketched, the heads and text kept
---
eventmodeling
tf 01 ui Cart.CartScreen
tf 02 cmd Cart.AddItem ->> 01 [[AddItemData]]
tf 03 evt Cart.ItemAdded ->> 02 [[ItemAddedData]]
tf 04 rmo CartItems ->> 03
tf 05 pcr Pricing.Recalculate ->> 04
tf 06 cmd Pricing.ApplyDiscount ->> 05
tf 07 evt Pricing.DiscountApplied
rf 08 ui CheckoutScreen ->> 04
tf 09 rmo Checkout.Summary ->> 07

data AddItemData
{
  productId: 7
}

data ItemAddedData
{
  productId: 7,
  quantity: 1
}

treemap-beta
  title title **bold** _ital_<br>next H<sub>2</sub>O
  "section **bold** _ital_"
    "leaf **bold** _ital_": 10
  "`section **bold** _ital_`"
    "`leaf **bold** _ital_`": 10
  "section a `code` b"
    "leaf a `code` b": 10
  "section <b>bold</b> <i>ital</i><br>next H<sub>2</sub>O"
    "leaf <b>bold</b> <i>ital</i><br>next H<sub>2</sub>O": 10
  "section one\ntwo"
    "leaf one\ntwo": 10

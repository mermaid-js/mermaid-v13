    tf 03 evt Ordering.OrderSubmittedAndAwaitingPaymentAuthorisation [[OrderSubmittedData]]
    tf 04 rmo OrderStatusOverviewForTheCustomerSupportDashboard ->> 03 [[OrderStatusData]]

    data SubmitOrderData `json`
    {
      "orderId": "A-1001",
      "deliveryWindow": "2026-11-12 09:00-12:00"
    }

    data OrderSubmittedData `json`
    {
      "orderId": "A-1001",
      "lines": [
        { "sku": "PEN-01", "qty": 2 },
        { "sku": "INK-BLUE", "qty": 1 }
      ],
      "total": "12.40"
    }

    data OrderStatusData
    {
      orderId: A-1001
      status: awaiting payment
      updatedAt: 2026-11-10T09:30:00Z
    }
  }

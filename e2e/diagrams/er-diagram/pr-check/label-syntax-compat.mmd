---
description: >-
  label-syntax.mmd with legacyMarkdown: true (#1368): every ER label kind reads
  plain **bold** _ital_ as emphasis again, as v12 did; every other way is drawn
  as in label-syntax.mmd.
config:
  legacyMarkdown: true
---
erDiagram
  P1["alias **bold** _ital_"] {
    **type** _name_ "comment **bold** _ital_"
  }
  P2["`alias **bold** _ital_`"] {
    string mdString "`comment **bold** _ital_`"
  }
  P3["alias a `code` b"] {
    string codeSpan "comment a `code` b"
  }
  P4["alias <b>bold</b> <i>ital</i><br>next H<sub>2</sub>O"] {
    string tags "comment <b>bold</b> <i>ital</i><br>next H<sub>2</sub>O"
  }
  P5 {
    string newline "comment one\ntwo"
  }
  subgraph S1["subgraph **bold** _ital_"]
    "entity **bold** _ital_"
  end
  subgraph S2["`subgraph **bold** _ital_`"]
    "`entity **bold** _ital_`"
  end
  subgraph S3["subgraph a `code` b"]
    "entity a `code` b"
  end
  subgraph S4["subgraph <b>bold</b> <i>ital</i><br>next H<sub>2</sub>O"]
    "entity <b>bold</b> <i>ital</i><br>next H<sub>2</sub>O"
  end
  P1 ||--o{ "entity **bold** _ital_" : "relationship **bold** _ital_"
  P2 ||--o{ "`entity **bold** _ital_`" : "`relationship **bold** _ital_`"
  P3 ||--o{ "entity a `code` b" : "relationship a `code` b"
  P4 ||--o{ "entity <b>bold</b> <i>ital</i><br>next H<sub>2</sub>O" : "relationship <b>bold</b> <i>ital</i><br>next H<sub>2</sub>O"
  P4 ||--o{ P5 : "relationship one\ntwo"

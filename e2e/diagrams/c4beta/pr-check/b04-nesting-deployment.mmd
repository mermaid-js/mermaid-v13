---
description: >-
  Probe b04 of spec #730: deployment nodes nested two deep with
  `instances`, an infrastructure node and a relation across the nesting.
  Oddity-table row 7 keeps `instances` on a deploymentNode.
---
c4-beta deployment
deploymentNode dc "Data centre" "" "Linux" {
    infrastructureNode lb "Load balancer" "Routes requests." "nginx"
    deploymentNode web "web" "" "Ubuntu" instances "2..4" {
        container app "Shop API" "Serves orders." "Kotlin"
    }
}
lb --> app : "Forwards requests to" "HTTPS"

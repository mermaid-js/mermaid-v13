---
config:
  theme: dark
  themeVariables:
    primaryColor: '#ffcc00'
    primaryTextColor: '#003366'
    lineColor: '#008800'
    secondaryColor: '#99ccff'
    tertiaryColor: '#ffe6f0'
    background: '#fff2cc'
description: >-
  baseline/themes/default.mmd, the representative architecture diagram, under base-colour overrides in the dark theme
  (#1035, D656): the edges and arrowheads keep v12 dark's #d3d3d3 under the lineColor override
  (defaultLinkColor), as in v12
---
architecture-beta
  title Order platform
  group cloud(cloud)[Cloud]
  group api(server)[API] in cloud
  group data(database)[Data] in cloud

  service gateway(internet)[Gateway]
  service web(server)[Web server] in api
  service worker(server)[Worker] in api
  service db(database)[Orders DB] in data
  service disk1(disk)[Backups] in data
  service ops "Ops console"
  junction hub in cloud

  gateway:R --> L:web
  web:B -[enqueue]- T:worker
  web:R -- L:hub
  hub:B -- T:db
  db:R <--> L:disk1
  worker{group}:R -[reads]-> L:db{group}
  ops:T -- B:gateway

%% A column title that wraps keeps the room under its last line that a one-line title has:
%% in the first column the title is one line, in the second two, in the third three (#1175).
kanban
  one[Column title]
    a[Card]
  two[Column title that is long enough to wrap]
    b[Card]
  three[Column title that is long enough to wrap onto three lines]
    c[Card]

{
  "name": "mermaid-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Mermaid v13 monorepo: DOM-free core, diagram plugins and the public mermaid package.",
  "type": "module",
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "lint": "eslint --quiet --cache --cache-strategy content . && prettier --cache --check . && pnpm lint:spell",
    "lint:fix": "eslint --cache --cache-strategy content --fix . && prettier --cache --write .",
    "lint:spell": "cspell --no-progress --no-summary --gitignore --gitignore-root . \"packages/**/*.ts\" \"tools/**/*.{ts,js}\"",
    "typecheck": "tsc -p tools/tsconfig.json && pnpm -r --parallel run typecheck",
    "check:deps": "tsx tools/check-deps/cli.ts",
    "check:licenses": "tsx tools/release/src/licenses-cli.ts",
    "release:public-gate": "tsx tools/release/src/public-gate-cli.ts",
    "release:publish": "tsx tools/release/src/publish-cli.ts",
    "release:ensure-changeset": "tsx tools/release/src/changesets-cli.ts",
    "gen:config": "tsx tools/gen-config/src/cli.ts",
    "check:config": "tsx tools/gen-config/src/cli.ts --check",
    "gen:theme": "tsx tools/gen-config/src/theme-cli.ts",
    "gen:registry": "tsx tools/gen-config/src/registry-cli.ts",
    "gen:grammar": "tsx tools/gen-grammar/src/cli.ts",
    "check:grammar": "tsx tools/gen-grammar/src/cli.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm check:deps && pnpm check:licenses && pnpm check:config && pnpm check:grammar && pnpm test",
    "e2e": "playwright test",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mermaid-js/mermaid"
  },
  "author": "Knut Sveidqvist",
  "license": "MIT",
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@eslint-community/regexpp": "^4.12.1",
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.62.1",
    "@types/estree": "^1.0.9",
    "@types/node": "^22.19.21",
    "cspell": "^9.3.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^4.1.11"
  }
}

{
  "name": "mermaid-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Mermaid v13 monorepo: DOM-free core, diagram plugins and the public mermaid package.",
  "type": "module",
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @mermaid-js/dev dev",
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "lint": "tsx tools/workspace/lint-cli.ts",
    "lint:fix": "eslint --cache --cache-strategy content --fix --prune-suppressions . && prettier --cache --write .",
    "lint:knip": "knip --no-progress --no-gitignore",
    "lint:spell": "cspell --no-progress --no-summary --gitignore --gitignore-root . \"packages/**/*.ts\" \"tools/**/*.{ts,js}\"",
    "typecheck": "tsc -p tools/tsconfig.json && tsc -p e2e/dom/tsconfig.json && pnpm -r --parallel run typecheck",
    "check:deps": "tsx tools/check-deps/cli.ts",
    "check:licenses": "tsx tools/release/src/licenses-cli.ts",
    "release:preflight": "tsx tools/release/src/preflight-cli.ts",
    "release:public-gate": "tsx tools/release/src/public-gate-cli.ts",
    "release:publish": "tsx tools/release/src/publish-cli.ts",
    "release:rehearse": "tsx tools/release/src/rehearse-cli.ts",
    "release:ensure-changeset": "tsx tools/release/src/changesets-cli.ts",
    "release:sync-version": "tsx tools/release/src/version-file-cli.ts",
    "regen": "tsx tools/workspace/sync-cli.ts && pnpm install && pnpm gen:registry && pnpm gen:config && pnpm gen:theme && pnpm gen:grammar && pnpm -r --filter \"./packages/language-service-*\" run gen && vitest run packages/language-service/src/goldens.spec.ts -t no-diagram -u",
    "gen:config": "tsx tools/gen-config/src/cli.ts",
    "check:config": "tsx tools/gen-config/src/cli.ts --check",
    "gen:theme": "tsx --conditions=mermaid-source tools/gen-config/src/theme-cli.ts",
    "gen:registry": "tsx tools/gen-config/src/registry-cli.ts",
    "gen:grammar": "tsx tools/gen-grammar/src/cli.ts",
    "check:grammar": "tsx tools/gen-grammar/src/cli.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm check:static && pnpm test",
    "check:static": "tsx tools/workspace/parallel-cli.ts 'pnpm lint' 'pnpm lint:knip' 'pnpm typecheck' 'pnpm check:deps' 'pnpm check:licenses' 'tsx tools/workspace/check-generated-cli.ts'",
    "e2e": "playwright test --project chromium --project dev",
    "e2e:dom": "playwright test -c e2e/dom/playwright.config.ts",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mermaid-js/mermaid"
  },
  "author": "Knut Sveidqvist",
  "license": "MIT",
  "devDependencies": {
    "@argos-ci/cli": "^5.1.3",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-community/regexpp": "^4.12.1",
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.62.1",
    "@types/estree": "^1.0.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.21",
    "@vitest/coverage-v8": "4.1.12",
    "cspell": "^9.3.2",
    "dotenv": "^17.4.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "eslint-plugin-unicorn": "^79.0.0",
    "fallow": "3.41.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.3.2",
    "knip": "^5.88.1",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^4.1.11"
  }
}
